# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel auth
ADMIN_SECRET=
ADMIN_PASS=

# Resend (Settings > API Keys) — used to email the property PDF brochure to leads.
# EMAIL_FROM must be on a domain verified in Resend (Resend > Domains). EMAIL_REPLY_TO
# is optional — set it to route reply clicks to a real inbox (e.g. a Gmail account),
# since it doesn't need domain verification the way "from" does.
RESEND_API_KEY=
EMAIL_FROM=MIKA Homes <hola@mikahomes.com>
EMAIL_REPLY_TO=mikahomesinfo@gmail.com
