               copy is aria-hidden so screen readers only hear each review
               once. -->
          <div class="stays-voices-track" id="voices-track">
            {[...VOICES, ...VOICES].map((v: any, i: number) => (
              <figure class="stays-voice" aria-hidden={i >= VOICES.length ? 'true' : undefined}>
