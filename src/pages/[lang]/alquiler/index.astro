            <span class="lang-en" hidden>Send your request with a move-in date and hear back within 24 hours.</span>
          </p>
        </div>
        <div class="stays-step rv" style="animation-delay:.16s">
          <h3><span class="lang-es">Múdate y vive Boquete</span><span class="lang-en" hidden>Move in and live Boquete</span></h3>
          <p>
            <span class="lang-es">Café de altura, senderos, comunidad. Tu nueva rutina empieza entre montañas.</span>
            <span class="lang-en" hidden>Highland coffee, trails, community. Your new routine starts in the mountains.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VOICES + OWNER CTA: community background ============ -->
  <section class="stays-community-section">
    {VOICES.length > 0 && (
      <div class="pad-sec" style="max-width:1240px;margin:0 auto">
        <div class="eyebrow rv" style="margin-bottom:12px">
          <span class="lang-es">Ya viven aquí</span><span class="lang-en" hidden>Already living here</span>
        </div>
        <h2 class="stays-h2 rv" style="margin-bottom:40px">
          <span class="lang-es">Voces de la <em>comunidad</em></span>
          <span class="lang-en" hidden>Voices from the <em>community</em></span>
        </h2>
        <div class="stays-voices-viewport">
          <!-- Content is rendered twice back-to-back and the track animates
