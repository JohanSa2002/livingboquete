        </div>
        <div class="stays-owner-art" aria-hidden="true">
          <div class="stays-owner-card c1">🏔️</div>
          <div class="stays-owner-card c2">☕</div>
          <div class="stays-owner-card c3">🏡</div>
        </div>
      </div>
    </div>
  </section>

  </div>

  </div>

</Layout>

<style>
  /* ---------- Fixed background (behind lifestyle cards through footer) ---------- */
  .rental-bg {
    position: relative;
  }
  .rental-bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Flat sand-tinted wash (not a gradient): this whole layer is
       position:fixed, so a top-to-bottom gradient is anchored to the
       viewport, not the scrolling content — whatever text happens to sit
       on this background drifts through the gradient as the page scrolls,
       landing on the weak part just as often as the strong part. A uniform
       tint keeps legibility constant regardless of scroll position. */
    background-image:
      linear-gradient(rgba(245,240,232,.78), rgba(245,240,232,.78)),
      url('/fondoalquiler2.webp');
    background-size: cover;
    background-position: center 75%;
    background-repeat: no-repeat;
  }
  .rental-bg-content {
    position: relative;
    z-index: 1;
  }

  /* ---------- Hero ---------- */
  .stays-hero {
    position: relative;
    z-index: 1;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .stays-hero-img {
    position: absolute;
    top: -9%;
    left: 0;
    width: 100%;
    /* Overscan so the parallax scrub never reveals an edge. The load-zoom
       and scroll movement are driven by GSAP (see the parallax script). */
    height: 118%;
    object-fit: cover;
    will-change: transform;
  }
  .stays-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20,28,18,.42) 0%, rgba(34,61,38,.06) 34%, rgba(18,22,15,.58) 74%, rgba(15,17,12,.92) 100%),
      radial-gradient(90% 60% at 18% 88%, rgba(15,20,12,.55) 0%, transparent 70%);
  }
  .stays-hero-inner {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-top: 140px;
    padding-bottom: 44px;
  }
  .stays-hero-h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 6.4vw, 84px);
    line-height: .98;
    letter-spacing: -.028em;
    color: var(--color-white);
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .stays-hero-h1 em {
    font-family: var(--font-accent);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -.01em;
    color: #E8D9B8;
  }
  .stays-hero-sub {
    font-size: 17.5px;
    line-height: 1.6;
    color: rgba(245,240,232,.88);
    max-width: 540px;
    margin: 0 0 30px;
  }
  .stays-hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .stays-hero-stats {
    display: flex;
    gap: 52px;
    margin-top: 54px;
    padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.22);
    flex-wrap: wrap;
    row-gap: 22px;
  }
  .stays-stat-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    color: var(--color-white);
    line-height: 1;
  }
  .stays-stat-unit { font-size: 16px; font-weight: 700; color: rgba(245,240,232,.75); }
  .stays-stat-l { font-size: 13px; color: rgba(245,240,232,.68); margin-top: 6px; }

  /* One-shot load reveal for hero content (view() timeline would re-trigger) */
  .rv-once { animation: reveal .9s var(--ease-out) both; }

  /* ---------- Section headings ---------- */
  .stays-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h2);
    letter-spacing: -.02em;
    line-height: 1.06;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
  .stays-h2 em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    color: var(--color-forest);
  }
  .stays-how .stays-h2 em,
  .stays-owner .stays-h2 em { color: #E8D9B8; }
  .stays-sec-head {
    display: flex;
