<script>
  // Keeps the fixed background pinned to the viewport while scrolling,
  // fading it out before the footer so it never overlaps it (same
  // approach used on the rental detail page).
  const FADE_ZONE_PX = 220;

  function updateRentalBgVisibility() {
    const wrap = document.querySelector('.rental-bg');
    const canvas = document.querySelector<HTMLElement>('.rental-bg-canvas');
    if (!wrap || !canvas) return;
    const distanceToFooter = wrap.getBoundingClientRect().bottom - window.innerHeight;
    const opacity = Math.max(0, Math.min(1, distanceToFooter / FADE_ZONE_PX));
    canvas.style.opacity = String(opacity);
  }

  window.addEventListener('scroll', updateRentalBgVisibility, { passive: true });
  window.addEventListener('resize', updateRentalBgVisibility);
  document.addEventListener('DOMContentLoaded', updateRentalBgVisibility);
  document.addEventListener('astro:page-load', updateRentalBgVisibility);
</script>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.rental-card'));
  const rentalsGrid = document.getElementById('rentals-grid')!;
  const countEl = document.getElementById('results-count')!;
  const noResults = document.getElementById('no-results')!;
  const resultsCountRow = document.getElementById('results-count-row')!;
  const activeFiltersEl = document.getElementById('active-filters')!;
  const clearAllBtn = document.getElementById('clear-filters');
  const filtersApplyBtn = document.getElementById('filters-apply');
  const filtersApplyCounts = document.querySelectorAll<HTMLElement>('.filters-apply-count');

  const typeFilters = document.querySelectorAll<HTMLElement>('.type-filter');
  const amenityFilters = document.querySelectorAll<HTMLElement>('.amenity-filter');
  const durationFilters = document.querySelectorAll<HTMLElement>('.duration-filter');
  const priceRange = document.getElementById('price-range') as HTMLInputElement;
  const priceDisplay = document.getElementById('price-display')!;
  const guestsSelect = document.getElementById('guests-select') as HTMLSelectElement;
  const habsSelect = document.getElementById('habs-select') as HTMLSelectElement;
  const banosSelect = document.getElementById('banos-select') as HTMLSelectElement;
  const dateInput = document.getElementById('available-date') as HTMLInputElement;
  const ordenSelects = document.querySelectorAll<HTMLSelectElement>('.orden-select');

  // State starts from what the server already rendered (chip .is-active
  // classes, control values) — those reflect the URL's query params, see the
  // frontmatter above — so there is nothing to re-parse here.
  let activeType = document.querySelector<HTMLElement>('.type-filter.is-active')?.dataset.type ?? 'all';
  let maxPrice = parseInt(priceRange.value);
  let minGuests = parseInt(guestsSelect.value);
  let minHabs = parseInt(habsSelect.value);
  let minBanos = parseInt(banosSelect.value);
  let activeDuracion = document.querySelector<HTMLElement>('.duration-filter.is-active')?.dataset.duration ?? '';
  let disponibleDate = dateInput.value;
  let orden = ordenSelects[0]?.value ?? 'relevancia';
  const activeAmenities = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('.amenity-filter.is-active')).map(el => el.dataset.amenity ?? '')
  );

  const DURATION_LABELS: Record<string, { es: string; en: string }> = {
    '1-3': { es: '1–3 meses', en: '1–3 months' },
    '3-6': { es: '3–6 meses', en: '3–6 months' },
    '6-12': { es: '6–12 meses', en: '6–12 months' },
    '12+': { es: '12+ meses', en: '12+ months' },
  };
  const AMENITY_LABELS: Record<string, { es: string; en: string }> = {
    view: { es: 'Vista panorámica', en: 'Panoramic view' },
    pets: { es: 'Acepta mascotas', en: 'Pet friendly' },
    furnished: { es: 'Amueblado', en: 'Furnished' },
  };
  const TYPE_CHIP_LABELS: Record<string, { es: string; en: string }> = {
    casa: { es: 'Casa', en: 'House' },
    habitacion: { es: 'Habitación', en: 'Room' },
    apto: { es: 'Apartamento', en: 'Apartment' },
  };

  function chipHtml(label: { es: string; en: string }, dataAttrs: string) {
    return `<button type="button" class="active-filter-chip" ${dataAttrs}>` +
      `<span class="lang-es">${label.es}</span><span class="lang-en" hidden>${label.en}</span>` +
      `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>` +
      `</button>`;
  }

  function renderActiveChips() {
    const chips: string[] = [];
    if (activeType !== 'all') chips.push(chipHtml(TYPE_CHIP_LABELS[activeType] ?? { es: activeType, en: activeType }, 'data-remove="tipo"'));
    if (maxPrice < 1500) chips.push(chipHtml({ es: `Hasta $${maxPrice}`, en: `Up to $${maxPrice}` }, 'data-remove="precio"'));
    if (minGuests > 1) chips.push(chipHtml({ es: `${minGuests}+ personas`, en: `${minGuests}+ guests` }, 'data-remove="personas"'));
    if (minHabs > 0) chips.push(chipHtml({ es: `${minHabs}+ habitaciones`, en: `${minHabs}+ bedrooms` }, 'data-remove="habs"'));
    if (minBanos > 0) chips.push(chipHtml({ es: `${minBanos}+ baños`, en: `${minBanos}+ bathrooms` }, 'data-remove="banos"'));
    if (activeDuracion) chips.push(chipHtml(DURATION_LABELS[activeDuracion], 'data-remove="duracion"'));
    if (disponibleDate) chips.push(chipHtml({ es: `Desde ${disponibleDate}`, en: `From ${disponibleDate}` }, 'data-remove="disponible"'));
    activeAmenities.forEach(key => {
      chips.push(chipHtml(AMENITY_LABELS[key] ?? { es: key, en: key }, `data-remove="amenidad" data-remove-value="${key}"`));
    });

    activeFiltersEl.innerHTML = chips.join('');
    activeFiltersEl.style.display = chips.length ? 'flex' : 'none';
    if (clearAllBtn) clearAllBtn.style.display = chips.length > 1 ? 'inline' : 'none';
  }

  function updatePriceFill() {
    const pct = ((parseInt(priceRange.value) - parseInt(priceRange.min)) / (parseInt(priceRange.max) - parseInt(priceRange.min))) * 100;
    priceRange.style.setProperty('--fill', `${pct}%`);
  }

  function syncUrl() {
    const url = new URL(location.href);
    const sp = url.searchParams;
    activeType === 'all' ? sp.delete('tipo') : sp.set('tipo', activeType);
    maxPrice === 1500 ? sp.delete('precio_max') : sp.set('precio_max', String(maxPrice));
    minGuests === 1 ? sp.delete('personas') : sp.set('personas', String(minGuests));
    activeAmenities.size === 0 ? sp.delete('amenidades') : sp.set('amenidades', Array.from(activeAmenities).join(','));
    activeDuracion === '' ? sp.delete('duracion') : sp.set('duracion', activeDuracion);
    minHabs === 0 ? sp.delete('habs') : sp.set('habs', String(minHabs));
    minBanos === 0 ? sp.delete('banos') : sp.set('banos', String(minBanos));
    disponibleDate === '' ? sp.delete('disponible') : sp.set('disponible', disponibleDate);
    orden === 'relevancia' ? sp.delete('orden') : sp.set('orden', orden);
    history.replaceState(null, '', url);
  }

  function reorderCards() {
    const rank = (card: HTMLElement) => {
      if (orden === 'precio_asc') return parseInt(card.dataset.price ?? '0');
      if (orden === 'precio_desc') return -parseInt(card.dataset.price ?? '0');
      if (orden === 'rating') return -parseFloat(card.dataset.rating ?? '0');
      if (orden === 'recientes') return -parseInt(card.dataset.idx ?? '0');
      return parseInt(card.dataset.idx ?? '0'); // relevancia: original catalog order
    };
    [...cards].sort((a, b) => rank(a) - rank(b)).forEach(card => rentalsGrid.appendChild(card));
  }

  function applyFilters() {
    let count = 0;
    cards.forEach(card => {
      const type = card.dataset.type ?? '';
      const price = parseInt(card.dataset.price ?? '0');
      const guests = parseInt(card.dataset.guests ?? '0');
      const beds = parseInt(card.dataset.beds ?? '0');
      const baths = parseInt(card.dataset.baths ?? '0');
      const months = parseInt(card.dataset.months ?? '0');
      const available = card.dataset.available ?? '';
      const matchesAmenities = [...activeAmenities].every(key => card.dataset[key] === 'true');
      const matchesDuracion = !activeDuracion || (
        activeDuracion === '1-3' ? months <= 3 :
        activeDuracion === '3-6' ? months > 3 && months <= 6 :
        activeDuracion === '6-12' ? months > 6 && months <= 12 :
        months > 12
      );
      const matchesDisponible = !disponibleDate || !available || available <= disponibleDate;
      const show = (activeType === 'all' || type === activeType)
        && price <= maxPrice
        && guests >= minGuests
        && beds >= minHabs
        && baths >= minBanos
        && matchesAmenities
        && matchesDuracion
        && matchesDisponible;
      card.style.display = show ? 'block' : 'none';
      if (show) count++;
    });
    countEl.textContent = String(count);
    filtersApplyCounts.forEach(el => { el.textContent = String(count); });
    resultsCountRow.style.display = count === 0 ? 'none' : 'flex';
    noResults.style.display = count === 0 ? 'block' : 'none';
    reorderCards();
    renderActiveChips();
    syncUrl();
  }

  amenityFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.amenity ?? '';
      const active = activeAmenities.has(key);
      if (active) activeAmenities.delete(key); else activeAmenities.add(key);
      btn.classList.toggle('is-active', !active);
      applyFilters();
    });
  });

  typeFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.type ?? 'all';
      typeFilters.forEach(f => f.classList.toggle('is-active', f.dataset.type === activeType));
      applyFilters();
    });
  });

  durationFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      activeDuracion = btn.dataset.duration ?? '';
      durationFilters.forEach(f => f.classList.toggle('is-active', (f.dataset.duration ?? '') === activeDuracion));
      applyFilters();
    });
  });

  updatePriceFill();
  priceRange.addEventListener('input', () => {
    maxPrice = parseInt(priceRange.value);
    priceDisplay.textContent = `$${maxPrice}`;
    updatePriceFill();
    applyFilters();
  });

  guestsSelect.addEventListener('change', () => {
    minGuests = parseInt(guestsSelect.value);
    applyFilters();
  });

  habsSelect.addEventListener('change', () => {
    minHabs = parseInt(habsSelect.value);
    applyFilters();
  });

  banosSelect.addEventListener('change', () => {
    minBanos = parseInt(banosSelect.value);
    applyFilters();
  });

  dateInput.addEventListener('change', () => {
    disponibleDate = dateInput.value;
    applyFilters();
  });

  // Two <select>s (one per language, same pattern used elsewhere on the
  // site — see publicar-propiedad.astro) so the visible option text can be
  // fully translated instead of only the values.
  ordenSelects.forEach(sel => {
    sel.addEventListener('change', () => {
      orden = sel.value;
      ordenSelects.forEach(other => { if (other !== sel) other.value = orden; });
      applyFilters();
    });
  });

  activeFiltersEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-remove]');
    if (!btn) return;
    const kind = btn.dataset.remove;
    if (kind === 'tipo') {
      activeType = 'all';
      typeFilters.forEach(f => f.classList.toggle('is-active', f.dataset.type === 'all'));
    } else if (kind === 'precio') {
      maxPrice = 1500; priceRange.value = '1500'; priceDisplay.textContent = '$1500'; updatePriceFill();
    } else if (kind === 'personas') {
      minGuests = 1; guestsSelect.value = '1';
    } else if (kind === 'habs') {
      minHabs = 0; habsSelect.value = '0';
    } else if (kind === 'banos') {
      minBanos = 0; banosSelect.value = '0';
    } else if (kind === 'duracion') {
      activeDuracion = '';
      durationFilters.forEach(f => f.classList.toggle('is-active', (f.dataset.duration ?? '') === ''));
    } else if (kind === 'disponible') {
      disponibleDate = ''; dateInput.value = '';
    } else if (kind === 'amenidad') {
      const val = btn.dataset.removeValue ?? '';
      activeAmenities.delete(val);
      document.querySelector<HTMLElement>(`.amenity-filter[data-amenity="${val}"]`)?.classList.remove('is-active');
    }
    applyFilters();
  });

  clearAllBtn?.addEventListener('click', () => {
    activeType = 'all'; typeFilters.forEach(f => f.classList.toggle('is-active', f.dataset.type === 'all'));
    maxPrice = 1500; priceRange.value = '1500'; priceDisplay.textContent = '$1500'; updatePriceFill();
    minGuests = 1; guestsSelect.value = '1';
    minHabs = 0; habsSelect.value = '0';
    minBanos = 0; banosSelect.value = '0';
    activeDuracion = ''; durationFilters.forEach(f => f.classList.remove('is-active'));
    disponibleDate = ''; dateInput.value = '';
    activeAmenities.clear(); amenityFilters.forEach(f => f.classList.remove('is-active'));
    applyFilters();
  });

  // Lifestyle shortcuts: reset filters, then activate the matching chip by
  // programmatically clicking it (reuses the logic above, no duplicated state),
  // and scroll down to the results grid.
  document.querySelectorAll<HTMLElement>('[data-shortcut]').forEach(cardBtn => {
    cardBtn.addEventListener('click', () => {
      const key = cardBtn.dataset.shortcut ?? '';
      const kind = cardBtn.dataset.shortcutKind ?? 'amen';

      // Reset: type back to "all", clear any active amenities.
      const allChip = document.querySelector<HTMLElement>('.type-filter[data-type="all"]');
      if (activeType !== 'all') allChip?.click();
      amenityFilters.forEach(chip => {
        const k = chip.dataset.amenity ?? '';
        if (activeAmenities.has(k)) chip.click();
      });

      // Activate target.
      if (kind === 'type') {
        document.querySelector<HTMLElement>(`.type-filter[data-type="${key}"]`)?.click();
      } else {
        document.querySelector<HTMLElement>(`.amenity-filter[data-amenity="${key}"]`)?.click();
      }

      document.getElementById('explorar')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Mobile filters drawer (presentation only — does not touch filtering logic above)
  const sidebar = document.getElementById('filters-sidebar');
  const backdrop = document.getElementById('filters-backdrop');
  const openBtn = document.getElementById('filters-toggle');
  const closeBtn = document.getElementById('filters-close');

  function openDrawer() {
    sidebar?.classList.add('is-open');
    backdrop?.classList.remove('hidden');
    backdrop?.classList.add('is-open');
  }
  function closeDrawer() {
    sidebar?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    backdrop?.classList.add('hidden');
  }
  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  // "Ver N resultados" doubles as the drawer's apply/confirm action — filters
  // already apply live as the user taps them, so this just closes the sheet
  // and drops them back on the (already updated) results.
  filtersApplyBtn?.addEventListener('click', closeDrawer);

  // Initial paint: reconcile the client-side pass with what the server
  // already rendered (chips, order, count) — safe to run unconditionally
  // since applyFilters() is idempotent against the current control state.
  applyFilters();
</script>

<script>
  // Hero parallax: the background photo settles in with a soft zoom on load
  // and then scrubs slower than the page as you scroll, adding depth. Uses
  // ScrollTrigger, which ships free with the already-installed GSAP.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initHeroParallax() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const img = document.querySelector<HTMLElement>('.stays-hero-img');
    if (!img) return;

    // Clear anything left over from a previous client-side visit to this page.
    ScrollTrigger.getById('stays-hero-parallax')?.kill();
    gsap.killTweensOf(img);
    gsap.set(img, { clearProps: 'transform' });

    // Settle-in zoom.
    gsap.from(img, { scale: 1.14, duration: 1.9, ease: 'power2.out' });

    // Depth scrub, tied to the hero's own scroll range.
    gsap.to(img, {
      yPercent: 14,
      ease: 'none',
      scrollTrigger: {
        id: 'stays-hero-parallax',
        trigger: '.stays-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });
  }

  // Fires on the initial load and after every client-side navigation.
  document.addEventListener('astro:page-load', initHeroParallax);
</script>

<script>
  // Voices marquee: sets --voices-duration so the loop always moves at the
  // same visual speed (px/s) no matter how many reviews get added later —
  // a fixed animation-duration would make the loop speed up as the track
  // (which is exactly double the review count) gets wider.
  function initVoicesMarquee() {
    const track = document.getElementById('voices-track');
    if (!track) return;
    const PX_PER_SECOND = 36;
    // Track content is duplicated for the seamless loop, so the distance
    // actually travelled (0 → -50%) is half the full scrollWidth.
    const halfWidth = track.scrollWidth / 2;
    if (halfWidth > 0) {
      track.style.setProperty('--voices-duration', `${halfWidth / PX_PER_SECOND}s`);
    }
  }
  document.addEventListener('astro:page-load', initVoicesMarquee);
</script>
