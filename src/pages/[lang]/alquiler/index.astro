                  <div>
                    <span style="font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--color-ink)">${p.price}</span>
                    <span style="font-size:13.5px;color:var(--color-ink-faint)"> / <span class="lang-es">mes</span><span class="lang-en" hidden>month</span></span>
                  </div>
                  <span style="color:var(--color-forest);font-weight:700;font-size:13.5px;display:flex;align-items:center;gap:3px">
                    <span class="lang-es">Ver más</span><span class="lang-en" hidden>See more</span> <Icon name="chevron-right" size={14} />
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div id="no-results" class="card" style={`display:${RENTALS.length > 0 && FILTERED_RENTALS.length === 0 ? 'block' : 'none'};border-style:dashed;padding:54px 30px;text-align:center;color:var(--color-ink-faint);font-size:15.5px`}>
          <span class="lang-es">Sin resultados para estos filtros.</span><span class="lang-en" hidden>No results for these filters.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="stays-how">
    <svg class="stays-contours" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,220 C180,160 320,260 520,200 C720,140 860,240 1060,180 C1120,162 1170,170 1200,178" />
      <path d="M0,250 C200,190 340,290 540,230 C740,170 880,270 1080,210 C1130,195 1175,200 1200,206" />
      <path d="M0,190 C160,130 300,230 500,170 C700,110 840,210 1040,150 C1110,130 1165,140 1200,150" />
    </svg>
    <div class="pad-sec" style="max-width:1240px;margin:0 auto;position:relative;text-align:center">
      <div class="eyebrow rv" style="margin-bottom:12px;color:#E6B87C">
        <span class="lang-es">Sin fricción</span><span class="lang-en" hidden>Zero friction</span>
      </div>
      <h2 class="stays-h2 rv" style="color:var(--color-sand);margin-bottom:48px">
