<script>
  const mapEl = document.getElementById('map');
  const lat = parseFloat(mapEl?.dataset.lat ?? '');
  const lng = parseFloat(mapEl?.dataset.lng ?? '');
  const stayName = mapEl?.dataset.name ?? '';

  async function loadMap() {
    if (!mapEl || !Number.isFinite(lat) || !Number.isFinite(lng) || mapEl.dataset.loaded) return;
    mapEl.dataset.loaded = 'true';

    try {
      const [leafletModule, markerIcon2x, markerIcon, markerShadow] = await Promise.all([
        import('leaflet'),
        import('leaflet/dist/images/marker-icon-2x.png'),
        import('leaflet/dist/images/marker-icon.png'),
        import('leaflet/dist/images/marker-shadow.png'),
      ]);
      const L = leafletModule.default;
      delete L.Icon.Default.prototype._getIconUrl;
      L.Icon.Default.mergeOptions({
        iconRetinaUrl: (markerIcon2x.default as { src: string }).src,
        iconUrl: (markerIcon.default as { src: string }).src,
        shadowUrl: (markerShadow.default as { src: string }).src,
      });
      const map = L.map(mapEl, { scrollWheelZoom: false }).setView([lat, lng], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
        maxZoom: 18,
      }).addTo(map);
      L.marker([lat, lng]).addTo(map).bindPopup(`<strong>${stayName}</strong>`).openPopup();
    } catch (err) {
      console.error('No se pudo cargar el mapa:', err);
      mapEl.style.display = 'flex';
      mapEl.style.alignItems = 'center';
      mapEl.style.justifyContent = 'center';
      mapEl.innerHTML = `<a href="https://www.google.com/maps?q=${lat},${lng}" target="_blank" rel="noopener" style="color:#8E4A2A;font-weight:700;font-size:14px;text-decoration:none">Ver ubicación en Google Maps →</a>`;
    }
  }

  if (mapEl && Number.isFinite(lat) && Number.isFinite(lng)) {
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      void loadMap();
    }, { rootMargin: '300px 0px' });
    observer.observe(mapEl);
  }
</script>

<script>
  // Photo gallery lightbox: click any thumbnail to see it full-size,
  // reusing the same dark-backdrop pattern as the home gallery lightbox.
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('gallery-lightbox-img') as HTMLImageElement | null;

  function openLightbox(img: HTMLImageElement) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const img = trigger.querySelector('img');
      if (img) openLightbox(img);
    });
  });

  document.getElementById('gallery-lightbox-close')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<script is:inline define:vars={{ rentalId: stay.id, rentalName: stay.name.es, hostName: stay.host.name }}>
  // 3-step "solicitar información" flow — collects structured details
  // (move-in date, duration, occupants, pets) across step 1, contact info
  // in step 2, then posts a single lead (type: 'alquiler') on step 3. See
  // src/pages/api/leads.ts and /admin/leads for where it lands.
  const backdrop = document.getElementById('request-backdrop');
  const modal = document.getElementById('request-modal');
  const openBtn = document.getElementById('request-open');
  const closeBtn = document.getElementById('request-close');
  const dots = Array.from(document.querySelectorAll('.request-dot'));
  const steps = Array.from(document.querySelectorAll('.request-step'));
  const durationChips = Array.from(document.querySelectorAll('.req-duracion'));
  const mascotasChips = Array.from(document.querySelectorAll('.req-mascotas'));
  const moveInInput = document.getElementById('req-move-in');
  const personasSelect = document.getElementById('req-personas');
  const nombreInput = document.getElementById('req-nombre');
  const nombreError = document.getElementById('req-nombre-error');
  const emailInput = document.getElementById('req-email');
  const celularInput = document.getElementById('req-celular');
  const contactError = document.getElementById('req-contact-error');
  const mensajeInput = document.getElementById('req-mensaje');
  const summaryEl = document.getElementById('req-summary');
  const submitBtn = document.getElementById('req-submit');
  const doneBtn = document.getElementById('req-done');

  if (backdrop && modal && openBtn) {
    let activeDuracion = '';
    let activeMascotas = null; // true | false | null
    let lastFocused = null;

    function showStep(step) {
      steps.forEach(el => el.classList.toggle('hidden', el.dataset.step !== String(step)));
      dots.forEach(d => d.classList.toggle('is-active', d.dataset.dot === String(step)));
      const visible = steps.find(el => el.dataset.step === String(step));
      visible?.querySelector('input, select, textarea, button')?.focus();
    }

    function openModal() {
      lastFocused = document.activeElement;
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      showStep(1);
    }
    function closeModal() {
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    openBtn.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) closeModal(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) closeModal();
    });

    durationChips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeDuracion = chip.dataset.duracion ?? '';
        durationChips.forEach(c => c.classList.toggle('is-active', c === chip));
      });
    });
    mascotasChips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeMascotas = chip.dataset.mascotas === 'true';
        mascotasChips.forEach(c => c.classList.toggle('is-active', c === chip));
      });
    });

    function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

    function validateNombre() {
      const ok = nombreInput.value.trim().length > 0;
      nombreInput.setAttribute('aria-invalid', String(!ok));
      if (nombreError) nombreError.hidden = ok;
      return ok;
    }
    function validateContact() {
      const email = emailInput.value.trim();
      const celular = celularInput.value.trim();
      const ok = (email.length > 0 && isValidEmail(email)) || celular.length > 0;
      emailInput.setAttribute('aria-invalid', String(email.length > 0 && !isValidEmail(email)));
      celularInput.setAttribute('aria-invalid', String(!ok));
      if (contactError) contactError.hidden = ok;
      return ok;
    }
    // Validate on blur, not while typing, per the same rule the rest of the
    // site's lead forms follow.
    nombreInput?.addEventListener('blur', validateNombre);
    emailInput?.addEventListener('blur', validateContact);
    celularInput?.addEventListener('blur', validateContact);

    let messageAutoFilled = false;
    function autoComposeMessage() {
      if (messageAutoFilled || mensajeInput.value.trim().length > 0) return;
      const parts = [`Hola ${hostName}, me interesa ${rentalName}.`];
      if (moveInInput.value) parts.push(`Mudanza estimada: ${moveInInput.value}.`);
      if (activeDuracion) parts.push(`Duración buscada: ${activeDuracion} meses.`);
      if (personasSelect.value) parts.push(`Somos ${personasSelect.value}.`);
      if (activeMascotas === true) parts.push('Viajamos con mascota.');
      mensajeInput.value = parts.join(' ');
      messageAutoFilled = true;
    }

    function buildSummary() {
      const rows = [
        [{ es: 'Propiedad', en: 'Property' }, rentalName],
        [{ es: 'Fecha de entrada', en: 'Move-in' }, moveInInput.value || (document.documentElement.dataset.lang === 'en' ? 'Flexible' : 'Flexible')],
        [{ es: 'Duración', en: 'Duration' }, activeDuracion ? `${activeDuracion} meses` : (document.documentElement.dataset.lang === 'en' ? 'Any' : 'Cualquiera')],
        [{ es: 'Personas', en: 'Occupants' }, personasSelect.value],
        [{ es: 'Mascotas', en: 'Pets' }, activeMascotas === true ? 'Sí' : activeMascotas === false ? 'No' : '—'],
      ];
      summaryEl.innerHTML = rows.map(([label, val]) =>
        `<div class="req-summary-row"><span>${label.es}</span><b>${val}</b></div>`
      ).join('');
    }

    document.querySelectorAll('.request-next').forEach(btn => {
      btn.addEventListener('click', () => {
        const goto = btn.dataset.goto;
        if (goto === '2') { autoComposeMessage(); showStep(2); return; }
        if (goto === '3') {
          const validName = validateNombre();
          const validContact = validateContact();
          if (!validName) { nombreInput.focus(); return; }
          if (!validContact) { celularInput.focus(); return; }
          buildSummary();
          showStep(3);
        }
      });
    });
    document.querySelectorAll('.request-prev').forEach(btn => {
      btn.addEventListener('click', () => showStep(btn.dataset.goto));
    });

    submitBtn?.addEventListener('click', async () => {
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      const originalHtml = submitBtn.innerHTML;
      submitBtn.textContent = document.documentElement.dataset.lang === 'en' ? 'Sending…' : 'Enviando…';
      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'alquiler',
            nombre: nombreInput.value.trim(),
            email: emailInput.value.trim() || null,
            celular: celularInput.value.trim() || null,
            mensaje: mensajeInput.value.trim() || null,
            rental_id: rentalId,
            rental_name: rentalName,
            move_in: moveInInput.value || null,
            duracion: activeDuracion || null,
            personas: Number(personasSelect.value),
            mascotas: activeMascotas,
          }),
        });
        if (!res.ok) throw new Error('request failed');
        showStep('success');
      } catch {
        alert('No pudimos enviar tu solicitud. Intenta de nuevo. / We could not send your request. Please try again.');
        submitBtn.innerHTML = originalHtml;
      } finally {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
      }
    });

    doneBtn?.addEventListener('click', closeModal);
  }
</script>

<style>
  .rental-bg {
    position: relative;
  }
  .rental-bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Flat wash, not a gradient: this layer is position:fixed, so it's
       anchored to the viewport rather than the scrolling title block — a
       gradient would drift in and out of strength as the page scrolls. */
    background-image:
      linear-gradient(rgba(245,240,232,.68), rgba(245,240,232,.68)),
      url('/fondoalquiler.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .rental-bg-content {
    position: relative;
    z-index: 1;
  }

  /* Gallery cells are <button>s so photos are keyboard- and click-accessible;
     reset default button chrome and add a hover cue that they open a lightbox. */
  .gallery-cell {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }
  .gallery-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 15, 10, 0);
    transition: background-color .18s ease;
  }
  .gallery-cell:hover::after,
  .gallery-cell:focus-visible::after {
    background: rgba(20, 15, 10, .15);
  }

  .whatsapp-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    box-sizing: border-box;
    margin: 0 0 10px;
    padding: 13px 16px;
    border-radius: 11px;
    background: #25D366;
    color: #12341f;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
