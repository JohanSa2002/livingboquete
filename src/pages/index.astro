---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GalleryMasonry from '../components/GalleryMasonry';
import { GALLERY_CATS } from '../data/data';
import { getSupabase } from '../lib/supabase';
import { Image, getImage } from 'astro:assets';
import heroPoster from '../assets/hero-poster.webp';

async function fetchAll(table: string) {
  const { data } = await getSupabase()
    .from(table)
    .select('data')
    .order('created_at', { ascending: true });
  return (data ?? []).map((r: any) => r.data);
}

async function fetchPosts() {
  const { data } = await getSupabase()
    .from('posts')
    .select('data')
    .order('created_at', { ascending: false });
  return (data ?? []).map((r: any) => r.data);
}

const [PLACES, EVENTS, POSTS, GALLERY] = await Promise.all([
  fetchAll('places'),
  fetchAll('events'),
  fetchPosts(),
  fetchAll('gallery'),
]);

const homePosts = POSTS.slice(0, 3);

const galleryItems = await Promise.all(
  GALLERY.map(async (g: any) => {
    const [thumb, full] = await Promise.all([
      getImage({ src: g.img, width: 600, height: 600 }),
      getImage({ src: g.img, width: 1600, height: 1600 }),
    ]);
    return { ...g, img: thumb.src, fullImg: full.src };
  })
);

const jsonSafe = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---

<Layout activeKey="home">

  <!-- HERO -->
  <section style="position:relative;min-height:92dvh;display:flex;align-items:flex-end;overflow:hidden">
    <Image
      src={heroPoster}
      alt="Vista de Boquete"
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="100vw"
      quality={65}
      loading="eager"
      fetchpriority="high"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1"
    />
    <div style="position:absolute;inset:0;z-index:3;background:linear-gradient(180deg,rgba(20,28,18,.4) 0%,rgba(34,61,38,.08) 30%,rgba(18,22,15,.6) 76%,rgba(15,17,12,.88) 100%)"></div>

    <div class="pad-sec" style="position:relative;z-index:4;max-width:1240px;margin:0 auto;padding:0 26px 64px;width:100%;color:var(--color-sand)">
      <h1 style="font-family:var(--font-display);font-weight:800;font-size:var(--text-hero);line-height:1.05;letter-spacing:-.025em;margin:0 0 20px;max-width:820px;text-shadow:0 4px 30px rgba(0,0,0,.25)">
        <span class="lang-es">Encuentra tu próximo hogar entre montañas.</span>
        <span class="lang-en" hidden>Find your next home among the mountains.</span>
      </h1>
      <p style="font-family:var(--font-body);font-size:clamp(17px,1.6vw,20px);max-width:560px;line-height:1.5;margin:0 0 36px;color:#E7E2D6">
        <span class="lang-es">Alquileres mensuales en Boquete para nómadas digitales, profesionales y familias que buscan naturaleza, clima fresco y una vida más tranquila.</span>
        <span class="lang-en" hidden>Monthly rentals in Boquete for digital nomads, professionals and families looking for nature, cool weather and a quieter pace of life.</span>
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <a href="/alquiler" class="btn btn-primary" style="font-size:16px;padding:17px 30px">
          <Icon name="search" size={18} />
          <span class="lang-es">Buscar alquileres</span>
          <span class="lang-en" hidden>Search rentals</span>
        </a>
        <a href="#atractivos" class="btn btn-ghost" style="font-size:16px;padding:17px 30px">
          <span class="lang-es">Explorar la comunidad</span>
          <span class="lang-en" hidden>Explore the community</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST STATS -->
  <section class="pad-sec" style="max-width:1240px;margin:-34px auto 0;padding:0 26px;position:relative;z-index:5">
    <div class="hero-stats" style="background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);display:flex;align-items:center;justify-content:space-around;padding:28px 20px;gap:20px">
      <div class="hero-stat" data-reveal="title" style="text-align:center">
        <div class="hero-stat-num" style="font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">120+</div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">propiedades</span><span class="lang-en" hidden>properties</span>
        </div>
      </div>
      <div class="hero-stat-divider" style="width:1px;height:38px;background:var(--color-border)"></div>
      <div class="hero-stat" data-reveal="title" style="text-align:center">
        <div class="hero-stat-num" style="display:flex;align-items:center;justify-content:center;gap:6px;font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">
          4.9 <span style="color:var(--color-wood)"><Icon name="star" size={20} /></span>
        </div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">calificación promedio</span><span class="lang-en" hidden>average rating</span>
        </div>
      </div>
      <div class="hero-stat-divider" style="width:1px;height:38px;background:var(--color-border)"></div>
      <div class="hero-stat" data-reveal="title" style="text-align:center">
        <div class="hero-stat-num" style="font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">500+</div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">residentes felices</span><span class="lang-en" hidden>happy residents</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TOP ATTRACTIONS -->
  <section id="atractivos" class="rv" style="padding:96px 0 40px">
    <div class="pad-sec" style="max-width:1240px;margin:0 auto;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:42px;flex-wrap:wrap">
      <div style="max-width:560px">
        <div class="eyebrow" data-reveal="slide-right" style="margin-bottom:14px">
          <span class="lang-es">Principales atractivos</span>
          <span class="lang-en" hidden>Top attractions</span>
        </div>
        <h2 class="attractions-h2" data-reveal="slide-right" style="font-family:'Manrope';font-weight:700;font-size:clamp(34px,4.4vw,52px);line-height:1.02;letter-spacing:-.02em;margin:0;color:#251D14">
          <span class="lang-es">Seis razones para perderse —y reencontrarse— en las montañas de Boquete.</span>
          <span class="lang-en" hidden>Six reasons to get lost — and find yourself — in the mountains of Boquete.</span>
        </h2>
      </div>
    </div>

    <div class="attractions-carousel" id="attractions-carousel">
      <div class="attractions-viewport" id="attractions-viewport">
        <div class="attractions-track" id="attractions-track">
          {[...PLACES, ...PLACES].map((p, i) => {
            const isClone = i >= PLACES.length;
            return (
              <div
                class="place-card attractions-card"
                data-place-id={p.id}
                data-real-index={i % PLACES.length}
                data-clone={isClone ? 'true' : undefined}
                role="button"
                tabindex={isClone ? -1 : 0}
                aria-hidden={isClone ? 'true' : undefined}
              >
                <div class="attractions-media">
                  <Image src={p.img} width={480} height={360} densities={[1, 2]} alt={p.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
                  <span class="attractions-badge">
                    <span class="lang-es">{p.cat.es}</span><span class="lang-en" hidden>{p.cat.en}</span>
                  </span>
                </div>
                <div class="attractions-body">
                  <h3 class="attractions-title">
                    <span class="lang-es">{p.name.es}</span><span class="lang-en" hidden>{p.name.en}</span>
                  </h3>
                  <p class="attractions-desc">
                    <span class="lang-es">{p.short.es}</span><span class="lang-en" hidden>{p.short.en}</span>
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <div class="pad-sec attractions-controls" style="max-width:1240px;margin:22px auto 0;display:flex;align-items:center;justify-content:center">
      <div class="attractions-dots" id="attractions-dots" role="group" aria-label="Atractivos">
        {PLACES.map((_, i) => (
          <button type="button" class="attractions-dot" data-dot-index={i} aria-label={`${i + 1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <!-- UPCOMING EVENTS -->
  <section class="pad-sec rv" style="max-width:1240px;margin:0 auto;padding:74px 26px 30px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:34px;flex-wrap:wrap">
      <div>
        <div class="eyebrow" data-reveal="slide-left" style="margin-bottom:12px">
          <span class="lang-es">Próximos eventos</span><span class="lang-en" hidden>Upcoming events</span>
        </div>
        <h2 data-reveal="slide-left" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
          <span class="lang-es">Ferias, música y tradición durante todo el año.</span>
          <span class="lang-en" hidden>Fairs, music and tradition throughout the year.</span>
        </h2>
      </div>
    </div>
    <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
      {EVENTS.map(e => (
        <div class="event-card" data-event-id={e.id} role="button" tabindex="0" style="position:relative;border-radius:18px;overflow:hidden;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end">
          <Image src={e.img} width={420} height={300} densities={[1, 2]} alt={e.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,28,18,.12),rgba(18,20,12,.85))"></div>
          <div style="position:absolute;top:15px;left:15px;background:#F7F1E6;border-radius:13px;text-align:center;padding:9px 13px;line-height:1">
            <div style="font-family:'Manrope';font-weight:800;font-size:25px;color:#B95C36">{e.d}</div>
            <div style="font-size:11px;font-weight:700;letter-spacing:.1em;color:#5A4F42;margin-top:2px">
              <span class="lang-es">{e.m.es}</span><span class="lang-en" hidden>{e.m.en}</span>
            </div>
          </div>
          <div style="position:relative;z-index:2;padding:20px;color:#F7F1E6">
            <span style="font-size:12px;font-weight:700;letter-spacing:.06em;color:#E7C98C">
              <span class="lang-es">{e.cat.es}</span><span class="lang-en" hidden>{e.cat.en}</span>
            </span>
            <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;margin:7px 0 6px;line-height:1.1">
              <span class="lang-es">{e.name.es}</span><span class="lang-en" hidden>{e.name.en}</span>
            </h3>
            <p style="font-size:13.5px;color:#D8CDBA;margin:0">
              <span class="lang-es">{e.place.es} · {e.time.es}</span>
              <span class="lang-en" hidden>{e.place.en} · {e.time.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section style="background:#EFE7D6;margin-top:74px">
    <div class="pad-sec rv" style="max-width:1240px;margin:0 auto;padding:74px 26px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:34px;flex-wrap:wrap">
        <div>
          <div class="eyebrow" data-reveal="slide-right" style="margin-bottom:12px">
            <span class="lang-es">Del blog</span><span class="lang-en" hidden>From the blog</span>
          </div>
          <h2 data-reveal="slide-right" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
            <span class="lang-es">Historias, guías y consejos para tu viaje.</span>
            <span class="lang-en" hidden>Stories, guides and tips for your trip.</span>
          </h2>
        </div>
        <a href="/blog" style="color:#2C3A2A;font-weight:700;text-decoration:none;border-bottom:2px solid #C8964A;padding-bottom:3px;white-space:nowrap">
          <span class="lang-es">Ver todos</span><span class="lang-en" hidden>See all</span> →
        </a>
      </div>
      <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:26px">
        {homePosts.map(b => (
          <a href={`/blog/${b.id}`} style="cursor:pointer;text-decoration:none;color:inherit;display:block">
            <div style="position:relative;aspect-ratio:3/2.1;border-radius:16px;overflow:hidden;margin-bottom:16px">
              <Image src={b.img} width={420} height={294} densities={[1, 2]} alt={b.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
            </div>
            <div style="display:flex;gap:10px;align-items:center;font-size:12.5px;color:var(--color-ink-faint);margin-bottom:9px">
              <span style="color:#B95C36;font-weight:700">
                <span class="lang-es">{b.cat.es}</span><span class="lang-en" hidden>{b.cat.en}</span>
              </span>
              <span>·</span>
              <span><span class="lang-es">{b.date.es}</span><span class="lang-en" hidden>{b.date.en}</span></span>
            </div>
            <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;line-height:1.18;margin:0 0 9px;color:#251D14">
              <span class="lang-es">{b.title.es}</span><span class="lang-en" hidden>{b.title.en}</span>
            </h3>
            <p style="font-size:14.5px;line-height:1.55;color:#5A4F42;margin:0">
              <span class="lang-es">{b.excerpt.es}</span><span class="lang-en" hidden>{b.excerpt.en}</span>
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY PREVIEW -->
  <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding:74px 26px 20px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:30px;flex-wrap:wrap">
      <div>
        <div class="eyebrow" data-reveal="slide-left" style="margin-bottom:12px">
          <span class="lang-es">Galería</span><span class="lang-en" hidden>Gallery</span>
        </div>
        <h2 data-reveal="slide-left" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
          <span class="lang-es">Un vistazo a la vida en las tierras altas.</span>
          <span class="lang-en" hidden>A glimpse of life in the highlands.</span>
        </h2>
      </div>
    </div>
    <GalleryMasonry
      client:idle
      items={galleryItems}
      categories={GALLERY_CATS}
    />
  </section>

  <!-- LEAD FORM -->
  <section id="contacto" style="background:var(--color-forest-dark)">
    <div class="lead-wrap" style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;min-height:600px">

      <!-- Left: Copy -->
      <div style="padding:clamp(40px,5vw,80px) clamp(26px,4vw,64px);display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="color:#E6B87C;margin-bottom:18px">
          <span class="lang-es">Guía gratuita</span>
          <span class="lang-en" hidden>Complimentary guide</span>
        </div>
        <h2 style="font-family:'Spectral';font-weight:700;font-size:clamp(32px,4.2vw,52px);line-height:1.08;letter-spacing:-.01em;margin:0 0 20px;color:#F7F1E6">
          <span class="lang-es">Antes de planear la mudanza, ten el panorama completo.</span>
          <span class="lang-en" hidden>Before you plan the move, get the full picture.</span>
        </h2>
        <p style="font-size:16px;line-height:1.65;color:rgba(245,240,232,.72);margin:0 0 32px;max-width:440px">
          <span class="lang-es">Nuestra guía práctica para retirarse en Boquete reúne las preguntas importantes en un solo lugar, claro y accesible.</span>
          <span class="lang-en" hidden>Our practical introduction to retiring in Boquete brings the important questions into one calm, readable place.</span>
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 32px">
          {[
            { es: 'Por qué eligen Panamá', en: 'Why people choose Panama' },
            { es: 'Qué hace único a Boquete', en: 'What makes Boquete different' },
            { es: 'Costo de vida', en: 'Cost of living considerations' },
            { es: 'Comprar como extranjero', en: 'Buying as a foreigner' },
            { es: 'Residencia y trámites', en: 'Residency basics' },
            { es: 'Salud y servicios', en: 'Healthcare nearby' },
            { es: 'Preguntas clave antes de comprar', en: 'Questions before buying' },
            { es: 'Checklist para tu visita', en: 'Visit planning checklist' },
          ].map(item => (
            <div style="display:flex;align-items:baseline;gap:8px;font-size:14.5px;color:#D8CDBA;line-height:1.6">
              <span style="color:#E6B87C;font-size:13px;flex:none">+</span>
              <span>
                <span class="lang-es">{item.es}</span>
                <span class="lang-en" hidden>{item.en}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Form card -->
      <div style="padding:clamp(32px,4vw,60px) clamp(26px,4vw,56px);display:flex;align-items:center">
        <div id="lead-card" style="background:#F7F1E6;border-radius:20px;padding:clamp(28px,3.4vw,44px);width:100%;box-shadow:0 30px 60px -20px rgba(0,0,0,.25)">
          <h3 style="font-family:'Manrope';font-weight:800;font-size:clamp(22px,2.6vw,30px);color:#251D14;margin:0 0 6px">
            <span class="lang-es">Recibe la guía gratis</span>
            <span class="lang-en" hidden>Send me the free guide</span>
          </h3>
          <p style="font-size:14.5px;color:#5A4F42;margin:0 0 24px;line-height:1.5">
            <span class="lang-es">Un punto de partida útil, directo a tu correo.</span>
            <span class="lang-en" hidden>A useful starting point, delivered to your inbox.</span>
          </p>

          <form id="lead-form" style="display:flex;flex-direction:column;gap:16px">
            <!-- Nombre -->
            <div>
              <label class="lead-label" for="lead-nombre">
                <span class="lang-es">Nombre completo</span><span class="lang-en" hidden>Full name</span>
              </label>
              <input id="lead-nombre" name="nombre" required class="lead-input" />
            </div>

            <!-- Email + Celular -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label" for="lead-email">
                  <span class="lang-es">Correo</span><span class="lang-en" hidden>Email</span>
                </label>
                <input id="lead-email" name="email" type="email" required class="lead-input" />
              </div>
              <div>
                <label class="lead-label" for="lead-celular">
                  <span class="lang-es">Celular / WhatsApp</span><span class="lang-en" hidden>Phone / WhatsApp</span>
                </label>
                <input id="lead-celular" name="celular" type="tel" class="lead-input" />
              </div>
            </div>

            <!-- País + Retiro -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label" for="lead-pais">
                  <span class="lang-es">País</span><span class="lang-en" hidden>Country</span>
                </label>
                <input id="lead-pais" name="pais" class="lead-input" />
              </div>
              <div>
                <label class="lead-label lang-es" for="lead-retiro-es">¿Planeas retirarte?</label>
                <label class="lead-label lang-en" for="lead-retiro-en">Planning to retire?</label>
                <select id="lead-retiro-es" name="retiro" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="si">Sí</option>
                  <option value="talvez">Tal vez</option>
                  <option value="investigando">Estoy investigando</option>
                </select>
                <select id="lead-retiro-en" name="retiro" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="si">Yes</option>
                  <option value="talvez">Maybe</option>
                  <option value="investigando">I'm researching</option>
                </select>
              </div>
            </div>

            <!-- Timeline + Interés -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label lang-es" for="lead-timeline-es">Horizonte de tiempo</label>
                <label class="lead-label lang-en" for="lead-timeline-en">Timeline</label>
                <select id="lead-timeline-es" name="timeline" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="0-6">0–6 meses</option>
                  <option value="6-12">6–12 meses</option>
                  <option value="1ano">1 año</option>
                  <option value="2anos">2+ años</option>
                </select>
                <select id="lead-timeline-en" name="timeline" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="0-6">0–6 months</option>
                  <option value="6-12">6–12 months</option>
                  <option value="1ano">1 year</option>
                  <option value="2anos">2+ years</option>
                </select>
              </div>
              <div>
                <label class="lead-label lang-es" for="lead-interes-es">Interés principal</label>
                <label class="lead-label lang-en" for="lead-interes-en">Main interest</label>
                <select id="lead-interes-es" name="interes" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="retiro">Retiro</option>
                  <option value="estilo">Estilo de vida</option>
                  <option value="casa">Comprar casa</option>
                  <option value="inversiones">Inversiones</option>
                  <option value="info">Información local</option>
                </select>
                <select id="lead-interes-en" name="interes" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="retiro">Retirement</option>
                  <option value="estilo">Lifestyle</option>
                  <option value="casa">Buy a home</option>
                  <option value="inversiones">Investments</option>
                  <option value="info">Local info</option>
                </select>
              </div>
            </div>

