  <div id="detail-backdrop" class="detail-backdrop" hidden>
    <div id="detail-modal" class="detail-modal" role="dialog" aria-modal="true">
      <button id="detail-close" class="detail-close" type="button" aria-label="Cerrar">&times;</button>
      <div class="detail-media">
        <img id="detail-img" src="" alt="" />
        <span id="detail-badge" class="detail-badge"></span>
        <div id="detail-date" class="detail-date-badge" hidden>
          <span id="detail-date-d" class="detail-date-d"></span>
          <span id="detail-date-m" class="detail-date-m"></span>
        </div>
      </div>
      <!-- data-lenis-prevent: Lenis's own wheel handler still preventDefaults
           everything while stopped (see openDetail below), so without this
           attribute the modal's internal scroll would be frozen along with
           the background. Lenis special-cases this attribute to fall back
           to native scrolling for the element, stopped or not. -->
      <div id="detail-body-content" class="detail-body-content" data-lenis-prevent>
        <h3 id="detail-title" class="detail-title"></h3>
        <p id="detail-desc" class="detail-desc"></p>
        <div id="detail-meta" class="detail-meta"></div>
        <div id="detail-tips" class="detail-tips" hidden>
