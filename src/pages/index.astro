---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GalleryMasonry from '../components/GalleryMasonry';
import { GALLERY_CATS } from '../data/data';
import { getSupabase, cachedQuery } from '../lib/supabase';
import { Image, getImage } from 'astro:assets';

async function fetchAll(table: string) {
  const { data } = await getSupabase()
    .from(table)
    .select('data')
    .order('created_at', { ascending: true });
  return (data ?? []).map((r: any) => r.data);
}

const [PLACES, EVENTS, POSTS, GALLERY] = await Promise.all(
  ['places', 'events', 'posts', 'gallery'].map((table) => cachedQuery(table, () => fetchAll(table)))
);

const homePosts = POSTS.slice(0, 3);

const galleryItems = await Promise.all(
  GALLERY.map(async (g: any) => {
    const [thumb, full] = await Promise.all([
      getImage({ src: g.img, width: 600, height: 600 }),
      getImage({ src: g.img, width: 1600, height: 1600 }),
    ]);
    return { ...g, img: thumb.src, fullImg: full.src };
  })
);

const jsonSafe = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---

<Layout activeKey="home">

  <!-- HERO -->
  <section style="position:relative;min-height:92dvh;display:flex;align-items:flex-end;overflow:hidden">
    <img
      id="hero-poster"
      src="/hero-poster.webp"
      alt="Vista de Boquete"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1"
    />
    <div style="position:absolute;inset:0;z-index:3;background:linear-gradient(180deg,rgba(20,28,18,.4) 0%,rgba(34,61,38,.08) 30%,rgba(18,22,15,.6) 76%,rgba(15,17,12,.88) 100%)"></div>

    <div class="pad-sec" style="position:relative;z-index:4;max-width:1240px;margin:0 auto;padding:0 26px 64px;width:100%;color:var(--color-sand)">
      <h1 style="font-family:var(--font-display);font-weight:800;font-size:var(--text-hero);line-height:1.05;letter-spacing:-.025em;margin:0 0 20px;max-width:820px;text-shadow:0 4px 30px rgba(0,0,0,.25)">
        <span class="lang-es">Encuentra tu próximo hogar entre montañas.</span>
        <span class="lang-en" hidden>Find your next home among the mountains.</span>
      </h1>
      <p style="font-family:var(--font-body);font-size:clamp(17px,1.6vw,20px);max-width:560px;line-height:1.5;margin:0 0 36px;color:#E7E2D6">
        <span class="lang-es">Alquileres mensuales en Boquete para nómadas digitales, profesionales y familias que buscan naturaleza, clima fresco y una vida más tranquila.</span>
        <span class="lang-en" hidden>Monthly rentals in Boquete for digital nomads, professionals and families looking for nature, cool weather and a quieter pace of life.</span>
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <a href="/alquiler" class="btn btn-primary" style="font-size:16px;padding:17px 30px">
          <Icon name="search" size={18} />
          <span class="lang-es">Buscar alquileres</span>
          <span class="lang-en" hidden>Search rentals</span>
        </a>
        <a href="#atractivos" class="btn btn-ghost" style="font-size:16px;padding:17px 30px">
          <span class="lang-es">Explorar la comunidad</span>
          <span class="lang-en" hidden>Explore the community</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST STATS -->
  <section class="pad-sec" style="max-width:1240px;margin:-34px auto 0;padding:0 26px;position:relative;z-index:5">
    <div class="hero-stats" style="background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);display:flex;align-items:center;justify-content:space-around;padding:28px 20px;gap:20px">
      <div class="hero-stat" style="text-align:center">
        <div class="hero-stat-num" style="font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">120+</div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">propiedades</span><span class="lang-en" hidden>properties</span>
        </div>
      </div>
      <div class="hero-stat-divider" style="width:1px;height:38px;background:var(--color-border)"></div>
      <div class="hero-stat" style="text-align:center">
        <div class="hero-stat-num" style="display:flex;align-items:center;justify-content:center;gap:6px;font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">
          4.9 <span style="color:var(--color-wood)"><Icon name="star" size={20} /></span>
        </div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">calificación promedio</span><span class="lang-en" hidden>average rating</span>
        </div>
      </div>
      <div class="hero-stat-divider" style="width:1px;height:38px;background:var(--color-border)"></div>
      <div class="hero-stat" style="text-align:center">
        <div class="hero-stat-num" style="font-family:var(--font-display);font-weight:800;font-size:clamp(24px,3vw,32px);color:var(--color-forest)">500+</div>
        <div class="hero-stat-label" style="font-size:var(--text-meta);color:var(--color-ink-soft);font-weight:600">
          <span class="lang-es">residentes felices</span><span class="lang-en" hidden>happy residents</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TOP ATTRACTIONS -->
  <section id="atractivos" class="pad-sec rv" style="max-width:1240px;margin:0 auto;padding:96px 26px 30px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:42px;flex-wrap:wrap">
      <div style="max-width:560px">
        <div class="eyebrow" data-reveal="slide-right" style="margin-bottom:14px">
          <span class="lang-es">Principales atractivos</span>
          <span class="lang-en" hidden>Top attractions</span>
        </div>
        <h2 data-reveal="slide-right" style="font-family:'Manrope';font-weight:700;font-size:clamp(34px,4.4vw,52px);line-height:1.02;letter-spacing:-.02em;margin:0;color:#251D14">
          <span class="lang-es">Seis razones para perderse —y reencontrarse— en las montañas de Boquete.</span>
          <span class="lang-en" hidden>Six reasons to get lost — and find yourself — in the mountains of Boquete.</span>
        </h2>
      </div>
    </div>
    <div class="cols-3" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px">
      {PLACES.map(p => (
        <div class="place-card" data-place-id={p.id} role="button" tabindex="0" style="border-radius:12px;overflow:hidden;background:#fff;border:1px solid rgba(37,29,20,.09);box-shadow:0 1px 2px rgba(37,29,20,.04);display:flex;flex-direction:column">
          <div style="position:relative;aspect-ratio:4/2.6;overflow:hidden">
            <Image src={p.img} width={480} height={312} densities={[1, 2]} alt={p.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
            <span style="position:absolute;top:8px;left:8px;background:rgba(20,28,18,.62);backdrop-filter:blur(4px);color:#F7F1E6;font-size:10px;font-weight:700;letter-spacing:.04em;padding:4px 8px;border-radius:999px">
              <span class="lang-es">{p.cat.es}</span><span class="lang-en" hidden>{p.cat.en}</span>
            </span>
          </div>
          <div style="padding:11px 12px 13px;display:flex;flex-direction:column;flex:1">
            <h3 style="font-family:'Manrope';font-weight:700;font-size:14.5px;margin:0 0 5px;color:#251D14">
              <span class="lang-es">{p.name.es}</span><span class="lang-en" hidden>{p.name.en}</span>
            </h3>
            <p style="font-size:11.5px;line-height:1.45;color:#5A4F42;margin:0;flex:1">
              <span class="lang-es">{p.short.es}</span><span class="lang-en" hidden>{p.short.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- UPCOMING EVENTS -->
  <section class="pad-sec rv" style="max-width:1240px;margin:0 auto;padding:74px 26px 30px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:34px;flex-wrap:wrap">
      <div>
        <div class="eyebrow" data-reveal="slide-left" style="margin-bottom:12px">
          <span class="lang-es">Próximos eventos</span><span class="lang-en" hidden>Upcoming events</span>
        </div>
        <h2 data-reveal="slide-left" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
          <span class="lang-es">Ferias, música y tradición durante todo el año.</span>
          <span class="lang-en" hidden>Fairs, music and tradition throughout the year.</span>
        </h2>
      </div>
    </div>
    <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
      {EVENTS.map(e => (
        <div class="event-card" data-event-id={e.id} role="button" tabindex="0" style="position:relative;border-radius:18px;overflow:hidden;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end">
          <Image src={e.img} width={420} height={300} densities={[1, 2]} alt={e.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,28,18,.12),rgba(18,20,12,.85))"></div>
          <div style="position:absolute;top:15px;left:15px;background:#F7F1E6;border-radius:13px;text-align:center;padding:9px 13px;line-height:1">
            <div style="font-family:'Manrope';font-weight:800;font-size:25px;color:#B95C36">{e.d}</div>
            <div style="font-size:11px;font-weight:700;letter-spacing:.1em;color:#5A4F42;margin-top:2px">
              <span class="lang-es">{e.m.es}</span><span class="lang-en" hidden>{e.m.en}</span>
            </div>
          </div>
          <div style="position:relative;z-index:2;padding:20px;color:#F7F1E6">
            <span style="font-size:12px;font-weight:700;letter-spacing:.06em;color:#E7C98C">
              <span class="lang-es">{e.cat.es}</span><span class="lang-en" hidden>{e.cat.en}</span>
            </span>
            <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;margin:7px 0 6px;line-height:1.1">
              <span class="lang-es">{e.name.es}</span><span class="lang-en" hidden>{e.name.en}</span>
            </h3>
            <p style="font-size:13.5px;color:#D8CDBA;margin:0">
              <span class="lang-es">{e.place.es} · {e.time.es}</span>
              <span class="lang-en" hidden>{e.place.en} · {e.time.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section style="background:#EFE7D6;margin-top:74px">
    <div class="pad-sec rv" style="max-width:1240px;margin:0 auto;padding:74px 26px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:34px;flex-wrap:wrap">
        <div>
          <div class="eyebrow" data-reveal="slide-right" style="margin-bottom:12px">
            <span class="lang-es">Del blog</span><span class="lang-en" hidden>From the blog</span>
          </div>
          <h2 data-reveal="slide-right" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
            <span class="lang-es">Historias, guías y consejos para tu viaje.</span>
            <span class="lang-en" hidden>Stories, guides and tips for your trip.</span>
          </h2>
        </div>
        <a href="/blog" style="color:#2C3A2A;font-weight:700;text-decoration:none;border-bottom:2px solid #C8964A;padding-bottom:3px;white-space:nowrap">
          <span class="lang-es">Ver todos</span><span class="lang-en" hidden>See all</span> →
        </a>
      </div>
      <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:26px">
        {homePosts.map(b => (
          <a href={`/blog/${b.id}`} style="cursor:pointer;text-decoration:none;color:inherit;display:block">
            <div style="position:relative;aspect-ratio:3/2.1;border-radius:16px;overflow:hidden;margin-bottom:16px">
              <Image src={b.img} width={420} height={294} densities={[1, 2]} alt={b.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
            </div>
            <div style="display:flex;gap:10px;align-items:center;font-size:12.5px;color:#8A7D69;margin-bottom:9px">
              <span style="color:#B95C36;font-weight:700">
                <span class="lang-es">{b.cat.es}</span><span class="lang-en" hidden>{b.cat.en}</span>
              </span>
              <span>·</span>
              <span><span class="lang-es">{b.date.es}</span><span class="lang-en" hidden>{b.date.en}</span></span>
            </div>
            <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;line-height:1.18;margin:0 0 9px;color:#251D14">
              <span class="lang-es">{b.title.es}</span><span class="lang-en" hidden>{b.title.en}</span>
            </h3>
            <p style="font-size:14.5px;line-height:1.55;color:#5A4F42;margin:0">
              <span class="lang-es">{b.excerpt.es}</span><span class="lang-en" hidden>{b.excerpt.en}</span>
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY PREVIEW -->
  <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding:74px 26px 20px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:30px;flex-wrap:wrap">
      <div>
        <div class="eyebrow" data-reveal="slide-left" style="margin-bottom:12px">
          <span class="lang-es">Galería</span><span class="lang-en" hidden>Gallery</span>
        </div>
        <h2 data-reveal="slide-left" style="font-family:'Manrope';font-weight:700;font-size:clamp(30px,3.6vw,42px);margin:0;color:#251D14;letter-spacing:-.02em">
          <span class="lang-es">Un vistazo a la vida en las tierras altas.</span>
          <span class="lang-en" hidden>A glimpse of life in the highlands.</span>
        </h2>
      </div>
    </div>
    <GalleryMasonry
      client:idle
      items={galleryItems}
      categories={GALLERY_CATS}
    />
  </section>

  <!-- LEAD FORM -->
  <section id="contacto" style="background:var(--color-forest-dark)">
    <div class="lead-wrap" style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;min-height:600px">

      <!-- Left: Copy -->
      <div style="padding:clamp(40px,5vw,80px) clamp(26px,4vw,64px);display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="color:#E6B87C;margin-bottom:18px">
          <span class="lang-es">Guía gratuita</span>
          <span class="lang-en" hidden>Complimentary guide</span>
        </div>
        <h2 style="font-family:'Spectral';font-weight:700;font-size:clamp(32px,4.2vw,52px);line-height:1.08;letter-spacing:-.01em;margin:0 0 20px;color:#F7F1E6">
          <span class="lang-es">Antes de planear la mudanza, ten el panorama completo.</span>
          <span class="lang-en" hidden>Before you plan the move, get the full picture.</span>
        </h2>
        <p style="font-size:16px;line-height:1.65;color:rgba(245,240,232,.72);margin:0 0 32px;max-width:440px">
          <span class="lang-es">Nuestra guía práctica para retirarse en Boquete reúne las preguntas importantes en un solo lugar, claro y accesible.</span>
          <span class="lang-en" hidden>Our practical introduction to retiring in Boquete brings the important questions into one calm, readable place.</span>
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 32px">
          {[
            { es: 'Por qué eligen Panamá', en: 'Why people choose Panama' },
            { es: 'Qué hace único a Boquete', en: 'What makes Boquete different' },
            { es: 'Costo de vida', en: 'Cost of living considerations' },
            { es: 'Comprar como extranjero', en: 'Buying as a foreigner' },
            { es: 'Residencia y trámites', en: 'Residency basics' },
            { es: 'Salud y servicios', en: 'Healthcare nearby' },
            { es: 'Preguntas clave antes de comprar', en: 'Questions before buying' },
            { es: 'Checklist para tu visita', en: 'Visit planning checklist' },
          ].map(item => (
            <div style="display:flex;align-items:baseline;gap:8px;font-size:14.5px;color:#D8CDBA;line-height:1.6">
              <span style="color:#E6B87C;font-size:13px;flex:none">+</span>
              <span>
                <span class="lang-es">{item.es}</span>
                <span class="lang-en" hidden>{item.en}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Form card -->
      <div style="padding:clamp(32px,4vw,60px) clamp(26px,4vw,56px);display:flex;align-items:center">
        <div id="lead-card" style="background:#F7F1E6;border-radius:20px;padding:clamp(28px,3.4vw,44px);width:100%;box-shadow:0 30px 60px -20px rgba(0,0,0,.25)">
          <h3 style="font-family:'Manrope';font-weight:800;font-size:clamp(22px,2.6vw,30px);color:#251D14;margin:0 0 6px">
            <span class="lang-es">Recibe la guía gratis</span>
            <span class="lang-en" hidden>Send me the free guide</span>
          </h3>
          <p style="font-size:14.5px;color:#5A4F42;margin:0 0 24px;line-height:1.5">
            <span class="lang-es">Un punto de partida útil, directo a tu correo.</span>
            <span class="lang-en" hidden>A useful starting point, delivered to your inbox.</span>
          </p>

          <form id="lead-form" style="display:flex;flex-direction:column;gap:16px">
            <!-- Nombre -->
            <div>
              <label class="lead-label">
                <span class="lang-es">Nombre completo</span><span class="lang-en" hidden>Full name</span>
              </label>
              <input name="nombre" required class="lead-input" />
            </div>

            <!-- Email + Celular -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label">
                  <span class="lang-es">Correo</span><span class="lang-en" hidden>Email</span>
                </label>
                <input name="email" type="email" required class="lead-input" />
              </div>
              <div>
                <label class="lead-label">
                  <span class="lang-es">Celular / WhatsApp</span><span class="lang-en" hidden>Phone / WhatsApp</span>
                </label>
                <input name="celular" type="tel" class="lead-input" />
              </div>
            </div>

            <!-- País + Retiro -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label">
                  <span class="lang-es">País</span><span class="lang-en" hidden>Country</span>
                </label>
                <input name="pais" class="lead-input" />
              </div>
              <div>
                <label class="lead-label">
                  <span class="lang-es">¿Planeas retirarte?</span><span class="lang-en" hidden>Planning to retire?</span>
                </label>
                <select name="retiro" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="si">Sí</option>
                  <option value="talvez">Tal vez</option>
                  <option value="investigando">Estoy investigando</option>
                </select>
                <select name="retiro" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="si">Yes</option>
                  <option value="talvez">Maybe</option>
                  <option value="investigando">I'm researching</option>
                </select>
              </div>
            </div>

            <!-- Timeline + Interés -->
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label class="lead-label">
                  <span class="lang-es">Horizonte de tiempo</span><span class="lang-en" hidden>Timeline</span>
                </label>
                <select name="timeline" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="0-6">0–6 meses</option>
                  <option value="6-12">6–12 meses</option>
                  <option value="1ano">1 año</option>
                  <option value="2anos">2+ años</option>
                </select>
                <select name="timeline" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="0-6">0–6 months</option>
                  <option value="6-12">6–12 months</option>
                  <option value="1ano">1 year</option>
                  <option value="2anos">2+ years</option>
                </select>
              </div>
              <div>
                <label class="lead-label">
                  <span class="lang-es">Interés principal</span><span class="lang-en" hidden>Main interest</span>
                </label>
                <select name="interes" required class="lead-select lang-es">
                  <option value="" disabled selected>Elige una</option>
                  <option value="retiro">Retiro</option>
                  <option value="estilo">Estilo de vida</option>
                  <option value="casa">Comprar casa</option>
                  <option value="inversiones">Inversiones</option>
                  <option value="info">Información local</option>
                </select>
                <select name="interes" required class="lead-select lang-en">
                  <option value="" disabled selected>Choose one</option>
                  <option value="retiro">Retirement</option>
                  <option value="estilo">Lifestyle</option>
                  <option value="casa">Buy a home</option>
                  <option value="inversiones">Investments</option>
                  <option value="info">Local info</option>
                </select>
              </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="lead-btn">
              <span class="lang-es">Envíame la guía →</span>
              <span class="lang-en" hidden>Send me the guide →</span>
            </button>
          </form>

          <p style="text-align:center;font-size:13px;color:#8A7D69;margin:14px 0 0">
            <span class="lang-es">Sin presión, sin spam.</span>
            <span class="lang-en" hidden>No pressure, no crowded inbox.</span>
          </p>

          <!-- Success message -->
          <div id="lead-success" style="display:none;text-align:center;padding:32px 10px">
            <div style="width:52px;height:52px;border-radius:50%;background:#2C3A2A;color:#E6B87C;display:inline-flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;margin-bottom:16px">✓</div>
            <h3 style="font-family:'Manrope';font-weight:800;font-size:24px;color:#251D14;margin:0 0 8px">
              <span class="lang-es">¡Gracias!</span>
              <span class="lang-en" hidden>Thank you!</span>
            </h3>
            <p style="font-size:15px;color:#5A4F42;margin:0">
              <span class="lang-es">Revisa tu correo — la guía va en camino.</span>
              <span class="lang-en" hidden>Check your inbox — the guide is on its way.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DETAIL MODAL DATA -->
  <script type="application/json" id="places-json" is:inline set:html={jsonSafe(PLACES)} />
  <script type="application/json" id="events-json" is:inline set:html={jsonSafe(EVENTS)} />

  <!-- DETAIL MODAL -->
  <div id="detail-backdrop" class="detail-backdrop" hidden>
    <div id="detail-modal" class="detail-modal" role="dialog" aria-modal="true">
      <button id="detail-close" class="detail-close" type="button" aria-label="Cerrar">&times;</button>
      <div class="detail-media">
        <img id="detail-img" src="" alt="" />
        <span id="detail-badge" class="detail-badge"></span>
        <div id="detail-date" class="detail-date-badge" hidden>
          <span id="detail-date-d" class="detail-date-d"></span>
          <span id="detail-date-m" class="detail-date-m"></span>
        </div>
      </div>
      <!-- data-lenis-prevent: Lenis's own wheel handler still preventDefaults
           everything while stopped (see openDetail below), so without this
           attribute the modal's internal scroll would be frozen along with
           the background. Lenis special-cases this attribute to fall back
           to native scrolling for the element, stopped or not. -->
      <div id="detail-body-content" class="detail-body-content" data-lenis-prevent>
        <h3 id="detail-title" class="detail-title"></h3>
        <p id="detail-desc" class="detail-desc"></p>
        <div id="detail-meta" class="detail-meta"></div>
        <div id="detail-tips" class="detail-tips" hidden>
          <div class="detail-tips-label">
            <span class="lang-es">Consejos</span><span class="lang-en" hidden>Tips</span>
          </div>
          <ul id="detail-tips-list"></ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    function syncLeadSelects() {
      const lang = document.documentElement.getAttribute('data-lang') || 'es';
      document.querySelectorAll<HTMLSelectElement>('#lead-form select').forEach(s => {
        const isActive = s.classList.contains(`lang-${lang}`);
        s.disabled = !isActive;
      });
    }
    syncLeadSelects();
    new MutationObserver(syncLeadSelects).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

    document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const data = Object.fromEntries(new FormData(form));
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('request failed');
        form.style.display = 'none';
        (document.querySelector('#lead-card > p:last-of-type') as HTMLElement).style.display = 'none';
        document.getElementById('lead-success')!.style.display = 'block';
      } catch {
        submitBtn.disabled = false;
        alert('No pudimos enviar tu solicitud. Intenta de nuevo. / We could not send your request. Please try again.');
      }
    });
  </script>

  <script>
    // Card -> detail modal: expands the clicked place/event card in place.
    import { gsap } from 'gsap';

    type Bilingual = { es: string; en: string };
    interface PlaceItem {
      id: string; cat: Bilingual; name: Bilingual; short: Bilingual; long: Bilingual;
      hours: Bilingual; cost: Bilingual; tips: { es: string[]; en: string[] }; img: string;
    }
    interface EventItem {
      id: string; d: string; m: Bilingual; range: Bilingual; name: Bilingual; cat: Bilingual;
      time: Bilingual; place: Bilingual; desc: Bilingual; img: string;
    }

    function readJson<T>(id: string): T[] {
      const el = document.getElementById(id);
      if (!el?.textContent) return [];
      try { return JSON.parse(el.textContent); } catch { return []; }
    }

    interface ModalState {
      backdrop: HTMLElement | null;
      modal: HTMLElement | null;
      closeBtn: HTMLElement | null;
      bodyContent: HTMLElement | null;
      placesData: PlaceItem[];
      eventsData: EventItem[];
      originEl: HTMLElement | null;
      isOpen: boolean;
      bound: boolean;
    }

    // ClientRouter (astro:transitions) keeps a single `document` alive across
    // navigations — only the page content is swapped. This script re-runs on
    // every navigation back to the homepage, so element refs/data must be
    // refreshed each time, but the document-level listeners must be bound only
    // once (a `state` object persisted on `window`), otherwise navigating away
    // and back stacks duplicate handlers and the modal glitches.
    const win = window as unknown as {
      __cardModal?: ModalState;
      __lenis?: { stop: () => void; start: () => void };
    };
    const state: ModalState = win.__cardModal ?? {
      backdrop: null, modal: null, closeBtn: null, bodyContent: null,
      placesData: [], eventsData: [], originEl: null, isOpen: false, bound: false,
    };
    win.__cardModal = state;

    // Astro skips re-running an inline script whose content already ran once,
    // so this whole block only executes on the very first page load. Refs
    // captured here would go stale after a client-side navigation swaps the
    // DOM. `astro:page-load` fires on first load AND every navigation, so
    // refreshing refs there keeps them pointed at whatever's on screen.
    function refreshRefs() {
      state.backdrop = document.getElementById('detail-backdrop') as HTMLElement | null;
      state.modal = document.getElementById('detail-modal') as HTMLElement | null;
      state.closeBtn = document.getElementById('detail-close') as HTMLElement | null;
      state.bodyContent = document.getElementById('detail-body-content') as HTMLElement | null;
      state.placesData = readJson<PlaceItem>('places-json');
      state.eventsData = readJson<EventItem>('events-json');
      state.originEl = null;
      state.isOpen = false;
    }
    refreshRefs();
    document.addEventListener('astro:page-load', refreshRefs);

    if (state.backdrop && state.modal && state.closeBtn && state.bodyContent) {
      const esc = (str: string) => {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      };
      const biSpan = (es: string, en: string) =>
        `<span class="lang-es">${esc(es)}</span><span class="lang-en" hidden>${esc(en)}</span>`;
      const metaRow = (labelEs: string, labelEn: string, valueEs: string, valueEn: string) =>
        `<div class="detail-meta-row"><span class="detail-meta-label">${biSpan(labelEs, labelEn)}</span><span class="detail-meta-value">${biSpan(valueEs, valueEn)}</span></div>`;

      function populateModal(item: PlaceItem | EventItem, type: 'place' | 'event') {
        const img = document.getElementById('detail-img') as HTMLImageElement;
        img.src = item.img;
        img.alt = item.name.es;

        const badgeEl = document.getElementById('detail-badge') as HTMLElement;
        const dateEl = document.getElementById('detail-date') as HTMLElement;
        if (type === 'event') {
          const ev = item as EventItem;
          badgeEl.hidden = true;
          dateEl.hidden = false;
          document.getElementById('detail-date-d')!.textContent = ev.d;
          document.getElementById('detail-date-m')!.innerHTML = biSpan(ev.m.es, ev.m.en);
        } else {
          badgeEl.hidden = false;
          badgeEl.innerHTML = biSpan(item.cat.es, item.cat.en);
          dateEl.hidden = true;
        }

        document.getElementById('detail-title')!.innerHTML = biSpan(item.name.es, item.name.en);

        const descSrc = type === 'place' ? (item as PlaceItem).long : (item as EventItem).desc;
        document.getElementById('detail-desc')!.innerHTML = biSpan(descSrc.es, descSrc.en);

        const meta = document.getElementById('detail-meta')!;
        if (type === 'place') {
          const p = item as PlaceItem;
          meta.innerHTML =
            metaRow('Horario', 'Hours', p.hours.es, p.hours.en) +
            metaRow('Costo', 'Cost', p.cost.es, p.cost.en);
        } else {
          const e = item as EventItem;
          meta.innerHTML =
            metaRow('Categoría', 'Category', e.cat.es, e.cat.en) +
            metaRow('Fecha', 'Date', e.range.es, e.range.en) +
            metaRow('Horario', 'Time', e.time.es, e.time.en) +
            metaRow('Lugar', 'Place', e.place.es, e.place.en);
        }

        const tipsWrap = document.getElementById('detail-tips') as HTMLElement;
        const tipsList = document.getElementById('detail-tips-list')!;
        if (type === 'place' && (item as PlaceItem).tips) {
          const tips = (item as PlaceItem).tips;
          tipsWrap.hidden = false;
          tipsList.innerHTML = tips.es.map((t, i) => `<li>${biSpan(t, tips.en[i] ?? t)}</li>`).join('');
        } else {
          tipsWrap.hidden = true;
          tipsList.innerHTML = '';
        }
      }

      function openDetail(source: HTMLElement, item: PlaceItem | EventItem, type: 'place' | 'event') {
        if (state.isOpen) return;
        const { backdrop, modal, bodyContent, closeBtn } = state;
        if (!backdrop || !modal || !bodyContent || !closeBtn) return;

        state.isOpen = true;
        state.originEl = source;
        populateModal(item, type);

        const rect = source.getBoundingClientRect();
        document.body.style.overflow = 'hidden';
        // Lenis (see Layout.astro) drives scroll itself and ignores the
        // native overflow lock above, so the background page kept scrolling
        // under the modal — it has to be paused explicitly.
        win.__lenis?.stop();
        backdrop.hidden = false;

        gsap.set(modal, {
          position: 'fixed', top: rect.top, left: rect.left,
          width: rect.width, height: rect.height, borderRadius: 14, opacity: 1,
        });
        gsap.set(backdrop, { opacity: 0 });
        gsap.set(bodyContent, { opacity: 0, y: 12 });

        const vw = window.innerWidth, vh = window.innerHeight;
        const targetW = Math.min(vw * 0.92, 760);
        const targetH = Math.min(vh * 0.86, 640);
        const targetTop = (vh - targetH) / 2;
        const targetLeft = (vw - targetW) / 2;

        const tl = gsap.timeline();
        tl.to(backdrop, { opacity: 1, duration: 0.25, ease: 'power2.out' }, 0)
          .to(modal, { top: targetTop, left: targetLeft, width: targetW, height: targetH, borderRadius: 22, duration: 0.55, ease: 'power3.inOut' }, 0)
          .to(bodyContent, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }, 0.28);

        closeBtn.focus();
      }

      function closeDetail() {
        if (!state.isOpen) return;
        const { backdrop, modal, bodyContent } = state;
        if (!backdrop || !modal || !bodyContent) return;

        const source = state.originEl;
        const rect = source ? source.getBoundingClientRect() : null;

        const tl = gsap.timeline({
          onComplete: () => {
            backdrop.hidden = true;
            document.body.style.overflow = '';
            win.__lenis?.start();
            state.isOpen = false;
            source?.focus();
            state.originEl = null;
          },
        });
        tl.to(bodyContent, { opacity: 0, y: 8, duration: 0.15 }, 0);
        if (rect) {
          tl.to(modal, { top: rect.top, left: rect.left, width: rect.width, height: rect.height, borderRadius: 14, duration: 0.45, ease: 'power3.inOut' }, 0.05);
        } else {
          tl.to(modal, { opacity: 0, scale: 0.92, duration: 0.3 }, 0.05);
        }
        tl.to(backdrop, { opacity: 0, duration: 0.3 }, 0.2);
      }

      if (!state.bound) {
        state.bound = true;

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;

          const placeCard = target.closest<HTMLElement>('[data-place-id]');
          if (placeCard) {
            const item = state.placesData.find(p => p.id === placeCard.dataset.placeId);
            if (item) openDetail(placeCard, item, 'place');
            return;
          }
          const eventCard = target.closest<HTMLElement>('[data-event-id]');
          if (eventCard) {
            const item = state.eventsData.find(ev => ev.id === eventCard.dataset.eventId);
            if (item) openDetail(eventCard, item, 'event');
            return;
          }
          if (target === state.backdrop || target === state.closeBtn || target.closest('#detail-close')) {
            closeDetail();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && state.isOpen) {
            closeDetail();
            return;
          }
          if (e.key === 'Enter' || e.key === ' ') {
            const card = (e.target as HTMLElement).closest<HTMLElement>('[data-place-id], [data-event-id]');
            if (card) {
              e.preventDefault();
              card.click();
            }
          }
        });
      }
    }
  </script>

  <!-- Slogan (also gives #contacto room to scroll to center of viewport) -->
  <section style="min-height:50dvh;background:var(--color-forest-dark);display:flex;align-items:center;justify-content:center;padding:60px 26px">
    <p style="font-family:'Spectral';font-style:italic;font-weight:500;font-size:clamp(24px,3.4vw,38px);line-height:1.45;color:#F7F1E6;text-align:center;max-width:760px;margin:0">
      <span class="lang-es">El refugio perfecto donde el alma encuentra la paz.</span>
      <span class="lang-en" hidden>The perfect refuge where the soul finds peace.</span>
    </p>
  </section>

</Layout>

