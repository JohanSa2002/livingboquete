  <script>
    function syncLeadSelects() {
      const lang = document.documentElement.getAttribute('data-lang') || 'es';
      document.querySelectorAll<HTMLSelectElement>('#lead-form select').forEach(s => {
        const isActive = s.classList.contains(`lang-${lang}`);
        s.disabled = !isActive;
      });
    }
    syncLeadSelects();
    new MutationObserver(syncLeadSelects).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

    document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const data = Object.fromEntries(new FormData(form));
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('request failed');
        form.style.display = 'none';
        (document.querySelector('#lead-card > p:last-of-type') as HTMLElement).style.display = 'none';
        document.getElementById('lead-success')!.style.display = 'block';
      } catch {
        submitBtn.disabled = false;
        alert('No pudimos enviar tu solicitud. Intenta de nuevo. / We could not send your request. Please try again.');
      }
    });
  </script>

  <script>
    // Card -> detail modal: expands the clicked place/event card in place.
    import { gsap } from 'gsap';

    type Bilingual = { es: string; en: string };
    interface PlaceItem {
      id: string; cat: Bilingual; name: Bilingual; short: Bilingual; long: Bilingual;
      hours: Bilingual; cost: Bilingual; tips: { es: string[]; en: string[] }; img: string;
    }
    interface EventItem {
      id: string; d: string; m: Bilingual; range: Bilingual; name: Bilingual; cat: Bilingual;
      time: Bilingual; place: Bilingual; desc: Bilingual; img: string;
    }

    function readJson<T>(id: string): T[] {
      const el = document.getElementById(id);
      if (!el?.textContent) return [];
      try { return JSON.parse(el.textContent); } catch { return []; }
    }

    interface ModalState {
      backdrop: HTMLElement | null;
      modal: HTMLElement | null;
      closeBtn: HTMLElement | null;
      bodyContent: HTMLElement | null;
      placesData: PlaceItem[];
      eventsData: EventItem[];
      originEl: HTMLElement | null;
      isOpen: boolean;
      bound: boolean;
    }

    // ClientRouter (astro:transitions) keeps a single `document` alive across
    // navigations — only the page content is swapped. This script re-runs on
    // every navigation back to the homepage, so element refs/data must be
    // refreshed each time, but the document-level listeners must be bound only
    // once (a `state` object persisted on `window`), otherwise navigating away
    // and back stacks duplicate handlers and the modal glitches.
    const win = window as unknown as {
      __cardModal?: ModalState;
      __lenis?: { stop: () => void; start: () => void };
    };
    const state: ModalState = win.__cardModal ?? {
      backdrop: null, modal: null, closeBtn: null, bodyContent: null,
      placesData: [], eventsData: [], originEl: null, isOpen: false, bound: false,
    };
    win.__cardModal = state;

    // Astro skips re-running an inline script whose content already ran once,
    // so this whole block only executes on the very first page load. Refs
    // captured here would go stale after a client-side navigation swaps the
    // DOM. `astro:page-load` fires on first load AND every navigation, so
    // refreshing refs there keeps them pointed at whatever's on screen.
    function refreshRefs() {
      state.backdrop = document.getElementById('detail-backdrop') as HTMLElement | null;
      state.modal = document.getElementById('detail-modal') as HTMLElement | null;
      state.closeBtn = document.getElementById('detail-close') as HTMLElement | null;
      state.bodyContent = document.getElementById('detail-body-content') as HTMLElement | null;
      state.placesData = readJson<PlaceItem>('places-json');
      state.eventsData = readJson<EventItem>('events-json');
      state.originEl = null;
      state.isOpen = false;
    }
    refreshRefs();
    document.addEventListener('astro:page-load', refreshRefs);

    if (state.backdrop && state.modal && state.closeBtn && state.bodyContent) {
      const esc = (str: string) => {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      };
      const biSpan = (es: string, en: string) =>
        `<span class="lang-es">${esc(es)}</span><span class="lang-en" hidden>${esc(en)}</span>`;
      const metaRow = (labelEs: string, labelEn: string, valueEs: string, valueEn: string) =>
        `<div class="detail-meta-row"><span class="detail-meta-label">${biSpan(labelEs, labelEn)}</span><span class="detail-meta-value">${biSpan(valueEs, valueEn)}</span></div>`;

      function populateModal(item: PlaceItem | EventItem, type: 'place' | 'event') {
        const img = document.getElementById('detail-img') as HTMLImageElement;
        img.src = item.img;
        img.alt = item.name.es;

        const badgeEl = document.getElementById('detail-badge') as HTMLElement;
        const dateEl = document.getElementById('detail-date') as HTMLElement;
        if (type === 'event') {
          const ev = item as EventItem;
          badgeEl.hidden = true;
          dateEl.hidden = false;
          document.getElementById('detail-date-d')!.textContent = ev.d;
          document.getElementById('detail-date-m')!.innerHTML = biSpan(ev.m.es, ev.m.en);
        } else {
          badgeEl.hidden = false;
          badgeEl.innerHTML = biSpan(item.cat.es, item.cat.en);
          dateEl.hidden = true;
        }

        document.getElementById('detail-title')!.innerHTML = biSpan(item.name.es, item.name.en);

        const descSrc = type === 'place' ? (item as PlaceItem).long : (item as EventItem).desc;
        document.getElementById('detail-desc')!.innerHTML = biSpan(descSrc.es, descSrc.en);

        const meta = document.getElementById('detail-meta')!;
        if (type === 'place') {
          const p = item as PlaceItem;
          meta.innerHTML =
            metaRow('Horario', 'Hours', p.hours.es, p.hours.en) +
            metaRow('Costo', 'Cost', p.cost.es, p.cost.en);
        } else {
          const e = item as EventItem;
          meta.innerHTML =
            metaRow('Categoría', 'Category', e.cat.es, e.cat.en) +
            metaRow('Fecha', 'Date', e.range.es, e.range.en) +
            metaRow('Horario', 'Time', e.time.es, e.time.en) +
            metaRow('Lugar', 'Place', e.place.es, e.place.en);
        }

        const tipsWrap = document.getElementById('detail-tips') as HTMLElement;
        const tipsList = document.getElementById('detail-tips-list')!;
        if (type === 'place' && (item as PlaceItem).tips) {
          const tips = (item as PlaceItem).tips;
          tipsWrap.hidden = false;
          tipsList.innerHTML = tips.es.map((t, i) => `<li>${biSpan(t, tips.en[i] ?? t)}</li>`).join('');
        } else {
          tipsWrap.hidden = true;
          tipsList.innerHTML = '';
        }
      }

      function openDetail(source: HTMLElement, item: PlaceItem | EventItem, type: 'place' | 'event') {
        if (state.isOpen) return;
        const { backdrop, modal, bodyContent, closeBtn } = state;
        if (!backdrop || !modal || !bodyContent || !closeBtn) return;

        state.isOpen = true;
        state.originEl = source;
        populateModal(item, type);

        const rect = source.getBoundingClientRect();
        document.body.style.overflow = 'hidden';
        // Lenis (see Layout.astro) drives scroll itself and ignores the
        // native overflow lock above, so the background page kept scrolling
        // under the modal — it has to be paused explicitly.
        win.__lenis?.stop();
        backdrop.hidden = false;

        gsap.set(modal, {
          position: 'fixed', top: rect.top, left: rect.left,
          width: rect.width, height: rect.height, borderRadius: 14, opacity: 1,
        });
        gsap.set(backdrop, { opacity: 0 });
        gsap.set(bodyContent, { opacity: 0, y: 12 });

        const vw = window.innerWidth, vh = window.innerHeight;
        const targetW = Math.min(vw * 0.92, 760);
        const targetH = Math.min(vh * 0.86, 640);
        const targetTop = (vh - targetH) / 2;
        const targetLeft = (vw - targetW) / 2;

        const tl = gsap.timeline();
        tl.to(backdrop, { opacity: 1, duration: 0.25, ease: 'power2.out' }, 0)
          .to(modal, { top: targetTop, left: targetLeft, width: targetW, height: targetH, borderRadius: 22, duration: 0.55, ease: 'power3.inOut' }, 0)
          .to(bodyContent, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }, 0.28);

        closeBtn.focus();
      }

      function closeDetail() {
        if (!state.isOpen) return;
        const { backdrop, modal, bodyContent } = state;
        if (!backdrop || !modal || !bodyContent) return;

        const source = state.originEl;
        const rect = source ? source.getBoundingClientRect() : null;

        const tl = gsap.timeline({
          onComplete: () => {
            backdrop.hidden = true;
            document.body.style.overflow = '';
            win.__lenis?.start();
            state.isOpen = false;
            source?.focus();
            state.originEl = null;
          },
        });
        tl.to(bodyContent, { opacity: 0, y: 8, duration: 0.15 }, 0);
        if (rect) {
          tl.to(modal, { top: rect.top, left: rect.left, width: rect.width, height: rect.height, borderRadius: 14, duration: 0.45, ease: 'power3.inOut' }, 0.05);
        } else {
          tl.to(modal, { opacity: 0, scale: 0.92, duration: 0.3 }, 0.05);
        }
        tl.to(backdrop, { opacity: 0, duration: 0.3 }, 0.2);
      }

      if (!state.bound) {
        state.bound = true;

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;

          const placeCard = target.closest<HTMLElement>('[data-place-id]');
          if (placeCard) {
            const item = state.placesData.find(p => p.id === placeCard.dataset.placeId);
            if (item) openDetail(placeCard, item, 'place');
            return;
          }
          const eventCard = target.closest<HTMLElement>('[data-event-id]');
          if (eventCard) {
            const item = state.eventsData.find(ev => ev.id === eventCard.dataset.eventId);
            if (item) openDetail(eventCard, item, 'event');
            return;
          }
          if (target === state.backdrop || target === state.closeBtn || target.closest('#detail-close')) {
            closeDetail();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && state.isOpen) {
            closeDetail();
            return;
          }
          if (e.key === 'Enter' || e.key === ' ') {
            const card = (e.target as HTMLElement).closest<HTMLElement>('[data-place-id], [data-event-id]');
            if (card) {
              e.preventDefault();
              card.click();
            }
          }
        });
      }
    }
  </script>

  <!-- ATTRACTIONS MARQUEE CAROUSEL -->
  <script>
    // Continuous, drag/swipe-able "living gallery" marquee. Track holds the
    // real cards followed by an identical clone set; position wraps with a
    // simple modulo so the loop never jumps (the clone always lines up
    // exactly where the real set ends).
    interface Ctx {
      root: HTMLElement;
      viewport: HTMLElement;
      track: HTMLElement;
      allCards: HTMLElement[];
      realCards: HTMLElement[];
      realCount: number;
      dots: HTMLButtonElement[];
      progressBar: HTMLElement | null;
      playBtn: HTMLButtonElement | null;
      playIcon: HTMLElement | null;
      x: number;
      setWidth: number;
      step: number;
      cardWidth: number;
      speedPxPerSec: number;
      speedFactor: number;
      targetFactor: number;
      userPaused: boolean;
      dragging: boolean;
      dragMoved: number;
      dragStartClientX: number;
      dragStartX: number;
      activeIndex: number;
      reduceMotion: boolean;
      resumeTimer: number | null;
    }

    const win = window as unknown as {
      __attractionsMarquee?: { rafId: number | null; ctx: Ctx | null; resizeBound: boolean };
    };
    const state = win.__attractionsMarquee ?? { rafId: null, ctx: null, resizeBound: false };
    win.__attractionsMarquee = state;

    function wrapX(ctx: Ctx) {
      if (ctx.setWidth <= 0) return;
      while (ctx.x <= -ctx.setWidth) ctx.x += ctx.setWidth;
      while (ctx.x > 0) ctx.x -= ctx.setWidth;
    }

    function applyTransform(ctx: Ctx) {
      ctx.track.style.transform = `translate3d(${ctx.x}px,0,0)`;
    }

    function measure(ctx: Ctx) {
      const first = ctx.allCards[0];
      const second = ctx.allCards[1];
      if (!first || !second) return;
      ctx.step = second.offsetLeft - first.offsetLeft;
      ctx.cardWidth = first.offsetWidth;
      ctx.setWidth = ctx.step * ctx.realCount;
      const durationSec = window.innerWidth < 768 ? 55 : 40;
      ctx.speedPxPerSec = ctx.step > 0 ? ctx.setWidth / durationSec : 0;
    }

    function pauseAuto(ctx: Ctx) { ctx.targetFactor = 0; }
    function resumeAuto(ctx: Ctx) {
      if (!ctx.userPaused && !ctx.dragging) ctx.targetFactor = ctx.reduceMotion ? 0 : 1;
    }

    function scheduleResume(ctx: Ctx) {
      if (ctx.resumeTimer != null) window.clearTimeout(ctx.resumeTimer);
      ctx.resumeTimer = window.setTimeout(() => {
        ctx.resumeTimer = null;
        resumeAuto(ctx);
      }, 1500);
    }

    // Jump the track so real-card `index` sits at the front of the current
    // cycle — used by dot clicks and keyboard nav (never resets progress to 0).
    function jumpToIndex(ctx: Ctx, index: number) {
      if (ctx.setWidth <= 0) return;
      const traveled = (((-ctx.x) % ctx.setWidth) + ctx.setWidth) % ctx.setWidth;
      const cycleBase = -ctx.x - traveled;
      ctx.x = -(cycleBase + index * ctx.step);
      wrapX(ctx);
      applyTransform(ctx);
    }

    function updateIndicators(ctx: Ctx) {
      if (ctx.setWidth > 0) {
        const traveled = (((-ctx.x) % ctx.setWidth) + ctx.setWidth) % ctx.setWidth;

        // "Predominant" card = whichever one currently sits nearest the
        // horizontal center of the viewport (not just the leading edge).
        const viewportCenter = traveled + ctx.viewport.clientWidth / 2;
        const centeredTraveled = ((viewportCenter % ctx.setWidth) + ctx.setWidth) % ctx.setWidth;
        const idx = Math.round((centeredTraveled - ctx.cardWidth / 2) / ctx.step + ctx.realCount) % ctx.realCount;

        if (idx !== ctx.activeIndex) {
          ctx.activeIndex = idx;
          ctx.allCards.forEach(c => {
            c.classList.toggle('is-active', Number(c.dataset.realIndex) === idx);
          });
          ctx.dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        }
        if (ctx.progressBar) ctx.progressBar.style.width = `${(traveled / ctx.setWidth) * 100}%`;
      }
      const playing = ctx.targetFactor > 0 && !ctx.userPaused && !ctx.dragging;
      if (ctx.playIcon) ctx.playIcon.textContent = playing ? '▶' : '⏸';
      if (ctx.playBtn) ctx.playBtn.setAttribute('aria-pressed', String(!playing));
    }

    function tick(now: number, lastTime: number): number {
      const ctx = state.ctx;
      if (!ctx) return now;
      const dt = Math.min(now - lastTime, 50);

      if (!ctx.dragging) {
        const rate = 1 - Math.exp(-dt / 90);
        ctx.speedFactor += (ctx.targetFactor - ctx.speedFactor) * rate;
        if (Math.abs(ctx.speedFactor) < 0.001) ctx.speedFactor = 0;

        if (ctx.speedFactor > 0) {
          ctx.x -= ctx.speedPxPerSec * ctx.speedFactor * (dt / 1000);
          wrapX(ctx);
          applyTransform(ctx);
        }
      }

      updateIndicators(ctx);
      return now;
    }

    function startLoop() {
      if (state.rafId != null) cancelAnimationFrame(state.rafId);
      let lastTime = performance.now();
      const frame = (now: number) => {
        lastTime = tick(now, lastTime);
        state.rafId = requestAnimationFrame(frame);
      };
      state.rafId = requestAnimationFrame(frame);
    }

    function initAttractionsCarousel() {
      const root = document.getElementById('attractions-carousel');
      const viewport = document.getElementById('attractions-viewport');
      const track = document.getElementById('attractions-track');
      const playBtn = document.getElementById('attractions-playstate') as HTMLButtonElement | null;
      const playIcon = document.getElementById('attractions-play-icon');
      if (!root || !viewport || !track) {
        if (state.rafId != null) { cancelAnimationFrame(state.rafId); state.rafId = null; }
        state.ctx = null;
        return;
      }

      const allCards = Array.from(track.querySelectorAll<HTMLElement>('.attractions-card'));
      const realCards = allCards.filter(c => c.dataset.clone !== 'true');
      const realCount = realCards.length;
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#attractions-dots .attractions-dot'));
      const progressBar = document.getElementById('attractions-progress-bar');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (realCount === 0) return;

      const ctx: Ctx = {
        root, viewport, track, allCards, realCards, realCount, dots, progressBar,
        playBtn, playIcon,
        x: 0, setWidth: 0, step: 0, cardWidth: 0, speedPxPerSec: 0,
        speedFactor: reduceMotion ? 0 : 1, targetFactor: reduceMotion ? 0 : 1,
        userPaused: false, dragging: false, dragMoved: 0, dragStartClientX: 0, dragStartX: 0,
        activeIndex: -1, reduceMotion, resumeTimer: null,
      };
      state.ctx = ctx;
      measure(ctx);
      startLoop();

      root.addEventListener('mouseenter', () => pauseAuto(ctx));
      root.addEventListener('mouseleave', () => { if (!ctx.dragging) resumeAuto(ctx); });

      root.addEventListener('focusin', () => pauseAuto(ctx));
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget as Node)) resumeAuto(ctx);
      });

      playBtn?.addEventListener('click', () => {
        ctx.userPaused = !ctx.userPaused;
        ctx.targetFactor = ctx.userPaused ? 0 : (ctx.reduceMotion ? 0 : 1);
      });

      viewport.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        ctx.dragging = true;
        ctx.dragMoved = 0;
        ctx.dragStartClientX = e.clientX;
        ctx.dragStartX = ctx.x;
        ctx.targetFactor = 0;
        track.classList.add('is-dragging');
        if (ctx.resumeTimer != null) { window.clearTimeout(ctx.resumeTimer); ctx.resumeTimer = null; }
        viewport.setPointerCapture(e.pointerId);
      });

      viewport.addEventListener('pointermove', (e: PointerEvent) => {
        if (!ctx.dragging) return;
        const delta = e.clientX - ctx.dragStartClientX;
        ctx.dragMoved = Math.max(ctx.dragMoved, Math.abs(delta));
        ctx.x = ctx.dragStartX + delta;
        wrapX(ctx);
        applyTransform(ctx);
      });

      function endDrag() {
        if (!ctx.dragging) return;
        ctx.dragging = false;
        track.classList.remove('is-dragging');
        if (ctx.dragMoved > 6) root.dataset.justDragged = 'true';
        scheduleResume(ctx);
      }
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      // Swallow the click that follows a real drag before it reaches the
      // document-level modal-open listener (capture phase runs first).
      root.addEventListener('click', (e) => {
        if (root.dataset.justDragged === 'true') {
          delete root.dataset.justDragged;
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          jumpToIndex(ctx, i);
          ctx.userPaused = false;
          pauseAuto(ctx);
          scheduleResume(ctx);
        });
      });

      root.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const activeEl = document.activeElement as HTMLElement | null;
        const currentCard = activeEl?.closest<HTMLElement>('.attractions-card[tabindex="0"]');
        if (!currentCard) return;
        e.preventDefault();
        const idx = Number(currentCard.dataset.realIndex);
        const nextIdx = e.key === 'ArrowRight' ? (idx + 1) % ctx.realCount : (idx - 1 + ctx.realCount) % ctx.realCount;
        ctx.realCards[nextIdx]?.focus();
        jumpToIndex(ctx, nextIdx);
        pauseAuto(ctx);
        scheduleResume(ctx);
      });
    }

    // A single resize listener for the whole page lifetime — it always reads
    // `state.ctx`, which initAttractionsCarousel() swaps out on every
    // navigation, so it never holds on to a stale/detached track.
    if (!state.resizeBound) {
      state.resizeBound = true;
      let resizeRaf: number | null = null;
      window.addEventListener('resize', () => {
        if (resizeRaf != null) return;
        resizeRaf = requestAnimationFrame(() => {
          resizeRaf = null;
          const ctx = state.ctx;
          if (!ctx) return;
          const ratio = ctx.setWidth > 0 ? ctx.x / ctx.setWidth : 0;
          measure(ctx);
          ctx.x = ratio * ctx.setWidth;
          wrapX(ctx);
          applyTransform(ctx);
        });
      });
    }

    initAttractionsCarousel();
    document.addEventListener('astro:page-load', initAttractionsCarousel);
  </script>

