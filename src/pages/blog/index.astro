---
import Layout from '../../layouts/Layout.astro';
import { getSupabase } from '../../lib/supabase';
import { Image } from 'astro:assets';

const { data: postRows } = await getSupabase()
  .from('posts')
  .select('data')
  .order('created_at', { ascending: true });
const POSTS = (postRows ?? []).map((r: any) => r.data);
---

<Layout activeKey="blog" title="Blog · MIKA Homes" titleEn="Blog · MIKA Homes">

  <div class="blog-hero">
    <div class="blog-hero-bg" aria-hidden="true"></div>
    <!-- Wash spans the whole hero+cards wrapper (not just the intro), stronger
         behind the text for legibility and lighter over the cards so the
         illustration keeps reading through the grid gaps as content scrolls
         over it. -->
    <div class="blog-hero-wash" aria-hidden="true"></div>

    <section class="pad-sec blog-hero-section" style="max-width:1240px;margin:0 auto;padding:70px 26px 0">
      <div data-reveal="title" style="font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#B95C36;margin-bottom:14px">
        <span class="lang-es">Blog &amp; noticias</span><span class="lang-en" hidden>Blog &amp; news</span>
      </div>
      <h1 style="font-family:'Manrope';font-weight:800;font-size:clamp(40px,6vw,72px);line-height:.98;letter-spacing:-.025em;margin:0 0 14px;color:#251D14">
        <span class="lang-es">Historias de las tierras altas</span>
        <span class="lang-en" hidden>Stories from the highlands</span>
      </h1>
      <p style="font-size:18px;color:#5A4F42;max-width:540px;margin:0 0 46px">
        <span class="lang-es">Guías, cultura y novedades de la comunidad.</span>
        <span class="lang-en" hidden>Guides, culture and community news.</span>
      </p>
    </section>

    <section class="pad-sec blog-hero-section" style="max-width:1240px;margin:0 auto;padding:0 26px 96px">
      <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:26px">
        {POSTS.map(b => (
          <a href={`/blog/${b.id}`} class="blog-card" style="cursor:pointer;background:#fff;border:1px solid rgba(37,29,20,.09);border-radius:18px;overflow:hidden;text-decoration:none;color:inherit;display:block">
            <div style="position:relative;aspect-ratio:3/2;overflow:hidden">
              <Image src={b.img} width={420} height={280} densities={[1, 2]} alt={b.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
            </div>
            <div style="padding:20px 22px 24px">
              <div style="display:flex;gap:10px;align-items:center;font-size:12px;color:#8A7D69;margin-bottom:10px">
                <span style="color:#B95C36;font-weight:700">
                  <span class="lang-es">{b.cat.es}</span><span class="lang-en" hidden>{b.cat.en}</span>
                </span>
                <span>·</span>
                <span><span class="lang-es">{b.date.es}</span><span class="lang-en" hidden>{b.date.en}</span></span>
              </div>
              <h3 style="font-family:'Manrope';font-weight:700;font-size:19.5px;line-height:1.2;margin:0 0 9px;color:#251D14">
                <span class="lang-es">{b.title.es}</span><span class="lang-en" hidden>{b.title.en}</span>
              </h3>
              <p style="font-size:14px;line-height:1.55;color:#5A4F42;margin:0 0 14px">
                <span class="lang-es">{b.excerpt.es}</span><span class="lang-en" hidden>{b.excerpt.en}</span>
              </p>
              <span style="color:#B95C36;font-weight:700;font-size:13.5px">
                <span class="lang-es">Leer más</span><span class="lang-en" hidden>Read more</span> →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

</Layout>

<style>
  .blog-card { transition: transform .25s, box-shadow .25s; }
  .blog-card:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -22px rgba(37,29,20,.4); }

  /* Wraps the intro + card grid so one illustration sits fixed behind both —
     the section boundary is where it's naturally clipped away (no JS needed
     on desktop: background-attachment:fixed is bounded by this element's own
     box). isolation:isolate keeps the internal z-index stack (bg/wash/content)
     self-contained regardless of the fixed positioning used on mobile below. */
  .blog-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .blog-hero-section { position: relative; z-index: 2; }
  .blog-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/fondoblogs.webp');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    pointer-events: none;
  }
  .blog-hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Strong right at the top, where the eyebrow/h1/subtitle sit directly on
       the illustration with no card behind them — the old .15 start let the
       tree/mountain linework cut straight through the bold title. Eases off
       once the card grid begins, since those are opaque and don't need it. */
    background: linear-gradient(180deg,
      rgba(245, 240, 232, .84) 0%,
      rgba(245, 240, 232, .8) 14%,
      rgba(245, 240, 232, .56) 26%,
      rgba(245, 240, 232, .4) 40%,
      rgba(245, 240, 232, .4) 100%
    );
  }

  @media (max-width: 880px) {
    /* iOS Safari mostly ignores background-attachment:fixed, and it's a known
       jank source on Android — fall back to a real position:fixed layer
       anchored to the viewport instead of this element's box. A fixed layer
       covers the full viewport regardless of how little of .blog-hero
       remains on screen, so `height` is driven from script to track
       .blog-hero's own bottom edge every scroll frame (`bottom` is dropped
       here since an explicit height overrides it) — the fixed layer is
       clipped to look exactly like it's still bound to that element's box,
       which is what background-attachment:fixed gives natively on desktop.
       An opacity fade (see the old approach used for .rental-bg-canvas on
       the alquiler pages) can't work here: .blog-hero is barely taller than
       one screen, so there's a stretch of scroll where the card grid and
       the footer are both partially on screen at once, and a single
       opacity value can't be simultaneously "shown" for one and "hidden"
       for the other — only a hard clip can. */
    .blog-hero-bg {
      position: fixed;
      top: 0;
      bottom: auto;
      background-attachment: scroll;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-hero-bg { background-attachment: scroll; }
  }
</style>

<script>
  // Only matters on the mobile fallback (position:fixed background, see CSS
  // above) — on desktop the illustration is clipped natively via
  // background-attachment:fixed on .blog-hero's own box, no JS involved.
  // A fixed layer covers the full viewport no matter how little of
  // .blog-hero remains on screen. .blog-hero is barely taller than one
  // screen, so there's a stretch of scroll where the card grid and the
  // footer are both partially visible at once — an opacity fade (the
  // approach used for .rental-bg-canvas on the alquiler pages) can't
  // handle that: a single opacity can't be "shown" over the still-visible
  // cards and "hidden" over the footer in the same frame. Setting `height`
  // instead clips the fixed layer's bottom edge to .blog-hero's own bottom
  // edge every frame, which is exactly what background-attachment:fixed
  // gives for free on desktop.
  function updateBlogHeroBgVisibility() {
    const heroWrap = document.querySelector<HTMLElement>('.blog-hero');
    const heroBg = document.querySelector<HTMLElement>('.blog-hero-bg');
    if (!heroWrap || !heroBg) return;
    const visibleHeight = Math.max(0, heroWrap.getBoundingClientRect().bottom);
    heroBg.style.height = `${visibleHeight}px`;
  }

  window.addEventListener('scroll', updateBlogHeroBgVisibility, { passive: true });
  window.addEventListener('resize', updateBlogHeroBgVisibility);
  document.addEventListener('DOMContentLoaded', updateBlogHeroBgVisibility);
  document.addEventListener('astro:page-load', updateBlogHeroBgVisibility);
</script>
