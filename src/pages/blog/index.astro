---
import Layout from '../../layouts/Layout.astro';
import { getSupabase, cachedQuery } from '../../lib/supabase';
import { Image } from 'astro:assets';

const POSTS = await cachedQuery('posts', async () => {
  const { data } = await getSupabase()
    .from('posts')
    .select('data')
    .order('created_at', { ascending: true });
  return (data ?? []).map((r: any) => r.data);
});
---

<Layout activeKey="blog" title="Blog · MIKA Homes" titleEn="Blog · MIKA Homes">

  <div class="blog-hero">
    <div class="blog-hero-bg" aria-hidden="true"></div>
    <!-- Wash spans the whole hero+cards wrapper (not just the intro), stronger
         behind the text for legibility and lighter over the cards so the
         illustration keeps reading through the grid gaps as content scrolls
         over it. -->
    <div class="blog-hero-wash" aria-hidden="true"></div>

    <section class="pad-sec blog-hero-section" style="max-width:1240px;margin:0 auto;padding:70px 26px 0">
      <div data-reveal="title" style="font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#B95C36;margin-bottom:14px">
        <span class="lang-es">Blog &amp; noticias</span><span class="lang-en" hidden>Blog &amp; news</span>
      </div>
      <h1 style="font-family:'Manrope';font-weight:800;font-size:clamp(40px,6vw,72px);line-height:.98;letter-spacing:-.025em;margin:0 0 14px;color:#251D14">
        <span class="lang-es">Historias de las tierras altas</span>
        <span class="lang-en" hidden>Stories from the highlands</span>
      </h1>
      <p style="font-size:18px;color:#5A4F42;max-width:540px;margin:0 0 46px">
        <span class="lang-es">Guías, cultura y novedades de la comunidad.</span>
        <span class="lang-en" hidden>Guides, culture and community news.</span>
      </p>
    </section>

    <section class="pad-sec blog-hero-section" style="max-width:1240px;margin:0 auto;padding:0 26px 96px">
      <div class="cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:34px">
        {POSTS.map(b => (
          <a href={`/blog/${b.id}`} class="blog-card" style="cursor:pointer;background:#fff;border:1px solid rgba(37,29,20,.09);border-radius:20px;overflow:hidden;text-decoration:none;color:inherit;display:block">
            <div style="position:relative;aspect-ratio:16/8.6;overflow:hidden">
              <Image src={b.img} width={600} height={323} densities={[1, 2]} alt={b.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
            </div>
            <div style="padding:24px 26px 28px">
              <div style="display:flex;gap:10px;align-items:center;font-size:12.5px;color:#8A7D69;margin-bottom:11px">
                <span style="color:#B95C36;font-weight:700">
                  <span class="lang-es">{b.cat.es}</span><span class="lang-en" hidden>{b.cat.en}</span>
                </span>
                <span>·</span>
                <span><span class="lang-es">{b.date.es}</span><span class="lang-en" hidden>{b.date.en}</span></span>
              </div>
              <h3 style="font-family:'Manrope';font-weight:700;font-size:24px;line-height:1.16;margin:0 0 11px;color:#251D14">
                <span class="lang-es">{b.title.es}</span><span class="lang-en" hidden>{b.title.en}</span>
              </h3>
              <p style="font-size:15px;line-height:1.58;color:#5A4F42;margin:0 0 16px">
                <span class="lang-es">{b.excerpt.es}</span><span class="lang-en" hidden>{b.excerpt.en}</span>
              </p>
              <span style="color:#B95C36;font-weight:700;font-size:14px">
                <span class="lang-es">Leer más</span><span class="lang-en" hidden>Read more</span> →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

</Layout>

<style>
  .blog-card { transition: transform .25s, box-shadow .25s; }
  .blog-card:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -22px rgba(37,29,20,.4); }

  /* Wraps the intro + card grid so one illustration sits fixed behind both —
     the section boundary is where it's naturally clipped away (no JS needed
     on desktop: background-attachment:fixed is bounded by this element's own
     box). isolation:isolate keeps the internal z-index stack (bg/wash/content)
     self-contained regardless of the fixed positioning used on mobile below. */
  .blog-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .blog-hero-section { position: relative; z-index: 2; }
  .blog-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/fondoblogs.webp');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    pointer-events: none;
  }
  .blog-hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(245, 240, 232, .15) 0%,
      rgba(245, 240, 232, .55) 20%,
      rgba(245, 240, 232, .4) 34%,
      rgba(245, 240, 232, .4) 100%
    );
  }

  @media (max-width: 880px) {
    /* iOS Safari mostly ignores background-attachment:fixed, and it's a known
       jank source on Android — fall back to a real position:fixed layer
       anchored to the viewport instead of this element's box, so the visual
       result still matches. It stays on screen the whole time the hero+cards
       region is anywhere in view, and only fades out once fully scrolled past
       (see the IntersectionObserver below) — same lifetime as the desktop
       technique gets for free from being clipped to its own box. */
    .blog-hero-bg {
      position: fixed;
      background-attachment: scroll;
      transition: opacity .3s ease;
    }
    .blog-hero-bg.is-past { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-hero-bg { background-attachment: scroll; }
  }
</style>

<script>
  // Only matters on the mobile fallback (position:fixed background, see CSS
  // above) — on desktop the illustration is clipped natively via
  // background-attachment:fixed on .blog-hero's own box, no JS involved.
  document.addEventListener('astro:page-load', () => {
    const heroWrap = document.querySelector<HTMLElement>('.blog-hero');
    const heroBg = document.querySelector<HTMLElement>('.blog-hero-bg');
    if (!heroWrap || !heroBg) return;

    const bgObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          heroBg.classList.remove('is-past');
        } else if (entry.boundingClientRect.bottom < 0) {
          heroBg.classList.add('is-past');
        }
      });
    }, { threshold: 0 });
    bgObserver.observe(heroWrap);
  });
</script>
