---
import Layout from '../../layouts/Layout.astro';
import { getSupabase } from '../../lib/supabase';

const { id } = Astro.params;
const supabase = getSupabase();

const [{ data: postRow }, { data: otherRows }] = await Promise.all([
  supabase.from('posts').select('data').eq('id', id).maybeSingle(),
  supabase.from('posts').select('data').neq('id', id).order('created_at', { ascending: true }).limit(3),
]);
if (!postRow) return Astro.redirect('/blog');
const post = postRow.data;
const related = (otherRows ?? []).map((r: any) => r.data);
---

<Layout activeKey="blog" title={`${post.title.es} · Boquete`} titleEn={`${post.title.en} · Boquete`}>

  <div class="blog-bg">

  <div class="blog-bg-canvas" aria-hidden="true">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="grad-cafe" gradientUnits="userSpaceOnUse" x1="108" y1="240" x2="108" y2="500">
          <stop offset="0" stop-color="#fff" />
          <stop class="stop-a" data-cluster="cafe" offset="0" stop-color="#fff" />
          <stop class="stop-b" data-cluster="cafe" offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient id="grad-branch" gradientUnits="userSpaceOnUse" x1="1600" y1="20" x2="1360" y2="400">
          <stop offset="0" stop-color="#fff" />
          <stop class="stop-a" data-cluster="branch" offset="0" stop-color="#fff" />
          <stop class="stop-b" data-cluster="branch" offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient id="grad-table" gradientUnits="userSpaceOnUse" x1="150" y1="790" x2="150" y2="490">
          <stop offset="0" stop-color="#fff" />
          <stop class="stop-a" data-cluster="table" offset="0" stop-color="#fff" />
          <stop class="stop-b" data-cluster="table" offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient id="grad-door" gradientUnits="userSpaceOnUse" x1="1600" y1="795" x2="1345" y2="510">
          <stop offset="0" stop-color="#fff" />
          <stop class="stop-a" data-cluster="door" offset="0" stop-color="#fff" />
          <stop class="stop-b" data-cluster="door" offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <mask id="blog-reveal-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1600" height="900">
          <rect x="8" y="240" width="200" height="260" fill="url(#grad-cafe)" />
          <rect x="1360" y="20" width="240" height="380" fill="url(#grad-branch)" />
          <rect x="0" y="490" width="315" height="300" fill="url(#grad-table)" />
          <rect x="1345" y="510" width="255" height="285" fill="url(#grad-door)" />
        </mask>
      </defs>
      <image href="/blog-bg.jpeg" x="0" y="0" width="1600" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#blog-reveal-mask)" />
    </svg>
  </div>

  <div class="blog-bg-content">

  <!-- ARTICLE HEADER -->
  <article class="pad-sec" style="max-width:760px;margin:0 auto;padding:60px 26px 20px">
    <a href="/blog" style="display:inline-flex;align-items:center;gap:7px;color:#B95C36;font-weight:700;font-size:14px;text-decoration:none;margin-bottom:22px">
      ← <span class="lang-es">Volver al blog</span><span class="lang-en" hidden>Back to blog</span>
    </a>
    <div style="display:flex;gap:10px;align-items:center;font-size:13px;color:#8A7D69;margin-bottom:16px">
      <span style="color:#B95C36;font-weight:700">
        <span class="lang-es">{post.cat.es}</span><span class="lang-en" hidden>{post.cat.en}</span>
      </span>
      <span>·</span>
      <span><span class="lang-es">Por</span><span class="lang-en" hidden>By</span> {post.author}</span>
      <span>·</span>
      <span><span class="lang-es">{post.date.es}</span><span class="lang-en" hidden>{post.date.en}</span></span>
    </div>
    <h1 style="font-family:'Manrope';font-weight:800;font-size:clamp(34px,5vw,52px);line-height:1.04;letter-spacing:-.02em;margin:0 0 22px;color:#251D14">
      <span class="lang-es">{post.title.es}</span><span class="lang-en" hidden>{post.title.en}</span>
    </h1>
    <p style="font-family:'Spectral';font-style:italic;font-size:21px;line-height:1.5;color:#5A4F42;margin:0 0 30px">
      <span class="lang-es">{post.excerpt.es}</span><span class="lang-en" hidden>{post.excerpt.en}</span>
    </p>
  </article>

  <!-- HERO IMAGE -->
  <div class="pad-sec" style="max-width:980px;margin:0 auto;padding:0 26px 14px">
    <div style="position:relative;aspect-ratio:16/8;border-radius:20px;overflow:hidden">
      <img src={post.img} alt={post.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
    </div>
  </div>

  <!-- BODY -->
  <article class="pad-sec" style="max-width:760px;margin:0 auto;padding:34px 26px 0">
    <div style="display:flex;flex-direction:column;gap:22px">
      {post.body.es.map((para, i) => (
        <p style="font-size:18px;line-height:1.75;color:#3D3328;margin:0">
          <span class="lang-es">{para}</span>
          <span class="lang-en" hidden>{post.body.en[i]}</span>
        </p>
      ))}
    </div>
    <div class="cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:34px 0 10px">
      {['-g1','-g2'].map(suf => (
        <div style="position:relative;aspect-ratio:4/3;border-radius:14px;overflow:hidden">
          <img src={`https://picsum.photos/seed/${post.id}${suf}/800/600`} alt={post.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
        </div>
      ))}
    </div>
  </article>

  <!-- CTA GUIDE -->
  <section class="pad-sec" style="max-width:760px;margin:0 auto;padding:20px 26px 0">
    <div style="background:#2C3A2A;border-radius:20px;padding:clamp(32px,4vw,48px) clamp(28px,4vw,44px);display:flex;align-items:center;gap:clamp(24px,3vw,40px);flex-wrap:wrap">
      <div style="flex:1;min-width:260px">
        <h3 style="font-family:'Spectral';font-weight:700;font-size:clamp(22px,3vw,30px);line-height:1.15;color:#F7F1E6;margin:0 0 12px">
          <span class="lang-es">¿Aún explorando Panamá?</span>
          <span class="lang-en" hidden>Still exploring Panama?</span>
        </h3>
        <p style="font-size:15px;line-height:1.6;color:#A99C86;margin:0">
          <span class="lang-es">Recibe la guía gratuita de Boquete: preguntas de reubicación, residencia, costo de vida y checklist para planear tu visita.</span>
          <span class="lang-en" hidden>Get the free guide to Boquete, including relocation questions, residency basics and a visit-planning checklist.</span>
        </p>
      </div>
      <a href="/#contacto" style="display:inline-block;background:#F7F1E6;color:#2C3A2A;font-weight:700;font-size:15px;padding:14px 28px;border-radius:12px;text-decoration:none;white-space:nowrap;transition:background .2s,transform .15s;box-shadow:0 2px 8px rgba(0,0,0,.12)">
        <span class="lang-es">Recibe la guía gratis →</span>
        <span class="lang-en" hidden>Get the free guide →</span>
      </a>
    </div>
  </section>

  <!-- RELATED -->
  <section class="pad-sec" style="max-width:1100px;margin:0 auto;padding:60px 26px 96px">
    <h3 style="font-family:'Manrope';font-weight:700;font-size:26px;margin:0 0 24px;color:#251D14;letter-spacing:-.01em">
      <span class="lang-es">Publicaciones relacionadas</span><span class="lang-en" hidden>Related posts</span>
    </h3>
    <div class="cols-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
      {related.map(r => (
        <a href={`/blog/${r.id}`} style="cursor:pointer;text-decoration:none;color:inherit">
          <div style="position:relative;aspect-ratio:3/2;border-radius:14px;overflow:hidden;margin-bottom:13px">
            <img src={r.img} alt={r.title.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
          </div>
          <div style="font-size:12px;color:#B95C36;font-weight:700;margin-bottom:6px">
            <span class="lang-es">{r.cat.es} · {r.date.es}</span>
            <span class="lang-en" hidden>{r.cat.en} · {r.date.en}</span>
          </div>
          <h4 style="font-family:'Manrope';font-weight:700;font-size:18px;line-height:1.2;margin:0;color:#251D14">
            <span class="lang-es">{r.title.es}</span><span class="lang-en" hidden>{r.title.en}</span>
          </h4>
        </a>
      ))}
    </div>
  </section>

  </div>

  </div>

</Layout>

<style>
  .blog-bg {
    position: relative;
    background-color: #f7e8d5;
  }
  .blog-bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .blog-bg-canvas svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .blog-bg-content {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  const CLUSTERS = [
    { id: 'cafe', start: 0.00 },
    { id: 'branch', start: 0.10 },
    { id: 'table', start: 0.06 },
    { id: 'door', start: 0.16 },
  ];
  const DURATION_MS = 6000;
  const DELAY_MS = 500;
  const SOFTNESS = 0.18;

  // 0.5 - 0.5*cos(pi*t): smooth ease in/out
  function ease(t: number) {
    return 0.5 - 0.5 * Math.cos(Math.PI * Math.max(0, Math.min(1, t)));
  }

  let rafId = 0;

  function setClusterOffsets(canvas: Element, g: number) {
    for (const c of CLUSTERS) {
      const span = 1 - c.start;
      const t = ease((g - c.start) / span);
      const edge = t * (1 + SOFTNESS);
      const o1 = Math.max(0, Math.min(1, edge - SOFTNESS));
      const o2 = Math.max(o1 + 0.0001, Math.min(1, edge));
      canvas.querySelector(`.stop-a[data-cluster="${c.id}"]`)?.setAttribute('offset', o1.toFixed(4));
      canvas.querySelector(`.stop-b[data-cluster="${c.id}"]`)?.setAttribute('offset', o2.toFixed(4));
    }
  }

  function startBlogBgReveal() {
    const canvas = document.querySelector('.blog-bg-canvas');
    if (!canvas) return;
    cancelAnimationFrame(rafId);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setClusterOffsets(canvas, 1);
      return;
    }

    let start: number | null = null;
    const tick = (ts: number) => {
      if (start == null) start = ts;
      const elapsed = ts - start - DELAY_MS;
      const g = elapsed <= 0 ? 0 : Math.min(1, elapsed / DURATION_MS);
      setClusterOffsets(canvas, g);
      if (g < 1) rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  // Keeps the fixed illustration pinned to the viewport while the blog
  // content scrolls, but fades it out once the content ends so it never
  // bleeds over the footer or related-posts sections below it.
  // Fades the illustration out over this many px of scroll, tied directly
  // to scroll position (no timed transition) so it is fully transparent
  // by the time the footer's edge reaches the bottom of the viewport —
  // it never has to fade "on top of" visible footer content.
  const FADE_ZONE_PX = 220;

  function updateBlogBgVisibility() {
    const wrap = document.querySelector('.blog-bg');
    const canvas = document.querySelector<HTMLElement>('.blog-bg-canvas');
    if (!wrap || !canvas) return;
    const distanceToFooter = wrap.getBoundingClientRect().bottom - window.innerHeight;
    const opacity = Math.max(0, Math.min(1, distanceToFooter / FADE_ZONE_PX));
    canvas.style.opacity = String(opacity);
  }

  function initBlogBg() {
    startBlogBgReveal();
    updateBlogBgVisibility();
  }

  window.addEventListener('scroll', updateBlogBgVisibility, { passive: true });
  window.addEventListener('resize', updateBlogBgVisibility);
  document.addEventListener('DOMContentLoaded', initBlogBg);
  document.addEventListener('astro:page-load', initBlogBg);
</script>
