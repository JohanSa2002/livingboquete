---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { TYPE_LABELS, AMEN_LABELS } from '../../data/data';
import { getSupabase } from '../../lib/supabase';

const { data: rentalRows } = await getSupabase()
  .from('rentals')
  .select('data')
  .order('created_at', { ascending: true });
const RENTALS = (rentalRows ?? []).map((r: any) => r.data);

// Presentational only — derives trust badges from existing data fields.
// Nothing here touches RENTALS or the client-side filtering logic below.
type IconName = 'location' | 'bed' | 'bath' | 'users' | 'wifi' | 'car' | 'paw'
  | 'flame' | 'mountain' | 'waves' | 'sofa' | 'star' | 'close' | 'sliders'
  | 'check' | 'chevron-right' | 'search' | 'coffee' | 'kitchen';
const AMEN_ICON: Record<string, IconName> = {
  wifi: 'wifi', kitchen: 'kitchen', view: 'mountain', parking: 'car',
  fireplace: 'flame', pool: 'waves', pets: 'paw', furnished: 'sofa',
};
const maxReviews = RENTALS.length ? Math.max(...RENTALS.map((r: any) => r.reviews)) : 0;
function getBadges(p: any) {
  const badges: { es: string; en: string }[] = [];
  if (p.reviews === maxReviews) badges.push({ es: 'Más reservado', en: 'Most booked' });
  if (p.amen.includes('view')) badges.push({ es: 'Vista al volcán', en: 'Volcano view' });
  if (p.amen.includes('pets')) badges.push({ es: 'Pet Friendly', en: 'Pet Friendly' });
  if (p.amen.includes('furnished')) badges.push({ es: 'Amueblado', en: 'Furnished' });
  return badges.slice(0, 2);
}
---

<Layout activeKey="stays" title="Alquiler · Boquete" titleEn="Stays · Boquete">

  <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding:64px 26px 0">
    <div class="eyebrow" style="margin-bottom:14px">
      <span class="lang-es">Alquiler mensual</span><span class="lang-en" hidden>Monthly rentals</span>
    </div>
    <h1 style="font-family:var(--font-display);font-weight:800;font-size:var(--text-hero);line-height:1;letter-spacing:-.025em;margin:0 0 14px;color:var(--color-ink)">
      <span class="lang-es">Vive en Boquete</span>
      <span class="lang-en" hidden>Live in Boquete</span>
    </h1>
    <p style="font-size:var(--text-h3);color:var(--color-ink-soft);max-width:600px;margin:0 0 36px;line-height:1.45">
      <span class="lang-es">Casas, habitaciones y apartamentos en alquiler mensual para quienes quieren mudarse a Boquete. No son alojamientos por noche.</span>
      <span class="lang-en" hidden>Houses, rooms and apartments for monthly rent for those who want to move to Boquete. These are not nightly stays.</span>
    </p>
  </section>

  <!-- Mobile filters trigger -->
  <div class="pad-sec filters-mobile-bar" style="max-width:1240px;margin:0 auto;padding:0 26px 20px;display:none">
    <button id="filters-toggle" class="btn btn-secondary" style="width:100%;justify-content:center">
      <Icon name="sliders" size={18} />
      <span class="lang-es">Filtros</span><span class="lang-en" hidden>Filters</span>
    </button>
  </div>

  <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding:0 26px 96px">
    <div class="split-2" style="display:grid;grid-template-columns:296px 1fr;gap:36px;align-items:start">

      <!-- Filters sidebar -->
      <aside id="filters-sidebar" class="filters-sidebar card" style="position:sticky;top:92px;padding:26px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px">
          <div style="display:flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:700;font-size:17px;color:var(--color-ink)">
            <Icon name="sliders" size={18} />
            <span class="lang-es">Filtros</span><span class="lang-en" hidden>Filters</span>
          </div>
          <button id="filters-close" aria-label="Close" style="border:none;background:transparent;cursor:pointer;color:var(--color-ink-soft)">
            <Icon name="close" size={20} />
          </button>
        </div>

        <!-- Type filter -->
        <div style="margin-bottom:24px">
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Tipo</span><span class="lang-en" hidden>Type</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {(['all','casa','habitacion','apto'] as const).map(type => (
              <button data-type={type} class="chip type-filter">
                {type === 'all'
                  ? <><span class="lang-es">Todos</span><span class="lang-en" hidden>All</span></>
                  : <><span class="lang-es">{TYPE_LABELS[type].es}</span><span class="lang-en" hidden>{TYPE_LABELS[type].en}</span></>
                }
              </button>
            ))}
          </div>
        </div>

        <!-- Price range -->
        <div style="margin-bottom:24px">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px">
            <span style="font-size:13px;font-weight:700;color:var(--color-ink-soft);text-transform:uppercase;letter-spacing:.06em">
              <span class="lang-es">Precio máximo</span><span class="lang-en" hidden>Max price</span>
            </span>
            <span id="price-display" style="font-family:var(--font-display);font-size:15px;font-weight:800;color:var(--color-forest)">$1500</span>
          </div>
          <input type="range" id="price-range" class="range-input" min="300" max="1500" step="50" value="1500" />
          <div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--color-ink-faint);margin-top:6px">
            <span>$300</span><span>$1500</span>
          </div>
        </div>

        <!-- Guests -->
        <div style="margin-bottom:24px">
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Personas</span><span class="lang-en" hidden>Occupants</span>
          </div>
          <div style="position:relative">
            <select id="guests-select" style="width:100%;appearance:none;background:var(--color-sand);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:12px 40px 12px 14px;font-size:14px;font-weight:600;color:var(--color-ink);outline:none;cursor:pointer">
              {[1,2,3,4,5,6,7,8].map(n => <option value={n}>{n}+</option>)}
            </select>
            <span style="position:absolute;right:14px;top:50%;transform:translateY(-50%) rotate(90deg);pointer-events:none;color:var(--color-ink-soft)">
              <Icon name="chevron-right" size={16} />
            </span>
          </div>
        </div>

        <!-- Amenity filters -->
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Comodidades</span><span class="lang-en" hidden>Amenities</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {(['pets','furnished'] as const).map(key => (
              <button data-amenity={key} class="chip amenity-filter">
                <Icon name={AMEN_ICON[key]} size={15} />
                <span class="lang-es">{AMEN_LABELS[key].es}</span><span class="lang-en" hidden>{AMEN_LABELS[key].en}</span>
              </button>
            ))}
          </div>
        </div>
      </aside>

      <!-- Mobile backdrop -->
      <div id="filters-backdrop" class="hidden" style="position:fixed;inset:0;z-index:80;background:rgba(20,15,10,.45)"></div>

      <!-- Results -->
      <div>
        <div style="margin-bottom:22px;font-size:15px;color:var(--color-ink-soft)">
          <b id="results-count" style="color:var(--color-ink);font-weight:800;font-family:var(--font-display)">{RENTALS.length}</b>&nbsp;
          <span class="lang-es">alquileres disponibles</span><span class="lang-en" hidden>rentals available</span>
        </div>
        <div class="cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:26px" id="rentals-grid">
          {RENTALS.map(p => (
            <a
              href={`/alquiler/${p.id}`}
              class="rental-card rv card"
              data-type={p.type}
              data-price={p.price}
              data-guests={p.guests}
              data-pets={p.amen.includes('pets')}
              data-furnished={p.amen.includes('furnished')}
              style="text-decoration:none;color:inherit;display:block;overflow:hidden"
            >
              <div class="rental-card-media" style="position:relative;aspect-ratio:16/10;overflow:hidden">
                <img src={p.img} alt={p.name.es} class="rental-card-img" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
                <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,20,15,.02) 0%,rgba(20,20,15,0) 30%,rgba(15,15,10,.55) 100%)"></div>

                <div style="position:absolute;top:13px;left:13px;right:13px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                  <span class="badge badge-dark">
                    <span class="lang-es">{TYPE_LABELS[p.type].es}</span><span class="lang-en" hidden>{TYPE_LABELS[p.type].en}</span>
                  </span>
                  <span class="badge badge-light">
                    <Icon name="star" size={12} />{p.rating.toFixed(1)}
                  </span>
                </div>

                <div style="position:absolute;bottom:13px;left:13px;right:13px;display:flex;flex-wrap:wrap;gap:6px">
                  {getBadges(p).map(b => (
                    <span class="badge badge-forest">
                      <span class="lang-es">{b.es}</span><span class="lang-en" hidden>{b.en}</span>
                    </span>
                  ))}
                </div>
              </div>
              <div style="padding:19px 20px 21px">
                <div style="display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--color-ink-faint);margin-bottom:6px">
                  <Icon name="location" size={13} />
                  <span class="lang-es">{p.loc.es}</span><span class="lang-en" hidden>{p.loc.en}</span>
                </div>
                <h3 style="font-family:var(--font-display);font-weight:700;font-size:19px;margin:0 0 10px;color:var(--color-ink);line-height:1.2">
                  <span class="lang-es">{p.name.es}</span><span class="lang-en" hidden>{p.name.en}</span>
                </h3>
                <div style="display:flex;align-items:center;gap:14px;font-size:13px;color:var(--color-ink-soft);margin-bottom:14px">
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="users" size={15} />{p.guests}</span>
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="bed" size={15} />{p.beds}</span>
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="bath" size={15} />{p.baths}</span>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
                  {p.amen.slice(0, 4).map(key => (
                    <span title={AMEN_LABELS[key]?.es} style="display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:var(--color-sand);color:var(--color-forest)">
                      <Icon name={AMEN_ICON[key]} size={15} />
                    </span>
                  ))}
                </div>
                <div style="display:flex;align-items:baseline;justify-content:space-between;border-top:1px solid var(--color-border-soft);padding-top:14px">
                  <div>
                    <span style="font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--color-ink)">${p.price}</span>
                    <span style="font-size:13.5px;color:var(--color-ink-faint)"> / <span class="lang-es">mes</span><span class="lang-en" hidden>month</span></span>
                  </div>
                  <span style="color:var(--color-forest);font-weight:700;font-size:13.5px;display:flex;align-items:center;gap:3px">
                    <span class="lang-es">Ver más</span><span class="lang-en" hidden>See more</span> <Icon name="chevron-right" size={14} />
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div id="no-results" class="card" style="display:none;border-style:dashed;padding:54px 30px;text-align:center;color:var(--color-ink-faint);font-size:15.5px">
          <span class="lang-es">Sin resultados para estos filtros.</span><span class="lang-en" hidden>No results for these filters.</span>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .rental-card { transition: transform .28s var(--ease-out), box-shadow .28s var(--ease-out); }
  .rental-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  .rental-card-img { transition: transform .5s var(--ease-out); }
  .rental-card:hover .rental-card-img { transform: scale(1.07); }

  .range-input {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-forest) 0%, var(--color-forest) var(--fill, 100%), var(--color-border) var(--fill, 100%), var(--color-border) 100%);
    cursor: pointer;
  }
  .range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-forest);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }
  .range-input::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-forest);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  #filters-close { display: none; }

  @media (max-width: 880px) {
    .filters-sidebar {
      position: fixed !important;
      top: 0; right: 0; bottom: 0;
      width: min(86vw, 360px);
      z-index: 90;
      border-radius: 0 !important;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform .3s var(--ease-out);
    }
    .filters-sidebar.is-open { display: block !important; transform: translateX(0); }
    #filters-close { display: inline-flex !important; }
    #filters-backdrop.is-open { display: block !important; }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.rental-card');
  const countEl = document.getElementById('results-count')!;
  const noResults = document.getElementById('no-results')!;
  const typeFilters = document.querySelectorAll<HTMLElement>('.type-filter');
  const amenityFilters = document.querySelectorAll<HTMLElement>('.amenity-filter');
  const priceRange = document.getElementById('price-range') as HTMLInputElement;
  const priceDisplay = document.getElementById('price-display')!;
  const guestsSelect = document.getElementById('guests-select') as HTMLSelectElement;

  let activeType = 'all';
  let maxPrice = 1500;
  let minGuests = 1;
  const activeAmenities = new Set<string>();

  function applyFilters() {
    let count = 0;
    cards.forEach(card => {
      const type = card.dataset.type ?? '';
      const price = parseInt(card.dataset.price ?? '0');
      const guests = parseInt(card.dataset.guests ?? '0');
      const matchesAmenities = [...activeAmenities].every(key => card.dataset[key] === 'true');
      const show = (activeType === 'all' || type === activeType) && price <= maxPrice && guests >= minGuests && matchesAmenities;
      card.style.display = show ? 'block' : 'none';
      if (show) count++;
    });
    countEl.textContent = String(count);
    noResults.style.display = count === 0 ? 'block' : 'none';
  }

  amenityFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.amenity ?? '';
      const active = activeAmenities.has(key);
      if (active) activeAmenities.delete(key); else activeAmenities.add(key);
      btn.classList.toggle('is-active', !active);
      applyFilters();
    });
  });

  typeFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.type ?? 'all';
      typeFilters.forEach(f => f.classList.toggle('is-active', f.dataset.type === activeType));
      applyFilters();
    });
  });

  // Init first type filter
  document.querySelector<HTMLElement>('.type-filter')?.classList.add('is-active');

  function updatePriceFill() {
    const pct = ((parseInt(priceRange.value) - parseInt(priceRange.min)) / (parseInt(priceRange.max) - parseInt(priceRange.min))) * 100;
    priceRange.style.setProperty('--fill', `${pct}%`);
  }
  updatePriceFill();

  priceRange.addEventListener('input', () => {
    maxPrice = parseInt(priceRange.value);
    priceDisplay.textContent = `$${maxPrice}`;
    updatePriceFill();
    applyFilters();
  });

  guestsSelect.addEventListener('change', () => {
    minGuests = parseInt(guestsSelect.value);
    applyFilters();
  });

  // Mobile filters drawer (presentation only — does not touch filtering logic above)
  const sidebar = document.getElementById('filters-sidebar');
  const backdrop = document.getElementById('filters-backdrop');
  const openBtn = document.getElementById('filters-toggle');
  const closeBtn = document.getElementById('filters-close');

  function openDrawer() {
    sidebar?.classList.add('is-open');
    backdrop?.classList.remove('hidden');
    backdrop?.classList.add('is-open');
  }
  function closeDrawer() {
    sidebar?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    backdrop?.classList.add('hidden');
  }
  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>
