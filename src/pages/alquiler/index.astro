    .stays-spot-body { padding: 32px 26px; }

    .filters-sidebar {
      position: fixed !important;
      top: 0; right: 0; bottom: 0;
      width: min(86vw, 360px);
      z-index: 90;
      border-radius: 0 !important;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform .3s var(--ease-out);
    }
    .filters-sidebar.is-open { display: block !important; transform: translateX(0); }
    #filters-close { display: inline-flex !important; }
    #filters-backdrop.is-open { display: block !important; }
  }
  @media (max-width: 560px) {
    .stays-life-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Keeps the fixed background pinned to the viewport while scrolling,
  // fading it out before the footer so it never overlaps it (same
  // approach used on the rental detail page).
  const FADE_ZONE_PX = 220;

  function updateRentalBgVisibility() {
    const wrap = document.querySelector('.rental-bg');
    const canvas = document.querySelector<HTMLElement>('.rental-bg-canvas');
    if (!wrap || !canvas) return;
    const distanceToFooter = wrap.getBoundingClientRect().bottom - window.innerHeight;
    const opacity = Math.max(0, Math.min(1, distanceToFooter / FADE_ZONE_PX));
    canvas.style.opacity = String(opacity);
  }

  window.addEventListener('scroll', updateRentalBgVisibility, { passive: true });
  window.addEventListener('resize', updateRentalBgVisibility);
  document.addEventListener('DOMContentLoaded', updateRentalBgVisibility);
  document.addEventListener('astro:page-load', updateRentalBgVisibility);
</script>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.rental-card');
  const countEl = document.getElementById('results-count')!;
  const noResults = document.getElementById('no-results')!;
  const typeFilters = document.querySelectorAll<HTMLElement>('.type-filter');
  const amenityFilters = document.querySelectorAll<HTMLElement>('.amenity-filter');
  const priceRange = document.getElementById('price-range') as HTMLInputElement;
  const priceDisplay = document.getElementById('price-display')!;
  const guestsSelect = document.getElementById('guests-select') as HTMLSelectElement;

  let activeType = 'all';
  let maxPrice = 1500;
  let minGuests = 1;
  const activeAmenities = new Set<string>();

  function applyFilters() {
    let count = 0;
    cards.forEach(card => {
      const type = card.dataset.type ?? '';
      const price = parseInt(card.dataset.price ?? '0');
      const guests = parseInt(card.dataset.guests ?? '0');
      const matchesAmenities = [...activeAmenities].every(key => card.dataset[key] === 'true');
      const show = (activeType === 'all' || type === activeType) && price <= maxPrice && guests >= minGuests && matchesAmenities;
      card.style.display = show ? 'block' : 'none';
      if (show) count++;
    });
    countEl.textContent = String(count);
    noResults.style.display = count === 0 ? 'block' : 'none';
  }

  amenityFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.amenity ?? '';
      const active = activeAmenities.has(key);
      if (active) activeAmenities.delete(key); else activeAmenities.add(key);
      btn.classList.toggle('is-active', !active);
      applyFilters();
    });
  });

  typeFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.type ?? 'all';
      typeFilters.forEach(f => f.classList.toggle('is-active', f.dataset.type === activeType));
      applyFilters();
    });
  });

  // Init first type filter
  document.querySelector<HTMLElement>('.type-filter')?.classList.add('is-active');

  function updatePriceFill() {
    const pct = ((parseInt(priceRange.value) - parseInt(priceRange.min)) / (parseInt(priceRange.max) - parseInt(priceRange.min))) * 100;
    priceRange.style.setProperty('--fill', `${pct}%`);
  }
  updatePriceFill();

  priceRange.addEventListener('input', () => {
    maxPrice = parseInt(priceRange.value);
    priceDisplay.textContent = `$${maxPrice}`;
    updatePriceFill();
    applyFilters();
  });

  guestsSelect.addEventListener('change', () => {
    minGuests = parseInt(guestsSelect.value);
    applyFilters();
  });

  // Lifestyle shortcuts: reset filters, then activate the matching chip by
  // programmatically clicking it (reuses the logic above, no duplicated state),
  // and scroll down to the results grid.
  document.querySelectorAll<HTMLElement>('[data-shortcut]').forEach(cardBtn => {
    cardBtn.addEventListener('click', () => {
      const key = cardBtn.dataset.shortcut ?? '';
      const kind = cardBtn.dataset.shortcutKind ?? 'amen';

      // Reset: type back to "all", clear any active amenities.
      const allChip = document.querySelector<HTMLElement>('.type-filter[data-type="all"]');
      if (activeType !== 'all') allChip?.click();
      amenityFilters.forEach(chip => {
        const k = chip.dataset.amenity ?? '';
        if (activeAmenities.has(k)) chip.click();
      });

      // Activate target.
      if (kind === 'type') {
        document.querySelector<HTMLElement>(`.type-filter[data-type="${key}"]`)?.click();
      } else {
        document.querySelector<HTMLElement>(`.amenity-filter[data-amenity="${key}"]`)?.click();
      }

      document.getElementById('explorar')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Mobile filters drawer (presentation only — does not touch filtering logic above)
  const sidebar = document.getElementById('filters-sidebar');
  const backdrop = document.getElementById('filters-backdrop');
  const openBtn = document.getElementById('filters-toggle');
  const closeBtn = document.getElementById('filters-close');

  function openDrawer() {
    sidebar?.classList.add('is-open');
    backdrop?.classList.remove('hidden');
    backdrop?.classList.add('is-open');
  }
  function closeDrawer() {
    sidebar?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    backdrop?.classList.add('hidden');
  }
  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>

<script>
  // Hero parallax: the background photo settles in with a soft zoom on load
  // and then scrubs slower than the page as you scroll, adding depth. Uses
  // ScrollTrigger, which ships free with the already-installed GSAP.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initHeroParallax() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const img = document.querySelector<HTMLElement>('.stays-hero-img');
    if (!img) return;

    // Clear anything left over from a previous client-side visit to this page.
    ScrollTrigger.getById('stays-hero-parallax')?.kill();
    gsap.killTweensOf(img);
    gsap.set(img, { clearProps: 'transform' });

    // Settle-in zoom.
    gsap.from(img, { scale: 1.14, duration: 1.9, ease: 'power2.out' });

    // Depth scrub, tied to the hero's own scroll range.
    gsap.to(img, {
      yPercent: 14,
      ease: 'none',
      scrollTrigger: {
        id: 'stays-hero-parallax',
        trigger: '.stays-hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });
  }

  // Fires on the initial load and after every client-side navigation.
  document.addEventListener('astro:page-load', initHeroParallax);
</script>
