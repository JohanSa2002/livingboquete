---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { TYPE_LABELS, AMEN_LABELS } from '../../data/data';
import { getSupabase, cachedQuery } from '../../lib/supabase';

const RENTALS = await cachedQuery('rentals', async () => {
  const { data } = await getSupabase()
    .from('rentals')
    .select('data')
    .order('created_at', { ascending: true });
  return (data ?? []).map((r: any) => r.data);
});

// Presentational only — derives trust badges from existing data fields.
// Nothing here touches RENTALS or the client-side filtering logic below.
type IconName = 'location' | 'bed' | 'bath' | 'users' | 'wifi' | 'car' | 'paw'
  | 'flame' | 'mountain' | 'waves' | 'sofa' | 'star' | 'close' | 'sliders'
  | 'check' | 'chevron-right' | 'search' | 'coffee' | 'kitchen';
const AMEN_ICON: Record<string, IconName> = {
  wifi: 'wifi', kitchen: 'kitchen', view: 'mountain', parking: 'car',
  fireplace: 'flame', pool: 'waves', pets: 'paw', furnished: 'sofa',
};
const maxReviews = RENTALS.length ? Math.max(...RENTALS.map((r: any) => r.reviews)) : 0;
function getBadges(p: any) {
  const badges: { es: string; en: string }[] = [];
  if (p.reviews === maxReviews) badges.push({ es: 'Más reservado', en: 'Most booked' });
  if (p.amen.includes('view')) badges.push({ es: 'Vista al volcán', en: 'Volcano view' });
  if (p.amen.includes('pets')) badges.push({ es: 'Pet Friendly', en: 'Pet Friendly' });
  if (p.amen.includes('furnished')) badges.push({ es: 'Amueblado', en: 'Furnished' });
  return badges.slice(0, 2);
}

// Spotlight: properties manually marked "featured" in the admin. Falls back
// to the most-reviewed listing when nothing has been marked yet.
const manuallyFeatured = RENTALS.filter((r: any) => r.featured);
const spotlightSource = manuallyFeatured.length
  ? manuallyFeatured
  : RENTALS.length
    ? [RENTALS.reduce((a: any, b: any) => (b.reviews > a.reviews ? b : a), RENTALS[0])]
    : [];
const spotlightItems = spotlightSource.map((r: any) => ({
  ...r,
  quote: r.reviewsList?.length
    ? r.reviewsList.reduce((a: any, b: any) => (b.rating > a.rating ? b : a), r.reviewsList[0])
    : null,
}));

// Lifestyle shortcuts: count + representative photo pulled from real listings.
type Lifestyle = {
  key: string;               // value consumed by the shortcut script
  kind: 'amen' | 'type';
  es: string; en: string;
  taglineEs: string; taglineEn: string;
  icon: IconName;
  img: string;
};
const LIFESTYLES: Lifestyle[] = [
  { key: 'view', kind: 'amen', es: 'Vista al volcán', en: 'Volcano views', taglineEs: 'Amanece frente al Barú', taglineEn: 'Wake up facing Barú', icon: 'mountain', img: '/vista-al-volcan.webp' },
  { key: 'pets', kind: 'amen', es: 'Con tu mascota', en: 'With your pet', taglineEs: 'Ellos también se mudan', taglineEn: 'They move in too', icon: 'paw', img: '/casa-perro.webp' },
  { key: 'furnished', kind: 'amen', es: 'Llega y vive', en: 'Move-in ready', taglineEs: 'Amueblado, sin vueltas', taglineEn: 'Furnished, zero hassle', icon: 'sofa', img: '/casa-amueblada.webp' },
  { key: 'casa', kind: 'type', es: 'Casa entera', en: 'Whole house', taglineEs: 'Tu espacio, tus reglas', taglineEn: 'Your space, your rules', icon: 'flame', img: '/casa-completa.webp' },
];
const lifestyleData = LIFESTYLES.map(ls => {
  const matches = ls.kind === 'amen'
    ? RENTALS.filter((r: any) => r.amen.includes(ls.key))
    : RENTALS.filter((r: any) => r.type === ls.key);
  return { ...ls, count: matches.length };
});

// Voices: the highest-rated real reviews across every listing.
const VOICES = RENTALS
  .flatMap((r: any) => (r.reviewsList ?? []).map((rv: any) => ({ ...rv, stayEs: r.name.es, stayEn: r.name.en })))
  .sort((a: any, b: any) => b.rating - a.rating)
  .slice(0, 3);
---

<Layout
  activeKey="stays"
  title="Alquiler · MIKA Homes"
  titleEn="Stays · MIKA Homes"
  description="Casas, apartamentos y habitaciones en alquiler mensual en Boquete, Chiriquí. Comunidad y montañas."
  descriptionEn="Houses, apartments and rooms for monthly rent in Boquete, Chiriquí. Community and mountains."
>

  <!-- ============ HERO: live the highlands ============ -->
  <section class="stays-hero">
    <img src="/hero-poster.webp" alt="Tierras altas de Boquete" class="stays-hero-img" />
    <div class="stays-hero-veil"></div>

    <div class="stays-hero-inner pad-sec">
      <div class="stays-hero-copy">
        <h1 class="stays-hero-h1 rv-once">
          <span class="lang-es">Despierta<br /><em>entre montañas.</em></span>
          <span class="lang-en" hidden>Wake up<br /><em>in the mountains.</em></span>
        </h1>
        <p class="stays-hero-sub rv-once" style="animation-delay:.16s">
          <span class="lang-es">Alquiler mensual en Boquete para quedarse de verdad: casas, apartamentos y habitaciones listos para tu mudanza. Nada de estadías por noche.</span>
          <span class="lang-en" hidden>Monthly rentals in Boquete for people who are actually staying: houses, apartments and rooms ready for your move. No nightly stays.</span>
        </p>
        <div class="stays-hero-ctas rv-once" style="animation-delay:.24s">
          <a href="#explorar" class="btn btn-primary">
            <Icon name="search" size={17} />
            <span class="lang-es">Explorar alquileres</span><span class="lang-en" hidden>Browse rentals</span>
          </a>
          <a href="/#contacto" class="btn btn-ghost">
            <span class="lang-es">Publica tu propiedad</span><span class="lang-en" hidden>List your property</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="rental-bg">

  <div class="rental-bg-canvas" aria-hidden="true"></div>

  <div class="rental-bg-content">

  <!-- ============ LIFESTYLES: browse by how you want to live ============ -->
  <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding-top:72px">
    <div class="eyebrow rv" style="margin-bottom:12px">
      <span class="lang-es">Explora a tu manera</span><span class="lang-en" hidden>Browse your way</span>
    </div>
    <div class="stays-sec-head rv">
      <h2 class="stays-h2">
        <span class="lang-es">¿Cómo quieres <em>vivir</em>?</span>
        <span class="lang-en" hidden>How do you want <em>to live</em>?</span>
      </h2>
      <p class="stays-sec-sub">
        <span class="lang-es">Empieza por el estilo de vida, no por el listado.</span>
        <span class="lang-en" hidden>Start from the lifestyle, not the listing.</span>
      </p>
    </div>

    <div class="stays-life-grid">
      {lifestyleData.map((ls, i) => (
        <button class="stays-life-card rv" data-shortcut={ls.key} data-shortcut-kind={ls.kind} style={`animation-delay:${i * 0.06}s`}>
          <img src={ls.img} alt={ls.es} loading="lazy" />
          <div class="stays-life-veil"></div>
          <div class="stays-life-body">
            <span class="stays-life-icon"><Icon name={ls.icon} size={18} /></span>
            <div class="stays-life-name">
              <span class="lang-es">{ls.es}</span><span class="lang-en" hidden>{ls.en}</span>
            </div>
            <div class="stays-life-tag">
              <span class="lang-es">{ls.taglineEs}</span><span class="lang-en" hidden>{ls.taglineEn}</span>
            </div>
            <div class="stays-life-count">
              {ls.count} <span class="lang-es">{ls.count === 1 ? 'opción' : 'opciones'}</span><span class="lang-en" hidden>{ls.count === 1 ? 'option' : 'options'}</span>
              <Icon name="chevron-right" size={13} />
            </div>
          </div>
        </button>
      ))}
    </div>
  </section>

  <!-- ============ SPOTLIGHT: the community's pick(s) ============ -->
  {spotlightItems.length > 0 && (
    <section class="pad-sec" style="max-width:1240px;margin:0 auto;padding-top:84px">
      <div class="stays-spot-wrap rv">
        <div class="stays-spot-track" id="spot-track">
          {spotlightItems.map(item => (
            <div class="stays-spot">
              <a href={`/alquiler/${item.id}`} class="stays-spot-media" aria-label={item.name.es}>
                <img src={item.img} alt={item.name.es} loading="lazy" />
                <span class="badge badge-wood stays-spot-flag">
                  <Icon name="star" size={12} />
                  <span class="lang-es">La elección de la comunidad</span><span class="lang-en" hidden>The community's pick</span>
                </span>
              </a>
              <div class="stays-spot-body">
                <div class="eyebrow" style="margin-bottom:14px">
                  <span class="lang-es">Destacado del mes</span><span class="lang-en" hidden>Featured this month</span>
                </div>
                <h2 class="stays-h2" style="margin-bottom:10px">
                  <span class="lang-es">{item.name.es}</span><span class="lang-en" hidden>{item.name.en}</span>
                </h2>
                <div class="stays-spot-meta">
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="star" size={14} /><b>{item.rating.toFixed(1)}</b> · {item.reviews} <span class="lang-es">reseñas</span><span class="lang-en" hidden>reviews</span></span>
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="location" size={14} /><span class="lang-es">{item.loc.es}</span><span class="lang-en" hidden>{item.loc.en}</span></span>
                </div>
                {item.quote && (
                  <blockquote class="stays-quote">
                    <span class="lang-es">“{item.quote.text.es}”</span>
                    <span class="lang-en" hidden>“{item.quote.text.en}”</span>
                    <footer>— {item.quote.name}</footer>
                  </blockquote>
                )}
                <div class="stays-spot-foot">
                  <div>
                    <span class="stays-spot-price">${item.price}</span>
                    <span class="stays-spot-per">/ <span class="lang-es">mes</span><span class="lang-en" hidden>month</span></span>
                  </div>
                  <a href={`/alquiler/${item.id}`} class="btn btn-primary">
                    <span class="lang-es">Conocer esta casa</span><span class="lang-en" hidden>See this home</span>
                    <Icon name="chevron-right" size={16} />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        {spotlightItems.length > 1 && (
          <div class="stays-spot-nav">
            <button type="button" class="stays-spot-arrow" id="spot-prev" aria-label="Anterior">
              <Icon name="chevron-right" size={17} class="stays-spot-arrow-icon" />
            </button>
            <div class="stays-spot-dots" id="spot-dots">
              {spotlightItems.map((_, i) => (
                <button type="button" class="stays-spot-dot" data-dot={i} aria-label={`Ir al destacado ${i + 1}`}></button>
              ))}
            </div>
            <button type="button" class="stays-spot-arrow" id="spot-next" aria-label="Siguiente">
              <Icon name="chevron-right" size={17} />
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  {spotlightItems.length > 1 && (
    <script>
      const track = document.getElementById('spot-track');
      const prevBtn = document.getElementById('spot-prev');
      const nextBtn = document.getElementById('spot-next');
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.stays-spot-dot'));
      if (track) {
        const goTo = (i: number) => {
          const slide = track.children[i] as HTMLElement | undefined;
          if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
        };
        const currentIndex = () => Math.round(track.scrollLeft / track.clientWidth);

        prevBtn?.addEventListener('click', () => goTo(Math.max(0, currentIndex() - 1)));
        nextBtn?.addEventListener('click', () => goTo(Math.min(track.children.length - 1, currentIndex() + 1)));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

        const syncDots = () => {
          const i = currentIndex();
          dots.forEach((dot, di) => dot.classList.toggle('is-active', di === i));
        };
        track.addEventListener('scroll', () => requestAnimationFrame(syncDots), { passive: true });
        syncDots();
      }
    </script>
  )}

  <!-- ============ EXPLORE: filters + grid (anchor target) ============ -->
  <section id="explorar" class="pad-sec" style="max-width:1240px;margin:0 auto;padding-top:84px;scroll-margin-top:88px">
    <div class="stays-sec-head rv" style="margin-bottom:28px">
      <h2 class="stays-h2">
        <span class="lang-es">Todos los <em>alquileres</em></span>
        <span class="lang-en" hidden>Every <em>rental</em></span>
      </h2>
      <p class="stays-sec-sub">
        <span class="lang-es">Filtra por tipo, precio y comodidades. Sin cuentas, sin comisiones.</span>
        <span class="lang-en" hidden>Filter by type, price and amenities. No accounts, no fees.</span>
      </p>
    </div>

    <!-- Mobile filters trigger -->
    <div class="filters-mobile-bar" style="padding:0 0 20px;display:none">
      <button id="filters-toggle" class="btn btn-secondary" style="width:100%;justify-content:center">
        <Icon name="sliders" size={18} />
        <span class="lang-es">Filtros</span><span class="lang-en" hidden>Filters</span>
      </button>
    </div>

    <div class="split-2" style="display:grid;grid-template-columns:296px 1fr;gap:36px;align-items:start;padding-bottom:8px">

      <!-- Filters sidebar -->
      <aside id="filters-sidebar" class="filters-sidebar card" style="position:sticky;top:92px;padding:26px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px">
          <div style="display:flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:700;font-size:17px;color:var(--color-ink)">
            <Icon name="sliders" size={18} />
            <span class="lang-es">Filtros</span><span class="lang-en" hidden>Filters</span>
          </div>
          <button id="filters-close" aria-label="Close" style="border:none;background:transparent;cursor:pointer;color:var(--color-ink-soft)">
            <Icon name="close" size={20} />
          </button>
        </div>

        <!-- Type filter -->
        <div style="margin-bottom:24px">
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Tipo</span><span class="lang-en" hidden>Type</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {(['all','casa','habitacion','apto'] as const).map(type => (
              <button data-type={type} class="chip type-filter">
                {type === 'all'
                  ? <><span class="lang-es">Todos</span><span class="lang-en" hidden>All</span></>
                  : <><span class="lang-es">{TYPE_LABELS[type].es}</span><span class="lang-en" hidden>{TYPE_LABELS[type].en}</span></>
                }
              </button>
            ))}
          </div>
        </div>

        <!-- Price range -->
        <div style="margin-bottom:24px">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px">
            <span style="font-size:13px;font-weight:700;color:var(--color-ink-soft);text-transform:uppercase;letter-spacing:.06em">
              <span class="lang-es">Precio máximo</span><span class="lang-en" hidden>Max price</span>
            </span>
            <span id="price-display" style="font-family:var(--font-display);font-size:15px;font-weight:800;color:var(--color-forest)">$1500</span>
          </div>
          <input type="range" id="price-range" class="range-input" min="300" max="1500" step="50" value="1500" />
          <div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--color-ink-faint);margin-top:6px">
            <span>$300</span><span>$1500</span>
          </div>
        </div>

        <!-- Guests -->
        <div style="margin-bottom:24px">
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Personas</span><span class="lang-en" hidden>Occupants</span>
          </div>
          <div style="position:relative">
            <select id="guests-select" style="width:100%;appearance:none;background:var(--color-sand);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:12px 40px 12px 14px;font-size:14px;font-weight:600;color:var(--color-ink);outline:none;cursor:pointer">
              {[1,2,3,4,5,6,7,8].map(n => <option value={n}>{n}+</option>)}
            </select>
            <span style="position:absolute;right:14px;top:50%;transform:translateY(-50%) rotate(90deg);pointer-events:none;color:var(--color-ink-soft)">
              <Icon name="chevron-right" size={16} />
            </span>
          </div>
        </div>

        <!-- Amenity filters -->
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--color-ink-soft);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em">
            <span class="lang-es">Comodidades</span><span class="lang-en" hidden>Amenities</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {(['view','pets','furnished'] as const).map(key => (
              <button data-amenity={key} class="chip amenity-filter">
                <Icon name={AMEN_ICON[key]} size={15} />
                <span class="lang-es">{AMEN_LABELS[key].es}</span><span class="lang-en" hidden>{AMEN_LABELS[key].en}</span>
              </button>
            ))}
          </div>
        </div>
      </aside>

      <!-- Mobile backdrop -->
      <div id="filters-backdrop" class="hidden" style="position:fixed;inset:0;z-index:80;background:rgba(20,15,10,.45)"></div>

      <!-- Results -->
      <div>
        <div style="margin-bottom:22px;font-size:15px;color:var(--color-ink-soft)">
          <b id="results-count" style="color:var(--color-ink);font-weight:800;font-family:var(--font-display)">{RENTALS.length}</b>&nbsp;
          <span class="lang-es">alquileres disponibles</span><span class="lang-en" hidden>rentals available</span>
        </div>
        <div class="cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:26px" id="rentals-grid">
          {RENTALS.map(p => (
            <a
              href={`/alquiler/${p.id}`}
              class="rental-card rv card"
              data-type={p.type}
              data-price={p.price}
              data-guests={p.guests}
              data-view={p.amen.includes('view')}
              data-pets={p.amen.includes('pets')}
              data-furnished={p.amen.includes('furnished')}
              style="text-decoration:none;color:inherit;display:block;overflow:hidden"
            >
              <div class="rental-card-media" style="position:relative;aspect-ratio:16/10;overflow:hidden">
                <img src={p.img} alt={p.name.es} class="rental-card-img" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
                <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,20,15,.02) 0%,rgba(20,20,15,0) 30%,rgba(15,15,10,.55) 100%)"></div>

                <div style="position:absolute;top:13px;left:13px;right:13px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                  <div style="display:flex;gap:6px;flex-wrap:wrap">
                    <span class="badge badge-dark">
                      <span class="lang-es">{TYPE_LABELS[p.type].es}</span><span class="lang-en" hidden>{TYPE_LABELS[p.type].en}</span>
                    </span>
                    {p.verified && (
                      <span class="badge badge-forest" title="Propiedad verificada">
                        <Icon name="check" size={12} />
                        <span class="lang-es">Verificada</span><span class="lang-en" hidden>Verified</span>
                      </span>
                    )}
                  </div>
                  <span class="badge badge-light">
                    <Icon name="star" size={12} />{p.rating.toFixed(1)}
                  </span>
                </div>

                <div style="position:absolute;bottom:13px;left:13px;right:13px;display:flex;flex-wrap:wrap;gap:6px">
                  {getBadges(p).map(b => (
                    <span class="badge badge-forest">
                      <span class="lang-es">{b.es}</span><span class="lang-en" hidden>{b.en}</span>
                    </span>
                  ))}
                </div>
              </div>
              <div style="padding:19px 20px 21px">
                <div style="display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--color-ink-faint);margin-bottom:6px">
                  <Icon name="location" size={13} />
                  <span class="lang-es">{p.loc.es}</span><span class="lang-en" hidden>{p.loc.en}</span>
                </div>
                <h3 style="font-family:var(--font-display);font-weight:700;font-size:19px;margin:0 0 10px;color:var(--color-ink);line-height:1.2">
                  <span class="lang-es">{p.name.es}</span><span class="lang-en" hidden>{p.name.en}</span>
                </h3>
                <div style="display:flex;align-items:center;gap:14px;font-size:13px;color:var(--color-ink-soft);margin-bottom:14px">
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="users" size={15} />{p.guests}</span>
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="bed" size={15} />{p.beds}</span>
                  <span style="display:flex;align-items:center;gap:5px"><Icon name="bath" size={15} />{p.baths}</span>
                  {p.parking > 0 && (
                    <span style="display:flex;align-items:center;gap:5px"><Icon name="car" size={15} />{p.parking}</span>
                  )}
                </div>
                <div style="display:flex;align-items:center;gap:14px;font-size:13px;color:var(--color-ink-soft);margin-bottom:16px">
                  {p.amen.filter(key => key !== 'parking').slice(0, 4).map(key => (
                    <span title={AMEN_LABELS[key]?.es} style="display:flex;align-items:center;gap:5px">
                      <Icon name={AMEN_ICON[key]} size={15} />
                    </span>
                  ))}
                </div>
                <div style="display:flex;align-items:baseline;justify-content:space-between;border-top:1px solid var(--color-border-soft);padding-top:14px">
                  <div>
                    <span style="font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--color-ink)">${p.price}</span>
                    <span style="font-size:13.5px;color:var(--color-ink-faint)"> / <span class="lang-es">mes</span><span class="lang-en" hidden>month</span></span>
                  </div>
                  <span style="color:var(--color-forest);font-weight:700;font-size:13.5px;display:flex;align-items:center;gap:3px">
                    <span class="lang-es">Ver más</span><span class="lang-en" hidden>See more</span> <Icon name="chevron-right" size={14} />
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div id="no-results" class="card" style="display:none;border-style:dashed;padding:54px 30px;text-align:center;color:var(--color-ink-faint);font-size:15.5px">
          <span class="lang-es">Sin resultados para estos filtros.</span><span class="lang-en" hidden>No results for these filters.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
