---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { TYPE_LABELS, AMEN_LABELS } from '../../data/data';
import { getSupabase } from '../../lib/supabase';
import { Image } from 'astro:assets';
import 'leaflet/dist/leaflet.css';

const { id } = Astro.params;
if (!id) return Astro.redirect('/alquiler');
const { data: stayRow } = await getSupabase().from('rentals').select('data').eq('id', id).maybeSingle();
if (!stayRow) return Astro.redirect('/alquiler');
const stay = stayRow.data;
// Only render photos that belong to this listing. The former fallback used
// Picsum for four fabricated gallery cells, which meant every visit had to
// wait for several third-party image requests before the gallery felt ready.
// `images` is optional so existing listings that only have `img` continue to
// work, while future listings can supply additional real photos.
const galleryImages = [stay.img, ...(Array.isArray(stay.images) ? stay.images : [])]
  .filter((image): image is string => typeof image === 'string' && image.length > 0)
  .filter((image, index, images) => images.indexOf(image) === index);
const whatsappPhone = stay.host.phone.replace(/\D/g, '');
const whatsappMessage = `Hola, vi tu anuncio de ${stay.name.es} en MIKA Homes y quiero obtener más información sobre la propiedad.`;
const whatsappUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMessage)}`;

// Availability text: no move-in date means available right now.
const today = new Date();
today.setHours(0, 0, 0, 0);
const availableFromDate = stay.availableFrom ? new Date(stay.availableFrom) : null;
const isAvailableNow = !availableFromDate || availableFromDate <= today;
let availability = { es: 'Disponible ahora', en: 'Available now' };
if (!isAvailableNow) {
  const diffDays = Math.ceil((availableFromDate.getTime() - today.getTime()) / 86400000);
  if (diffDays < 30) {
    availability = {
      es: `Disponible en ${diffDays} día${diffDays === 1 ? '' : 's'}`,
      en: `Available in ${diffDays} day${diffDays === 1 ? '' : 's'}`,
    };
  } else {
    const diffMonths = Math.round(diffDays / 30);
    availability = {
      es: `Disponible en ${diffMonths} mes${diffMonths === 1 ? '' : 'es'}`,
      en: `Available in ${diffMonths} month${diffMonths === 1 ? '' : 's'}`,
    };
  }
}
---

<Layout activeKey="stays" title={`${stay.name.es} · MIKA Homes`} titleEn={`${stay.name.en} · MIKA Homes`}>

  <div class="rental-bg">

  <div class="rental-bg-canvas" aria-hidden="true"></div>

  <div class="rental-bg-content">

  <!-- GALLERY HERO -->
  <section class="pad-sec" style="max-width:1100px;margin:0 auto;padding:54px 26px 0">
    <a href="/alquiler" style="display:inline-flex;align-items:center;gap:7px;color:#8E4A2A;font-weight:700;font-size:14px;text-decoration:none;margin-bottom:18px">
      ← <span class="lang-es">Volver a alojamientos</span><span class="lang-en" hidden>Back to stays</span>
    </a>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
      <h1 style="font-family:'Manrope';font-weight:800;font-size:clamp(32px,4.6vw,52px);line-height:1.02;letter-spacing:-.02em;margin:0;color:#251D14">
        <span class="lang-es">{stay.name.es}</span><span class="lang-en" hidden>{stay.name.en}</span>
      </h1>
      {stay.verified && (
        <span style="display:inline-flex;align-items:center;gap:5px;background:#2C3A2A;color:#E6B87C;font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;flex:none" title="Propiedad verificada por Boquete">
          <Icon name="check" size={13} />
          <span class="lang-es">Verificada</span><span class="lang-en" hidden>Verified</span>
        </span>
      )}
    </div>
    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px;margin-bottom:14px;font-size:15px;color:#5A4F42">
      <span style="display:flex;align-items:center;gap:5px;font-weight:700;color:#251D14"><span style="color:#C8964A">★</span>{stay.rating.toFixed(1)}</span>
      <span>·</span>
      <span>{stay.reviews} <span class="lang-es">reseñas</span><span class="lang-en" hidden>reviews</span></span>
      <span>·</span>
      <span><span class="lang-es">{stay.loc.es}</span><span class="lang-en" hidden>{stay.loc.en}</span></span>
    </div>
    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:10px 18px;margin-bottom:24px;font-size:15px;color:#5A4F42">
      <span style="display:flex;align-items:center;gap:6px"><Icon name="users" size={16} />{stay.guests} <span class="lang-es">huéspedes</span><span class="lang-en" hidden>guests</span></span>
      <span style="display:flex;align-items:center;gap:6px"><Icon name="bed" size={16} />{stay.beds} <span class="lang-es">habitaciones</span><span class="lang-en" hidden>bedrooms</span></span>
      <span style="display:flex;align-items:center;gap:6px"><Icon name="bath" size={16} />{stay.baths} <span class="lang-es">baños</span><span class="lang-en" hidden>bathrooms</span></span>
      {stay.parking > 0 && (
        <span style="display:flex;align-items:center;gap:6px"><Icon name="car" size={16} />{stay.parking} <span class="lang-es">parqueos</span><span class="lang-en" hidden>parking</span></span>
      )}
    </div>

    <!-- Video + photo grid -->
    <div class="media-split" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:40px">
      <div class="video-box" style="border-radius:20px;overflow:hidden;aspect-ratio:16/9">
        <YouTubeFacade url={stay.video} title={stay.name.es} />
      </div>
      <div class="gallery-grid" style={`display:grid;grid-template-columns:${galleryImages.length > 1 ? '1.6fr 1fr 1fr' : '1fr'};grid-template-rows:1fr 1fr;gap:12px;aspect-ratio:16/9;border-radius:20px;overflow:hidden`}>
        <button type="button" class="gallery-cell" data-lightbox-trigger style="grid-row:1/3;position:relative">
          <Image src={stay.img} width={900} height={620} densities={[1, 2]} alt={stay.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        </button>
        {galleryImages.slice(1, 5).map((image) => (
          <button type="button" class="gallery-cell" data-lightbox-trigger style="position:relative">
            <Image src={image} width={600} height={400} densities={[1, 2]} alt={stay.name.es} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo lightbox -->
  <div id="gallery-lightbox" class="hidden" style="position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.9);display:flex;align-items:center;justify-content:center">
    <button id="gallery-lightbox-close" aria-label="Cerrar" style="position:absolute;top:20px;right:24px;background:transparent;border:none;color:#fff;font-size:32px;cursor:pointer;line-height:1">&times;</button>
    <img id="gallery-lightbox-img" src="" alt="" style="max-width:90vw;max-height:90vh;object-fit:contain;border-radius:12px" />
  </div>

  <!-- CONTENT -->
  <section class="pad-sec" style="max-width:1100px;margin:0 auto;padding:0 26px 40px">
    <div class="split-2" style="display:grid;grid-template-columns:1.5fr 1fr;gap:48px;align-items:start">

      <!-- Left: description + amenities + reviews -->
      <div style="background:#F7F1E6;border:1px solid rgba(37,29,20,.09);border-radius:20px;padding:32px;box-shadow:0 12px 30px -22px rgba(37,29,20,.35)">
        <p style="font-size:17px;line-height:1.72;color:#3D3328;margin:0 0 30px">
          <span class="lang-es">{stay.desc.es}</span><span class="lang-en" hidden>{stay.desc.en}</span>
        </p>

        <!-- Amenities -->
        <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:24px;margin-bottom:30px">
          <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;margin:0 0 16px;color:#251D14">
            <span class="lang-es">Lo que incluye</span><span class="lang-en" hidden>What's included</span>
          </h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            {stay.amen.map(key => (
              <div style="display:flex;align-items:center;gap:10px;font-size:15px;color:#3D3328">
                <span style="font-size:20px">{AMEN_LABELS[key]?.icon}</span>
                <span class="lang-es">{AMEN_LABELS[key]?.es}</span>
                <span class="lang-en" hidden>{AMEN_LABELS[key]?.en}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Host -->
        <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:24px;margin-bottom:30px;display:flex;align-items:center;gap:16px">
          <div style="width:54px;height:54px;border-radius:50%;background:#2C3A2A;color:#E6B87C;display:flex;align-items:center;justify-content:center;font-family:'Manrope';font-weight:800;font-size:22px;flex:none">{stay.host.name[0]}</div>
          <div>
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-family:'Manrope';font-weight:700;font-size:18px;color:#251D14">{stay.host.name}</span>
              {stay.verified && (
                <span style="display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;color:#2F7A3D" title="Identidad y propiedad verificadas">
                  <Icon name="check" size={13} />
                  <span class="lang-es">Anfitrión verificado</span><span class="lang-en" hidden>Verified host</span>
                </span>
              )}
            </div>
            <div style="font-size:14px;color:var(--color-ink-faint)">
              <span class="lang-es">{stay.host.line.es}</span><span class="lang-en" hidden>{stay.host.line.en}</span>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:24px;margin-bottom:30px">
          <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;margin:0 0 16px;color:#251D14">
            <span class="lang-es">Ubicación</span><span class="lang-en" hidden>Location</span>
          </h3>
          <div id="map" data-lat={stay.lat} data-lng={stay.lng} data-name={stay.name.es} style="width:100%;height:300px;border-radius:16px;overflow:hidden;border:1px solid rgba(37,29,20,.1)"></div>
        </div>

        <!-- Reviews -->
        <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:24px">
          <h3 style="font-family:'Manrope';font-weight:700;font-size:21px;margin:0 0 18px;color:#251D14">
            <span class="lang-es">Reseñas</span><span class="lang-en" hidden>Reviews</span>
          </h3>
          <div style="display:flex;flex-direction:column;gap:18px">
            {(stay.reviewsList ?? []).map(rv => (
              <div style="background:#fff;border:1px solid rgba(37,29,20,.09);border-radius:16px;padding:20px">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                  <div style="display:flex;align-items:center;gap:10px">
                    <div style="width:38px;height:38px;border-radius:50%;background:#EFE7D6;color:#8E4A2A;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px">{rv.name[0]}</div>
                    <div>
                      <div style="font-weight:700;font-size:15px;color:#251D14">{rv.name}</div>
                      <div style="font-size:12.5px;color:var(--color-ink-faint)">
                        <span class="lang-es">{rv.date.es}</span><span class="lang-en" hidden>{rv.date.en}</span>
                      </div>
                    </div>
                  </div>
                  <span style="font-weight:700;color:#C8964A">★ {rv.rating.toFixed(1)}</span>
                </div>
                <p style="font-size:15px;line-height:1.6;color:#3D3328;margin:0">
                  <span class="lang-es">{rv.text.es}</span><span class="lang-en" hidden>{rv.text.en}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: booking card -->
      <div class="booking-col" style="position:sticky;top:92px">
        <div style="background:#fff;border:1px solid rgba(37,29,20,.1);border-radius:20px;padding:28px;box-shadow:0 12px 30px -22px rgba(37,29,20,.5)">
          <div style="display:flex;align-items:baseline;gap:6px;margin-bottom:10px">
            <span style="font-family:'Manrope';font-weight:800;font-size:28px;color:#251D14">${stay.price}</span>
            <span style="font-size:15px;color:var(--color-ink-faint)">/ <span class="lang-es">mes</span><span class="lang-en" hidden>month</span></span>
          </div>

          <div style={`display:flex;align-items:center;gap:7px;margin-bottom:20px;font-size:14px;font-weight:700;color:${isAvailableNow ? '#2F7A3D' : '#B9822E'}`}>
            <span style="width:8px;height:8px;border-radius:50%;background:currentColor;flex:none"></span>
            <span class="lang-es">{availability.es}</span><span class="lang-en" hidden>{availability.en}</span>
          </div>

          <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:18px;display:flex;flex-direction:column;gap:12px;margin-bottom:20px">
            {stay.verified && (
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:14px;color:#5A4F42">
                <span style="display:flex;align-items:center;gap:7px"><Icon name="check" size={15} /><span class="lang-es">Propiedad verificada</span><span class="lang-en" hidden>Verified property</span></span>
              </div>
            )}
            {stay.minMonths > 1 && (
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:14px;color:#5A4F42">
                <span class="lang-es">Estadía mínima</span><span class="lang-en" hidden>Minimum stay</span>
                <span style="font-weight:700;color:#251D14">{stay.minMonths} <span class="lang-es">meses</span><span class="lang-en" hidden>months</span></span>
              </div>
            )}
            {stay.sqmBuilt > 0 && (
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:14px;color:#5A4F42">
                <span style="display:flex;align-items:center;gap:7px"><Icon name="ruler" size={15} /><span class="lang-es">Construcción</span><span class="lang-en" hidden>Built area</span></span>
                <span style="font-weight:700;color:#251D14">{stay.sqmBuilt} m²</span>
              </div>
            )}
            {stay.sqmLot > 0 && (
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:14px;color:#5A4F42">
                <span class="lang-es">Terreno</span><span class="lang-en" hidden>Lot size</span>
                <span style="font-weight:700;color:#251D14">{stay.sqmLot} m²</span>
              </div>
            )}
          </div>

          <div style="border-top:1px solid rgba(37,29,20,.12);padding-top:18px">
            <div style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--color-ink-faint);margin-bottom:10px">
              <span class="lang-es">Contactar al anfitrión</span><span class="lang-en" hidden>Contact the host</span>
            </div>
            <div style="font-weight:700;font-size:15px;color:#251D14;margin-bottom:10px">{stay.host.name}</div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="whatsapp-contact"
              aria-label={`Escribir por WhatsApp a ${stay.host.name} sobre ${stay.name.es}`}
            >
              <Icon name="phone" size={18} />
              <span class="lang-es">Consultar por WhatsApp</span><span class="lang-en" hidden>Ask on WhatsApp</span>
            </a>
            <div style="display:flex;flex-direction:column;gap:8px">
              <a href={`tel:${stay.host.phone.replace(/[^+\d]/g, '')}`} style="display:flex;align-items:center;gap:9px;padding:8px 0;color:#3D3328;text-decoration:none;font-size:14.5px;font-weight:600">
                <Icon name="phone" size={16} />{stay.host.phone}
              </a>
              <a href={`mailto:${stay.host.email}`} style="display:flex;align-items:center;gap:9px;padding:8px 0;color:#3D3328;text-decoration:none;font-size:14.5px;font-weight:600">
                <Icon name="mail" size={16} />{stay.host.email}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  </div>

  </div>

</Layout>

<script>
  const mapEl = document.getElementById('map');
  const lat = parseFloat(mapEl?.dataset.lat ?? '');
  const lng = parseFloat(mapEl?.dataset.lng ?? '');
  const stayName = mapEl?.dataset.name ?? '';

  async function loadMap() {
    if (!mapEl || !Number.isFinite(lat) || !Number.isFinite(lng) || mapEl.dataset.loaded) return;
    mapEl.dataset.loaded = 'true';

    try {
      const [leafletModule, markerIcon2x, markerIcon, markerShadow] = await Promise.all([
        import('leaflet'),
        import('leaflet/dist/images/marker-icon-2x.png'),
        import('leaflet/dist/images/marker-icon.png'),
        import('leaflet/dist/images/marker-shadow.png'),
      ]);
      const L = leafletModule.default;
      delete L.Icon.Default.prototype._getIconUrl;
      L.Icon.Default.mergeOptions({
        iconRetinaUrl: (markerIcon2x.default as { src: string }).src,
        iconUrl: (markerIcon.default as { src: string }).src,
        shadowUrl: (markerShadow.default as { src: string }).src,
      });
      const map = L.map(mapEl, { scrollWheelZoom: false }).setView([lat, lng], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
        maxZoom: 18,
      }).addTo(map);
      L.marker([lat, lng]).addTo(map).bindPopup(`<strong>${stayName}</strong>`).openPopup();
    } catch (err) {
      console.error('No se pudo cargar el mapa:', err);
      mapEl.style.display = 'flex';
      mapEl.style.alignItems = 'center';
      mapEl.style.justifyContent = 'center';
      mapEl.innerHTML = `<a href="https://www.google.com/maps?q=${lat},${lng}" target="_blank" rel="noopener" style="color:#8E4A2A;font-weight:700;font-size:14px;text-decoration:none">Ver ubicación en Google Maps →</a>`;
    }
  }

  if (mapEl && Number.isFinite(lat) && Number.isFinite(lng)) {
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      void loadMap();
    }, { rootMargin: '300px 0px' });
    observer.observe(mapEl);
  }
</script>

<script>
  // Photo gallery lightbox: click any thumbnail to see it full-size,
  // reusing the same dark-backdrop pattern as the home gallery lightbox.
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('gallery-lightbox-img') as HTMLImageElement | null;

  function openLightbox(img: HTMLImageElement) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const img = trigger.querySelector('img');
      if (img) openLightbox(img);
    });
  });

  document.getElementById('gallery-lightbox-close')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .rental-bg {
    position: relative;
  }
  .rental-bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Flat wash, not a gradient: this layer is position:fixed, so it's
       anchored to the viewport rather than the scrolling title block — a
       gradient would drift in and out of strength as the page scrolls. */
    background-image:
      linear-gradient(rgba(245,240,232,.68), rgba(245,240,232,.68)),
      url('/fondoalquiler.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .rental-bg-content {
    position: relative;
    z-index: 1;
  }

  /* Gallery cells are <button>s so photos are keyboard- and click-accessible;
     reset default button chrome and add a hover cue that they open a lightbox. */
  .gallery-cell {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }
  .gallery-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 15, 10, 0);
    transition: background-color .18s ease;
  }
  .gallery-cell:hover::after,
  .gallery-cell:focus-visible::after {
    background: rgba(20, 15, 10, .15);
  }

  .whatsapp-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    box-sizing: border-box;
    margin: 0 0 10px;
    padding: 13px 16px;
    border-radius: 11px;
    background: #25D366;
    color: #12341f;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
  }

  .whatsapp-contact:hover {
    background: #20c65c;
    box-shadow: 0 8px 16px -10px rgba(20, 120, 55, .8);
    transform: translateY(-1px);
  }

  .whatsapp-contact:focus-visible {
    outline: 3px solid rgba(37, 211, 102, .42);
    outline-offset: 3px;
  }

  #gallery-lightbox {
    transition: opacity .2s ease;
  }

  @media (max-width: 700px) {
    .media-split {
      grid-template-columns: 1fr !important;
    }
    .video-box {
      aspect-ratio: 16/9 !important;
    }
    .gallery-grid {
      display: flex !important;
      aspect-ratio: auto !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .gallery-grid::-webkit-scrollbar { display: none; }
    .gallery-cell {
      flex: 0 0 84%;
      aspect-ratio: 4/3;
      scroll-snap-align: start;
      border-radius: 16px;
    }
  }

  @media (max-width: 880px) {
    .booking-col {
      position: static !important;
      top: auto !important;
    }
  }
</style>

<script>
  // Keeps the house background pinned to the viewport while scrolling,
  // fading it out before the footer so it never overlaps it (same
  // approach used for the blog article background).
  const FADE_ZONE_PX = 220;

  function updateRentalBgVisibility() {
    const wrap = document.querySelector('.rental-bg');
    const canvas = document.querySelector<HTMLElement>('.rental-bg-canvas');
    if (!wrap || !canvas) return;
    const distanceToFooter = wrap.getBoundingClientRect().bottom - window.innerHeight;
    const opacity = Math.max(0, Math.min(1, distanceToFooter / FADE_ZONE_PX));
    canvas.style.opacity = String(opacity);
  }

  window.addEventListener('scroll', updateRentalBgVisibility, { passive: true });
  window.addEventListener('resize', updateRentalBgVisibility);
  document.addEventListener('DOMContentLoaded', updateRentalBgVisibility);
  document.addEventListener('astro:page-load', updateRentalBgVisibility);
</script>
