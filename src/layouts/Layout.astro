---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  activeKey?: string;
}

const {
  title = 'MIKA Homes',
  titleEn = 'MIKA Homes',
  description = 'Descubre Boquete: volcán Barú, café Geisha, quetzales, aventura y cultura en las tierras altas de Chiriquí, Panamá.',
  descriptionEn = 'Discover Boquete: Barú Volcano, Geisha coffee, quetzals, adventure and culture in the Chiriquí highlands, Panama.',
  activeKey = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="title-en" content={titleEn} />
  <meta name="title-es" content={title} />
  <meta name="desc-en" content={descriptionEn} />
  <meta name="desc-es" content={description} />
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Spectral:ital,wght@1,400;1,500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Header activeKey={activeKey} />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    // Smooth scroll (Lenis) driven by the GSAP ticker, so Lenis and any
    // ScrollTrigger animations stay on a single clock. Native scroll is
    // preserved, so position:sticky and scroll-driven CSS keep working.
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const win = window as unknown as { __lenis?: Lenis };
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ClientRouter keeps <html> alive across navigations, so a single Lenis
    // instance lives for the whole session — never re-create it.
    if (!win.__lenis && !reduceMotion) {
      const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
      win.__lenis = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    // After each view transition: jump to top and recompute trigger positions.
    document.addEventListener('astro:after-swap', () => {
      win.__lenis?.scrollTo(0, { immediate: true });
    });
    document.addEventListener('astro:page-load', () => {
      ScrollTrigger.refresh();
    });
  </script>

  <script>
    // Language switcher
    const LANG_KEYS = ['es', 'en'] as const;
    type Lang = typeof LANG_KEYS[number];

    function applyLang(lang: Lang) {
      const html = document.documentElement;
      html.setAttribute('data-lang', lang);
      html.setAttribute('lang', lang);
      localStorage.setItem('bq-lang', lang);

      // Update toggle buttons
      document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach(btn => {
        const isActive = btn.dataset.langBtn === lang;
        btn.style.background = isActive ? 'var(--color-forest)' : 'transparent';
        btn.style.color = isActive ? 'var(--color-sand)' : 'var(--color-ink-soft)';
      });

      // Update page title and meta description
      const titleMeta = document.querySelector<HTMLMetaElement>(`meta[name="title-${lang}"]`);
      if (titleMeta) document.title = titleMeta.content;
      const descMeta = document.querySelector<HTMLMetaElement>(`meta[name="desc-${lang}"]`);
      const descTag = document.querySelector<HTMLMetaElement>('meta[name="description"]');
      if (descMeta && descTag) descTag.content = descMeta.content;
    }

    // Init
    const saved = localStorage.getItem('bq-lang') as Lang | null;
    const lang: Lang = (saved && LANG_KEYS.includes(saved)) ? saved : 'es';
    applyLang(lang);

    // Listen for clicks on lang buttons
    document.addEventListener('click', (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-lang-btn]');
      if (btn?.dataset.langBtn) applyLang(btn.dataset.langBtn as Lang);
    });

    // Mobile menu toggle
    const burger = document.getElementById('mobile-burger');
    const mobileOverlay = document.getElementById('mobile-overlay');

    function closeMobile() {
      mobileOverlay?.classList.add('hidden');
    }

    burger?.addEventListener('click', () => {
      mobileOverlay?.classList.toggle('hidden');
    });

    mobileOverlay?.addEventListener('click', closeMobile);
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMobile);
    });

    // Scroll to hash, centering within the visible area below the sticky header
    function scrollToHash() {
      const hash = window.location.hash;
      if (!hash) return;
      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;
      const HEADER = 88;
      const rect = target.getBoundingClientRect();
      const sectionCenterDoc = rect.top + window.scrollY + rect.height / 2;
      const visibleCenter = HEADER + (window.innerHeight - HEADER) / 2;
      const desiredScroll = sectionCenterDoc - visibleCenter;
      window.scrollTo({ top: Math.max(0, desiredScroll), behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (window.location.hash) setTimeout(scrollToHash, 200);
    });

    document.addEventListener('astro:page-load', () => {
      if (window.location.hash) setTimeout(scrollToHash, 200);
    });
  </script>
</body>
</html>
