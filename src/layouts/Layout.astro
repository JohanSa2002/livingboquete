---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { swapLocale, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  activeKey?: string;
  image?: string;
}

const {
  lang,
  title = 'MIKA Homes',
  titleEn = 'MIKA Homes',
  description = 'Descubre Boquete: volcán Barú, café Geisha, quetzales, aventura y cultura en las tierras altas de Chiriquí, Panamá.',
  descriptionEn = 'Discover Boquete: Barú Volcano, Geisha coffee, quetzals, adventure and culture in the Chiriquí highlands, Panama.',
  activeKey = 'home',
  image,
} = Astro.props;

const pageTitle = lang === 'en' ? titleEn : title;
const pageDescription = lang === 'en' ? descriptionEn : description;

// Canonical always points at the clean path (no query string / hash) so
// filtered or hash-anchored URLs don't get indexed as separate pages.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image ?? '/logo-mika-dark.webp', Astro.site).href;
const esUrl = new URL(swapLocale(Astro.url.pathname, 'es'), Astro.site);
const enUrl = new URL(swapLocale(Astro.url.pathname, 'en'), Astro.site);
---

<!doctype html>
<html lang={lang} data-lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Page-specific early hints (e.g. an LCP image preload) — must stay this
      high in <head> so the browser's preload scanner finds it before it
      reaches render-blocking tags like the font stylesheet below. */}
  <slot name="head" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={esUrl} />
  <meta property="og:site_name" content="MIKA Homes" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_PA'} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Loaded as non-blocking: the `media="print"` + onload swap trick lets first
      paint proceed on fallback fonts instead of waiting on this stylesheet
      round-trip, while `display=swap` still avoids invisible text once it lands. */}
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Spectral:ital,wght@1,400;1,500&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Spectral:ital,wght@1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </noscript>
</head>
<body>
  <Header activeKey={activeKey} lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />

  <script>
    // Smooth scroll uses the browser's animation frame directly. Keeping
    // GSAP/ScrollTrigger out of the shared layout avoids downloading both
    // libraries on public pages that do not use a GSAP animation.
    import Lenis from 'lenis';

    const win = window as unknown as { __lenis?: Lenis };
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ClientRouter keeps <html> alive across navigations, so a single Lenis
    // instance lives for the whole session — never re-create it.
    if (!win.__lenis && !reduceMotion) {
      const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
      win.__lenis = lenis;
      const animate = (time: number) => {
        lenis.raf(time);
        requestAnimationFrame(animate);
      };
      requestAnimationFrame(animate);
    }

    // After each view transition, jump to the top of the next page.
    document.addEventListener('astro:after-swap', () => {
      win.__lenis?.scrollTo(0, { immediate: true });
    });
    // Smooth Scroll Entrance Animations for Titles, Subtitles & Section Intros.
    // NOTE: We only target individual heading/label elements — NOT section.rv
    // wrappers. Applying transform to sections creates compositor layers that
    // conflict with the header's position:sticky + transform hide animation.
    function setupScrollReveals() {
      // Runs the same staged reveal regardless of prefers-reduced-motion —
      // the site owner wants the fade/blur/slide sequence to always play.

      // Headings and eyebrow labels that are already in the DOM (static markup).
      // Excludes anything inside the sticky header or mobile overlay.
      const initial = Array.from(
        document.querySelectorAll<HTMLElement>('h1,h2,h3,.eyebrow,[data-reveal]')
      ).filter(el =>
        !el.closest('header') &&
        !el.closest('#mobile-overlay') &&
        !el.closest('.admin-sidebar') &&
        // Lead form: content should be immediately visible, not staged in.
        !el.closest('#contacto')
      );

      // Auto-tag the immediate <p> sibling of a heading as a subtitle reveal.
      initial.forEach(h => {
        if (!/^H[123]$/.test(h.tagName)) return;
        const next = h.nextElementSibling as HTMLElement | null;
        if (next && next.tagName === 'P' && !next.hasAttribute('data-reveal')) {
          next.setAttribute('data-reveal', 'sub');
          initial.push(next);
        }
      });

      // De-duplicate (the [data-reveal] selector already picked up some).
      const seen = new Set<HTMLElement>();
      const elements = initial.filter(el => {
        if (seen.has(el)) return false;
        seen.add(el);
        return true;
      });

      // Tag untagged elements and compute sibling stagger delays.
      elements.forEach(el => {
        if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', 'title');

        if (!el.hasAttribute('data-reveal-delay')) {
          const parent = el.parentElement;
          if (parent) {
            const revealSiblings = Array.from(parent.children).filter(
              c => (c as HTMLElement).hasAttribute('data-reveal')
            ) as HTMLElement[];
            const idx = revealSiblings.indexOf(el);
            if (idx > 0) {
              el.setAttribute('data-reveal-delay', String(Math.min(idx * 120, 360)));
            }
          }
        }
      });

      // Once the transform/opacity/filter transition settles, drop will-change
      // so the browser doesn't keep a composited layer around indefinitely for
      // content that will never animate again (it already fired once).
      function retireLayer(el: HTMLElement) {
        el.addEventListener('transitionend', () => { el.style.willChange = 'auto'; }, { once: true });
      }

      // rootMargin pulls the trigger line up from the bottom edge so a section
      // starts revealing a little before it's fully scrolled into view — the
      // next block is already emerging as the previous one settles, instead of
      // waiting for a hard "fully visible" cutoff.
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
          retireLayer(el);
          if (delay > 0) {
            setTimeout(() => el.classList.add('is-revealed'), delay);
          } else {
            el.classList.add('is-revealed');
          }
          obs.unobserve(el);
        });
      }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });

      // Read every element's rect BEFORE writing any classList change below —
      // interleaving reads and writes per-element in a single pass forces the
      // browser to flush layout on every iteration (Lighthouse's "forced
      // reflow" diagnostic). Batching all reads first, then all writes, costs
      // one layout flush total instead of one per element.
      const toEvaluate = elements.filter(el => !el.classList.contains('is-revealed'));
      const rects = toEvaluate.map(el => el.getBoundingClientRect());

      toEvaluate.forEach((el, i) => {
        const rect = rects[i];
        // Already in viewport on page load → reveal on the same stagger a
        // scroll-triggered reveal would use. No flash risk: [data-reveal]'s
        // opacity:0 is in the stylesheet from first paint, so the element was
        // never visible to begin with — the delay is purely the intended
        // staged entrance (e.g. eyebrow → title → paragraph on a page intro).
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          const delay = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
          retireLayer(el);
          if (delay > 0) {
            setTimeout(() => el.classList.add('is-revealed'), delay);
          } else {
            el.classList.add('is-revealed');
          }
        } else {
          observer.observe(el);
        }
      });
    }

    // astro:page-load fires on both the initial page load and every client-side
    // navigation — no need to also listen to DOMContentLoaded.
    document.addEventListener('astro:page-load', setupScrollReveals);
  </script>

  <script>
    // Language is now decided by the URL (/es/... vs /en/...), not a client
    // toggle — Header renders real links to the equivalent path in the other
    // language (see swapLocale in src/lib/i18n.ts), so there is nothing to
    // apply here. This script only handles scrolling to a hash target,
    // independent of language.
    function scrollToHash() {
      const hash = window.location.hash;
      if (!hash) return;
      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;
      const HEADER = 88;
      const rect = target.getBoundingClientRect();
      const sectionCenterDoc = rect.top + window.scrollY + rect.height / 2;
      const visibleCenter = HEADER + (window.innerHeight - HEADER) / 2;
      const desiredScroll = sectionCenterDoc - visibleCenter;
      window.scrollTo({ top: Math.max(0, desiredScroll), behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (window.location.hash) setTimeout(scrollToHash, 200);
    });

    document.addEventListener('astro:page-load', () => {
      if (window.location.hash) setTimeout(scrollToHash, 200);
    });
  </script>
</body>
</html>
