---
import { NAV } from '../data/data';
import Icon from './Icon.astro';
const { activeKey = 'home' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <div class="header-zone-start" style="display:flex;align-items:center;gap:14px">
      <a href="/" style="display:flex;align-items:center;cursor:pointer;text-decoration:none;color:var(--color-ink)">
        <span class="logo-frame" style="--s:0.19008264462809917;width:calc(811px * var(--s));height:46px;overflow:hidden;position:relative;display:block;flex:none">
          <img
            src="/logo-mika-dark.webp"
            alt="Mika Homes"
            style="position:absolute;top:calc(-452px * var(--s));left:calc(-134px * var(--s));width:calc(1080px * var(--s));height:calc(1080px * var(--s));max-width:none"
          />
        </span>
      </a>
    </div>

    <!-- Desktop nav (centered) -->
    <nav class="desktop-nav">
      <span class="nav-pill" aria-hidden="true"></span>
      {NAV.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={['nav-link', { 'is-active': isActive }]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="lang-stable">
              <span class="lang-es">{item.label.es}</span>
              <span class="lang-en" hidden>{item.label.en}</span>
            </span>
          </a>
        );
      })}
    </nav>

    <div class="header-zone-end" style="display:flex;align-items:center;gap:12px">
      <!-- Language toggle -->
      <div class="lang-toggle-group desktop-lang-toggle" style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-pill);overflow:hidden;font-size:12px;font-weight:700">
        <button
          type="button"
          data-lang-btn="es"
          aria-label="Español"
          class="lang-toggle-btn"
          style="border:none;cursor:pointer;padding:7px 12px;background:var(--color-forest);color:var(--color-sand);user-select:none;transition:background-color .16s ease,transform .16s var(--ease-out)"
        >ES</button>
        <button
          type="button"
          data-lang-btn="en"
          aria-label="English"
          class="lang-toggle-btn"
          style="border:none;cursor:pointer;padding:7px 12px;background:transparent;color:var(--color-ink-soft);user-select:none;transition:background-color .16s ease,transform .16s var(--ease-out)"
        >EN</button>
      </div>

      <!-- CTA -->
      <a href="/#contacto" class="btn btn-primary desktop-cta" style="padding:11px 20px;font-size:14px">
        <span class="lang-stable">
          <span class="lang-es">Empieza aquí</span>
          <span class="lang-en" hidden>Start here</span>
        </span>
      </a>

      <!-- Mobile burger -->
      <button
        id="mobile-burger"
        class="mobile-burger"
        style="display:none;border-radius:var(--radius-md);width:42px;height:42px;cursor:pointer;align-items:center;justify-content:center;flex-direction:column;gap:4px"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="hidden" style="position:fixed;inset:0;z-index:70;background:rgba(20,15,10,.45)">
  <div
    id="mobile-menu"
    style="position:absolute;top:0;right:0;bottom:0;width:min(82vw,330px);background:var(--color-sand);padding:24px;display:flex;flex-direction:column;gap:6px"
    onclick="event.stopPropagation()"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      <span style="--s:0.13223140495867769;width:calc(811px * var(--s));height:32px;overflow:hidden;position:relative;display:block;flex:none">
        <img
          src="/logo-mika-dark.webp"
          alt="Mika Homes"
          style="position:absolute;top:calc(-452px * var(--s));left:calc(-134px * var(--s));width:calc(1080px * var(--s));height:calc(1080px * var(--s));max-width:none"
        />
      </span>
      <button
        id="mobile-close"
        style="border:none;background:transparent;cursor:pointer;color:var(--color-ink);line-height:1;display:flex"
        aria-label="Close"
      ><Icon name="close" size={22} /></button>
    </div>
    <div class="mobile-nav-link lang-toggle-group" style={`--menu-index:0;display:flex;border:1px solid var(--color-border);border-radius:var(--radius-pill);overflow:hidden;font-size:14px;font-weight:700;width:fit-content;padding:0;border-bottom:none;margin-bottom:8px`}>
      <button
        type="button"
        data-lang-btn="es"
        aria-label="Español"
        class="lang-toggle-btn"
        style="border:none;cursor:pointer;padding:9px 16px;background:var(--color-forest);color:var(--color-sand);user-select:none;transition:background-color .16s ease,transform .16s var(--ease-out)"
      >ES</button>
      <button
        type="button"
        data-lang-btn="en"
        aria-label="English"
        class="lang-toggle-btn"
        style="border:none;cursor:pointer;padding:9px 16px;background:transparent;color:var(--color-ink-soft);user-select:none;transition:background-color .16s ease,transform .16s var(--ease-out)"
      >EN</button>
    </div>
    {NAV.map((item, index) => (
      <a
        href={item.href}
        class="mobile-nav-link"
        style={`--menu-index:${index + 1};cursor:pointer;padding:14px 8px;font-family:var(--font-display);font-weight:700;font-size:21px;color:var(--color-ink);text-decoration:none;border-bottom:1px solid var(--color-border-soft)`}
      >
        <span class="lang-es">{item.label.es}</span>
        <span class="lang-en" hidden>{item.label.en}</span>
      </a>
    ))}
    <a href="/#contacto" class="mobile-nav-link btn btn-primary" style="margin-top:16px;text-align:center">
      <span class="lang-es">Empieza aquí</span>
      <span class="lang-en" hidden>Start here</span>
    </a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    isolation: isolate;
    visibility: visible;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    will-change: transform;
    transition: transform .34s var(--ease-drawer), visibility 0s linear 0s, border-color .25s ease, box-shadow .25s ease;
  }
  /* visibility is delayed until the slide-out transition finishes (and
     restored instantly on the way back in) so the hidden header drops out
     of the tab order instead of leaving off-screen links keyboard-focusable
     — same delayed-visibility trick already used for #mobile-overlay below. */
  .site-header.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
    visibility: hidden;
    transition: transform .34s var(--ease-drawer), visibility 0s linear .34s, border-color .25s ease, box-shadow .25s ease;
  }
  /* The blurred background lives on a separate absolutely-positioned layer
     instead of directly on the sticky element. iOS Safari has a long-standing
     bug where `position: sticky` + `backdrop-filter` on the SAME element
     renders as a solid black rectangle mid-scroll; decoupling the two fixes it. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(112deg, rgba(245, 240, 232, .9), rgba(245, 240, 232, .77));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: background-color .25s ease, backdrop-filter .25s ease, -webkit-backdrop-filter .25s ease;
  }
  .site-header.is-scrolled::before {
    background: rgba(245, 240, 232, .95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border-soft);
    box-shadow: 0 10px 28px -22px rgba(43, 43, 43, .4);
  }
  .site-header::after {
    content: '';
    position: absolute;
    right: max(26px, calc((100vw - 1240px) / 2 + 26px));
    bottom: -1px;
    width: min(22vw, 230px);
    height: 1px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, var(--color-leaf), transparent);
    transform: scaleX(.35);
    transition: opacity .35s ease, transform .5s var(--ease-out);
  }
  .site-header.is-scrolled::after { opacity: .72; transform: scaleX(1); }

  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 26px;
    height: 82px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    transition: height .25s ease;
  }
  .site-header.is-scrolled .header-inner { height: 66px; }
  .header-zone-start { justify-self: start; min-width: 0; }
  .header-zone-end { justify-self: end; min-width: 0; }

  .logo-frame {
    transform-origin: left center;
    transition: transform .25s ease;
  }
  .site-header.is-scrolled .logo-frame { transform: scale(.82); }
  .header-zone-start > a:hover .logo-frame { transform: translateY(-1px) scale(1.025); }

  /* Desktop nav: a pill slides behind whichever link is hovered/focused
     and rests under the active route otherwise, instead of a static
     background per link. */
  .desktop-nav {
    position: relative;
    display: flex;
    gap: 2px;
    align-items: center;
    justify-self: center;
    width: max-content;
    margin-inline: auto;
    padding: 3px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition: background-color .3s ease, border-color .3s ease;
  }
  .site-header.is-scrolled .desktop-nav { background: rgba(255,255,255,.34); border-color: rgba(47,82,51,.08); }
  .nav-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    opacity: 0;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: linear-gradient(110deg, rgba(93,138,90,.18), rgba(47,82,51,.08), rgba(93,138,90,.14));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.48), 0 7px 17px -13px rgba(47,82,51,.58);
    transform: translateX(0);
    transition: transform .38s var(--ease-out), width .38s var(--ease-out), opacity .2s ease;
    pointer-events: none;
    z-index: 0;
  }
  .nav-pill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 28%, rgba(255,255,255,.46) 50%, transparent 72%);
    transform: translateX(-115%);
  }
  .desktop-nav:hover .nav-pill::after { animation: nav-pill-sheen .72s var(--ease-out); }
  @keyframes nav-pill-sheen { to { transform: translateX(115%); } }
  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    cursor: pointer;
    min-height: 44px;
    padding: 11px 21px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -.005em;
    text-decoration: none;
    border-radius: var(--radius-pill);
    color: var(--color-ink-soft);
    transition: color .2s ease, transform .2s var(--ease-out);
  }
  .nav-link:hover, .nav-link:focus-visible, .nav-link.is-active { color: var(--color-forest); }
  .nav-link:hover { transform: translateY(-1px); }
  .nav-link .lang-stable { justify-items: center; text-align: center; }
  .nav-link .lang-stable > span { width: 100%; text-align: center; }

  .lang-toggle-group {
    box-shadow: var(--shadow-sm);
    transition: box-shadow .18s ease;
  }
  .lang-toggle-btn { font-family: inherit; line-height: 1; position: relative; }
  .lang-toggle-btn:active { transform: scale(.94); }
  .lang-toggle-btn:hover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .06);
  }

  /* The CTA keeps the widest translation reserved. Center each grid item so
     the shorter English label is centered within that stable width. */
  .desktop-cta .lang-stable { justify-items: center; text-align: center; }

  .mobile-burger {
    border: 1px solid var(--color-border);
    background: transparent;
    transition: background-color .16s ease, border-color .16s ease, transform .16s var(--ease-out);
  }
  .mobile-burger:hover {
    background: rgba(47, 82, 51, .06);
    border-color: var(--color-leaf);
  }
  .mobile-burger:active { transform: scale(.94); }
  .burger-line {
    width: 18px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transform-origin: center;
    transition: transform .28s var(--ease-drawer), opacity .18s ease;
  }
  .mobile-burger.is-open .burger-line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mobile-burger.is-open .burger-line:nth-child(2) { opacity: 0; transform: scaleX(.3); }
  .mobile-burger.is-open .burger-line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 880px) {
    .lang-toggle-btn { padding: 11px 14px !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .site-header::before { transition: none; }
    .site-header.is-hidden { transform: none; visibility: visible; pointer-events: auto; }
    .nav-pill { transition: opacity .15s linear; }
    .header-inner, .logo-frame { transition: none; }
    .site-header::after, .desktop-nav, .nav-link, .burger-line, .mobile-nav-link { transition: none !important; animation: none !important; }
  }

  /* Backdrop + drawer animate via opacity/transform (interruptible transitions,
     not keyframes) so rapid open/close toggles never restart mid-flight.
     Specificity (#id.class) is needed to beat the global .hidden{display:none!important}. */
  #mobile-overlay {
    display: block;
    opacity: 1;
    visibility: visible;
    transition: opacity .25s ease, visibility 0s linear 0s;
  }
  #mobile-overlay.hidden {
    display: block !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity .25s ease, visibility 0s linear .25s;
  }
  #mobile-menu {
    display: flex;
    transform: translateX(0);
    transition: transform .32s var(--ease-drawer);
  }
  #mobile-overlay.hidden #mobile-menu {
    transform: translateX(100%);
  }
  .mobile-nav-link:not(.btn) {
    opacity: 0;
    transform: translateX(22px);
    transition: opacity .3s ease, transform .38s var(--ease-out), color .18s ease, padding-left .24s var(--ease-out);
  }
  #mobile-overlay:not(.hidden) .mobile-nav-link:not(.btn) {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(70ms + var(--menu-index) * 55ms);
  }
  .mobile-nav-link:not(.btn):not(.lang-toggle-group):hover { color: var(--color-forest) !important; padding-left: 15px !important; }
  #mobile-overlay .mobile-nav-link.btn { opacity: 0; transform: translateY(10px); transition: opacity .28s ease .3s, transform .32s var(--ease-out) .3s; }
  #mobile-overlay:not(.hidden) .mobile-nav-link.btn { opacity: 1; transform: translateY(0); }
</style>

<script>
  // No `data-astro-rerun` here on purpose: this is a module script, so it
  // only ever executes once for the whole session — Astro's ClientRouter
  // keeps <html> alive across navigations. Anything that touches DOM nodes
  // replaced on each navigation is rebuilt inside the astro:page-load
  // listener below instead of by re-running the whole script (which is
  // what data-astro-rerun did, and which broke on the second navigation
  // because top-level const/let can't be redeclared in the page's shared
  // global scope).
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Centra #contacto en el área visible (descontando el header sticky).
  // No depende del DOM de una página en particular, así que se define una
  // sola vez y sirve para todas las navegaciones.
  function scrollToContacto(smooth = true) {
    const target = document.getElementById('contacto');
    if (!target) return;
    const HEADER = 94;
    const rect = target.getBoundingClientRect();
    const sectionCenterDoc = rect.top + window.scrollY + rect.height / 2;
    const visibleCenter = HEADER + (window.innerHeight - HEADER) / 2;
    const desiredScroll = sectionCenterDoc - visibleCenter;
    window.scrollTo({ top: Math.max(0, desiredScroll), behavior: smooth ? 'smooth' : 'auto' });
  }

  // `document` persiste durante toda la sesión bajo el ClientRouter, así
  // que este listener se ata una sola vez y sirve para cualquier página.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest('a[href="/#contacto"], a[href="#contacto"]');
    if (!link) return;
    const target = document.getElementById('contacto');
    if (!target) return;
    e.preventDefault();
    document.getElementById('mobile-overlay')?.classList.add('hidden');
    scrollToContacto(true);
  });

  // Si la página se carga directamente con el hash #contacto (por ejemplo, desde el blog)
  if (window.location.hash === '#contacto') {
    window.addEventListener('load', () => {
      setTimeout(() => scrollToContacto(true), 150);
    });
  }

  // Listener de scroll del header actual; se remueve y se vuelve a atar en
  // cada navegación para no quedar apuntando a un <header> que el
  // ClientRouter ya reemplazó.
  let headerScrollListener: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const burger = document.getElementById('mobile-burger');
    const overlay = document.getElementById('mobile-overlay');

    const closeMobile = () => {
      overlay?.classList.add('hidden');
      burger?.classList.remove('is-open');
      burger?.setAttribute('aria-expanded', 'false');
      document.body.style.removeProperty('overflow');
    };
    burger?.addEventListener('click', () => {
      const opening = overlay?.classList.contains('hidden');
      overlay?.classList.toggle('hidden');
      burger.classList.toggle('is-open', Boolean(opening));
      burger.setAttribute('aria-expanded', String(Boolean(opening)));
      // Locks the background from scrolling while the drawer is open — this
      // also keeps the hide-on-scroll header from sliding away mid-menu,
      // since there's no page scroll left to trigger it.
      document.body.style.overflow = opening ? 'hidden' : '';
    });
    document.getElementById('mobile-close')?.addEventListener('click', closeMobile);
    overlay?.addEventListener('click', (event) => { if (event.target === overlay) closeMobile(); });
    document.querySelectorAll('.mobile-nav-link').forEach(link => link.addEventListener('click', closeMobile));

    // Header hide-on-scroll: plain scroll listener comparing the current
    // position against the last one to detect direction, toggling a class
    // that CSS animates via `transform: translateY()` (transform/opacity
    // only, so no layout reflow — see .site-header.is-hidden above).
    if (headerScrollListener) window.removeEventListener('scroll', headerScrollListener);
    headerScrollListener = null;

    if (header && !reduceMotion) {
      let lastY = window.scrollY;
      headerScrollListener = () => {
        // Clamp negative values from iOS rubber-band overscroll.
        const y = Math.max(0, window.scrollY);
        header.classList.toggle('is-scrolled', y > 8);
        // Never slide the header away while the mobile drawer is open —
        // its own burger/close button lives inside it. Body scroll is
        // locked in that state, but iOS can still rubber-band-scroll, so
        // this guard is the belt to that suspenders.
        const menuOpen = !overlay?.classList.contains('hidden');
        if (menuOpen || y <= 12) {
          header.classList.remove('is-hidden');
          lastY = y;
          return;
        }
        // Small threshold avoids flicker from tiny scroll wobble.
        if (Math.abs(y - lastY) > 8) {
          header.classList.toggle('is-hidden', y > lastY);
          lastY = y;
        }
      };
      window.addEventListener('scroll', headerScrollListener, { passive: true });
      headerScrollListener();
    } else if (header) {
      header.classList.remove('is-hidden');
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    }

    // Desktop nav: a pill tracks the hovered/focused link and rests under
    // the active route otherwise (magnetic-highlight pattern).
    const desktopNav = document.querySelector<HTMLElement>('.desktop-nav');
    const navPill = desktopNav?.querySelector<HTMLElement>('.nav-pill');
    const navLinks = desktopNav ? Array.from(desktopNav.querySelectorAll<HTMLAnchorElement>('.nav-link')) : [];
    const activeNavLink = navLinks.find(a => a.getAttribute('aria-current') === 'page') ?? null;

    function positionNavPill(el: HTMLElement | null) {
      if (!navPill) return;
      if (!el) {
        navPill.style.opacity = '0';
        return;
      }
      navPill.style.transform = `translateX(${el.offsetLeft}px)`;
      navPill.style.width = `${el.offsetWidth}px`;
      navPill.style.opacity = '1';
    }

    if (desktopNav && navPill) {
      desktopNav.addEventListener('pointerover', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('.nav-link');
        if (link) positionNavPill(link);
      });
      desktopNav.addEventListener('pointerleave', () => positionNavPill(activeNavLink));
      desktopNav.addEventListener('focusin', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('.nav-link');
        if (link) positionNavPill(link);
      });
      desktopNav.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (!next || !desktopNav.contains(next)) positionNavPill(activeNavLink);
      });
      positionNavPill(activeNavLink);
    }
  });
</script>
