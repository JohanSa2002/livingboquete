---
import { NAV } from '../data/data';
import Icon from './Icon.astro';
const { activeKey = 'home' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" style="position:sticky;top:0;z-index:60;background:rgba(245,240,232,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)">
  <div style="max-width:1240px;margin:0 auto;padding:0 26px;height:76px;display:flex;align-items:center;gap:28px">
    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:12px;cursor:pointer;text-decoration:none;color:var(--color-ink);margin-right:auto">
      <span style="width:38px;height:38px;border-radius:11px;background:var(--color-forest);display:flex;align-items:center;justify-content:center;flex:none;box-shadow:0 4px 12px -4px rgba(47,82,51,.5)">
        <span style="width:14px;height:14px;border-radius:50% 50% 50% 0;transform:rotate(45deg);background:var(--color-sand)"></span>
      </span>
      <span style="font-family:var(--font-display);font-weight:800;font-size:20px;letter-spacing:-.01em">Boquete</span>
    </a>

    <!-- Desktop nav -->
    <nav style="display:flex;gap:2px;align-items:center" class="desktop-nav">
      {NAV.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            style={`cursor:pointer;padding:9px 16px;font-size:14.5px;font-weight:600;color:${isActive ? 'var(--color-forest)' : 'var(--color-ink-soft)'};text-decoration:none;border-radius:var(--radius-pill);background:${isActive ? 'rgba(47,82,51,.1)' : 'transparent'};transition:background-color .16s ease,color .16s ease`}
          >
            <span class="lang-es">{item.label.es}</span>
            <span class="lang-en" hidden>{item.label.en}</span>
          </a>
        );
      })}
    </nav>

    <div style="display:flex;align-items:center;gap:12px">
      <!-- Language toggle -->
      <div style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-pill);overflow:hidden;font-size:12px;font-weight:700">
        <span
          data-lang-btn="es"
          style="cursor:pointer;padding:7px 12px;background:var(--color-forest);color:var(--color-sand);user-select:none;transition:background-color .16s ease"
        >ES</span>
        <span
          data-lang-btn="en"
          style="cursor:pointer;padding:7px 12px;background:transparent;color:var(--color-ink-soft);user-select:none;transition:background-color .16s ease"
        >EN</span>
      </div>

      <!-- CTA -->
      <a href="/#contacto" class="btn btn-primary desktop-cta" style="padding:11px 20px;font-size:14px">
        <span class="lang-es">Empieza aquí</span>
        <span class="lang-en" hidden>Start here</span>
      </a>

      <!-- Mobile burger -->
      <button
        id="mobile-burger"
        class="mobile-burger"
        style="display:none;border:1px solid var(--color-border);background:transparent;border-radius:10px;width:42px;height:42px;cursor:pointer;align-items:center;justify-content:center;flex-direction:column;gap:4px"
        aria-label="Menu"
      >
        <span style="width:18px;height:2px;background:var(--color-ink);border-radius:2px"></span>
        <span style="width:18px;height:2px;background:var(--color-ink);border-radius:2px"></span>
        <span style="width:18px;height:2px;background:var(--color-ink);border-radius:2px"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="hidden" style="position:fixed;inset:0;z-index:70;background:rgba(20,15,10,.45)">
  <div
    id="mobile-menu"
    style="position:absolute;top:0;right:0;bottom:0;width:min(82vw,330px);background:var(--color-sand);padding:24px;animation:fadein .2s both;display:flex;flex-direction:column;gap:6px"
    onclick="event.stopPropagation()"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      <span style="font-family:var(--font-display);font-weight:800;font-size:19px;color:var(--color-ink)">Boquete</span>
      <button
        id="mobile-close"
        style="border:none;background:transparent;cursor:pointer;color:var(--color-ink);line-height:1;display:flex"
        aria-label="Close"
      ><Icon name="close" size={22} /></button>
    </div>
    {NAV.map(item => (
      <a
        href={item.href}
        class="mobile-nav-link"
        style="cursor:pointer;padding:14px 8px;font-family:var(--font-display);font-weight:700;font-size:21px;color:var(--color-ink);text-decoration:none;border-bottom:1px solid var(--color-border-soft)"
      >
        <span class="lang-es">{item.label.es}</span>
        <span class="lang-en" hidden>{item.label.en}</span>
      </a>
    ))}
    <a href="/#contacto" class="mobile-nav-link btn btn-primary" style="margin-top:16px;text-align:center">
      <span class="lang-es">Empieza aquí</span>
      <span class="lang-en" hidden>Start here</span>
    </a>
  </div>
</div>

<style>
  .site-header { position: sticky; }
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 44px;
    background: linear-gradient(to bottom, rgba(245,240,232,.85), rgba(245,240,232,0));
    pointer-events: none;
  }
  .hidden { display: none !important; }
  #mobile-overlay.hidden { display: none !important; }
  #mobile-menu { display: flex; }
  /* When overlay is visible, it's a block */
  #mobile-overlay:not(.hidden) { display: block !important; }
</style>

<script>
  // Close button inside mobile menu
  document.getElementById('mobile-close')?.addEventListener('click', () => {
    document.getElementById('mobile-overlay')?.classList.add('hidden');
  });

  // Centra #contacto en el área visible (descontando el header sticky)
  const scrollToContacto = (smooth = true) => {
    const target = document.getElementById('contacto');
    if (!target) return;
    const HEADER = 88;
    const rect = target.getBoundingClientRect();
    const sectionCenterDoc = rect.top + window.scrollY + rect.height / 2;
    const visibleCenter = HEADER + (window.innerHeight - HEADER) / 2;
    const desiredScroll = sectionCenterDoc - visibleCenter;
    window.scrollTo({ top: Math.max(0, desiredScroll), behavior: smooth ? 'smooth' : 'auto' });
  };

  // Manejador de clics en la página
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a[href="/#contacto"], a[href="#contacto"]');
    if (!link) return;
    const target = document.getElementById('contacto');
    if (!target) return;
    e.preventDefault();
    document.getElementById('mobile-overlay')?.classList.add('hidden');
    scrollToContacto(true);
  });

  // Si la página se carga directamente con el hash #contacto (por ejemplo, desde el blog)
  if (window.location.hash === '#contacto') {
    // Pequeño retardo para asegurar que la página y fuentes se hayan renderizado
    // y la altura total de scroll (scrollHeight) sea exacta.
    window.addEventListener('load', () => {
      setTimeout(() => {
        scrollToContacto(true);
      }, 150);
    });
  }
</script>
