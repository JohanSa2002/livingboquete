---
import { NAV } from '../data/data';
---

<footer style="background:var(--color-forest-dark);color:#C9CDBE;margin-top:0">
  <div
    style="max-width:1240px;margin:0 auto;padding:64px 26px 30px;display:grid;grid-template-columns:1.6fr 1fr 1.4fr;gap:40px"
    class="footer-grid"
  >
    <!-- Brand -->
    <div>
      <div style="display:flex;align-items:center;gap:11px;margin-bottom:16px">
        <span style="width:34px;height:34px;border-radius:10px;background:var(--color-wood);display:flex;align-items:center;justify-content:center;flex:none">
          <span style="width:13px;height:13px;border-radius:50% 50% 50% 0;transform:rotate(45deg);background:var(--color-forest-dark)"></span>
        </span>
        <span style="font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--color-sand)">Boquete</span>
      </div>
      <p style="font-size:14.5px;line-height:1.65;color:#A9AD9C;max-width:300px;margin:0">
        <span class="lang-es">Guía de la comunidad de Boquete: un pueblo de montaña en las tierras altas de Chiriquí, Panamá.</span>
        <span class="lang-en" hidden>Community guide for Boquete: a mountain town in the highlands of Chiriquí, Panama.</span>
      </p>
    </div>

    <!-- Explore links -->
    <div>
      <h4 style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#8B9080;margin:0 0 14px">
        <span class="lang-es">Explorar</span>
        <span class="lang-en" hidden>Explore</span>
      </h4>
      <div style="display:flex;flex-direction:column;gap:10px">
        {NAV.map(item => (
          <a href={item.href} style="color:#C9CDBE;text-decoration:none;font-size:14.5px">
            <span class="lang-es">{item.label.es}</span>
            <span class="lang-en" hidden>{item.label.en}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Newsletter -->
    <div>
      <h4 style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#8B9080;margin:0 0 14px">
        <span class="lang-es">Boletín</span>
        <span class="lang-en" hidden>Newsletter</span>
      </h4>
      <p style="font-size:14px;color:#A9AD9C;margin:0 0 14px">
        <span class="lang-es">Recibe la guía gratuita y novedades de la comunidad.</span>
        <span class="lang-en" hidden>Get the free guide and community updates.</span>
      </p>
      <a
        href="/#contacto"
        style="display:inline-flex;align-items:center;gap:8px;background:var(--color-wood);border:none;color:#fff;font-weight:700;font-size:14px;padding:11px 16px;border-radius:10px;text-decoration:none;transition:background-color .16s ease"
      >
        <span class="lang-es">Suscribirme</span>
        <span class="lang-en" hidden>Subscribe</span>
        →
      </a>
    </div>
  </div>

  <div style="border-top:1px solid rgba(255,255,255,.08)">
    <div style="max-width:1240px;margin:0 auto;padding:20px 26px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:13px;color:#7C8172">
      <span>
        © 2026
        <span class="lang-es">Comunidad de Boquete · Todos los derechos reservados</span>
        <span class="lang-en" hidden>Boquete Community · All rights reserved</span>
      </span>
      <span>
        <span class="lang-es">Panamá · Tierras altas de Chiriquí</span>
        <span class="lang-en" hidden>Panama · Chiriquí Highlands</span>
      </span>
    </div>
  </div>
</footer>
